<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- App internal storage -->
    <files-path
        name="files"
        path="." />

    <!-- App cache -->
    <cache-path
        name="cache"
        path="." />

    <!-- App-specific external storage -->
    <external-files-path
        name="external"
        path="." />

    <!-- For external storage root -->
    <external-path
        name="external_root"
        path="." />
    
    <!-- For .blacklogics directory specifically -->
    <external-path
        name="blacklogics"
        path=".blacklogics/" />
    
    <!-- For downloads -->
    <external-path
        name="downloads"
        path="Download/" />
</paths>