<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview10"
		android:layout_width="match_parent"
		android:layout_height="56dp"
		app:cardElevation="6dp"
		app:cardCornerRadius="0dp"
		android:backgroundTint="?attr/colorPrimarySurface">
		<LinearLayout
			android:id="@+id/toolbar"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingStart="4dp"
			android:paddingEnd="4dp">
			<LinearLayout
				android:id="@+id/linear9"
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:gravity="center_vertical"
				android:orientation="vertical"
				android:layout_weight="1"
				android:paddingStart="12dp">
				<TextView
					android:id="@+id/textview9"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Code Editor"
					android:textSize="16sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF"
					android:focusable="false" />
				<TextView
					android:id="@+id/textview10"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="UTF-8"
					android:textSize="11sp"
					android:textColor="#BDBDBD"
					android:focusable="false" />
			</LinearLayout>
			<ImageView
				android:id="@+id/menu_view_undo"
				android:layout_width="38dp"
				android:layout_height="38dp"
				android:padding="6dp"
				android:src="@drawable/ic_undo_white_48dp"
				android:scaleType="centerInside"
				android:focusable="false" />
			<ImageView
				android:id="@+id/menu_view_redo"
				android:layout_width="38dp"
				android:layout_height="38dp"
				android:padding="6dp"
				android:src="@drawable/ic_redo_white_48dp"
				android:scaleType="centerInside"
				android:layout_marginStart="8dp"
				android:focusable="false" />
			<ImageView
				android:id="@+id/save"
				android:layout_width="38dp"
				android:layout_height="38dp"
				android:padding="6dp"
				android:src="@drawable/save_white_48"
				android:scaleType="centerInside"
				android:layout_marginStart="8dp"
				android:focusable="false" />
			<ImageView
				android:id="@+id/more"
				android:layout_width="38dp"
				android:layout_height="38dp"
				android:padding="6dp"
				android:src="@drawable/ic_more_vert_white_24dp"
				android:scaleType="centerInside"
				android:layout_marginStart="8dp"
				android:focusable="false" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
	<io.github.rosemoe.sora.widget.CodeEditor
		android:id="@+id/editor"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		style="@style/AppTheme.Et" />
</LinearLayout>
