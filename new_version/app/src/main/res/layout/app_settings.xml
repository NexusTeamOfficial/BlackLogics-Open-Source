<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="?attr/colorSurface"
	android:theme="@style/Theme.Material3.DayNight.NoActionBar">
	<include layout="@layout/toolbar_improved" />
	<ScrollView
		android:id="@+id/vscroll2"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true"
		android:scrollbars="none">
		<LinearLayout
			android:id="@+id/linear1"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="16dp"
			android:orientation="vertical"
			android:clipToPadding="false">
			<TextView
				android:id="@+id/textview7"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:text="Settings"
				android:textSize="12sp"
				android:textAppearance="?attr/textAppearanceTitleMedium"
				android:layout_marginStart="4dp"
				android:letterSpacing="0.05" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/blockManagerCard"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="?attr/colorSurface"
				app:cardElevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="?attr/colorOutline"
				app:cardCornerRadius="16dp"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground">
				<LinearLayout
					android:id="@+id/linear11"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<ImageView
						android:id="@+id/blockManager"
						android:layout_width="48dp"
						android:layout_height="48dp"
						android:padding="12dp"
						android:background="@drawable/circle_background"
						android:src="@drawable/block_flled_white"
						android:scaleType="center"
						android:tint="?attr/colorPrimary" />
					<LinearLayout
						android:id="@+id/linear3"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1"
						android:paddingStart="16dp"
						android:paddingEnd="8dp">
						<TextView
							android:id="@+id/blocksManagerTitle"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginBottom="4dp"
							android:text="@string/block_manager_title"
							android:textSize="12sp"
							android:textAppearance="?attr/textAppearanceBodyLarge" />
						<TextView
							android:id="@+id/blockManagerDesc"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/block_manager_sub_title"
							android:textSize="12sp"
							android:textAppearance="?attr/textAppearanceBodyMedium"
							android:lineSpacingExtra="2dp" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/aboutAppCard"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="?attr/colorSurface"
				app:cardElevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="?attr/colorOutline"
				app:cardCornerRadius="16dp"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground">
				<LinearLayout
					android:id="@+id/linear12"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<ImageView
						android:id="@+id/imageview1"
						android:layout_width="48dp"
						android:layout_height="48dp"
						android:padding="12dp"
						android:background="@drawable/circle_background_secondary"
						android:src="@drawable/icon_info_round"
						android:scaleType="center"
						android:tint="?attr/colorSecondary" />
					<LinearLayout
						android:id="@+id/linear6"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1"
						android:paddingStart="16dp"
						android:paddingEnd="8dp">
						<TextView
							android:id="@+id/textview1"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginBottom="4dp"
							android:text="@string/about_app_title"
							android:textSize="12sp"
							android:textAppearance="?attr/textAppearanceBodyLarge" />
						<TextView
							android:id="@+id/textview2"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/application_environment_desc"
							android:textSize="12sp"
							android:textAppearance="?attr/textAppearanceBodyMedium"
							android:lineSpacingExtra="2dp" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/textview8"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:layout_marginBottom="12dp"
				android:text="Preferences"
				android:textSize="12sp"
				android:textAppearance="?attr/textAppearanceTitleMedium"
				android:layout_marginStart="4dp"
				android:letterSpacing="0.05" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview2"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="?attr/colorSurface"
				app:cardElevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="?attr/colorOutline"
				app:cardCornerRadius="16dp">
				<LinearLayout
					android:id="@+id/linear13"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/linear14"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="16dp"
						android:background="?attr/selectableItemBackground"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:focusable="true">
						<TextView
							android:id="@+id/textview9"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="@string/app_dark_mode_title"
							android:textSize="12sp"
							android:layout_weight="1"
							android:textAppearance="?attr/textAppearanceBodyLarge" />
						<com.google.android.material.switchmaterial.SwitchMaterial
							android:id="@+id/switch1"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							app:useMaterialThemeColors="true" />
					</LinearLayout>
					<View
						android:id="@+id/view15"
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:background="?attr/colorOutline"
						android:layout_marginStart="56dp"
						android:layout_marginEnd="16dp" />
					<LinearLayout
						android:id="@+id/linear16"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="16dp"
						android:background="?attr/selectableItemBackground"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:focusable="true">
						<TextView
							android:id="@+id/textview10"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="Language"
							android:textSize="12sp"
							android:layout_weight="1"
							android:textAppearance="?attr/textAppearanceBodyLarge" />
						<TextView
							android:id="@+id/languageValue"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="English"
							android:textSize="12sp"
							android:textAppearance="?attr/textAppearanceBodyMedium"
							android:layout_marginEnd="16dp" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.button.MaterialButton
				android:id="@+id/materialbutton1"
				android:layout_width="match_parent"
				android:layout_height="56dp"
				android:layout_marginTop="24dp"
				android:layout_marginBottom="16dp"
				android:text="TEST BUTTON"
				android:textSize="16sp"
				android:textAllCaps="false"
				app:cornerRadius="28dp"
				app:iconGravity="textStart"
				app:iconPadding="8dp"
				app:backgroundTint="?attr/colorPrimary"
				app:rippleColor="?attr/colorOnPrimary"
				android:stateListAnimator="@anim/button_elevation" />
			<com.nexusteam.blacklogics.widget.AdLayout
				android:id="@+id/adLayout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:bannerAdUnitId="ca-app-pub-2903137488772866/3754424748"
				app:interstitialAdUnitId="ca-app-pub-2903137488772866/3754424748" />
			<Button
				android:id="@+id/button1"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="Button"
				android:textSize="12sp" />
			<Button
				android:id="@+id/button2"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="Hi"
				android:textSize="12sp" />
		</LinearLayout>
	</ScrollView>
</LinearLayout>
