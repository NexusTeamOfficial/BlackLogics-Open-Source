<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="@color/md_theme_light_background"
	android:fitsSystemWindows="true">
	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:background="@color/md_theme_light_surface"
		android:layout_height="?attr/actionBarSize"
		app:title="OpenSourceLicenses"
		app:titleTextColor="@color/md_theme_light_onSurface"
		app:navigationIcon="@drawable/icon_arrow_back_round"
		app:navigationIconTint="@color/md_theme_light_onSurface"
		app:elevation="0dp" />
	<View
		android:id="@+id/view22"
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="@color/md_theme_light_outline"
		android:alpha="0.2" />
	<androidx.core.widget.NestedScrollView
		android:id="@+id/vscroll4"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:fillViewport="true"
		android:overScrollMode="never">
		<LinearLayout
			android:id="@+id/linear23"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear24"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="20dp"
				android:background="@color/md_theme_light_primaryContainer"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/linear25"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview7"
						android:layout_width="52dp"
						android:layout_height="52dp"
						app:cardBackgroundColor="@color/md_theme_light_primary"
						app:cardCornerRadius="14dp"
						app:cardElevation="0dp">
						<TextView
							android:id="@+id/textview25"
							android:focusable="false"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:gravity="center_horizontal|center_vertical"
							android:text="⚡"
							android:textSize="24sp" />
					</com.google.android.material.card.MaterialCardView>
					<LinearLayout
						android:id="@+id/linear26"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1"
						android:layout_marginStart="14dp">
						<TextView
							android:id="@+id/textview26"
							android:focusable="false"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="BlackLogics"
							android:textSize="18sp"
							android:textStyle="bold"
							android:fontFamily="sans-serif-medium" />
						<TextView
							android:id="@+id/textview27"
							android:focusable="false"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="2dp"
							android:text="NexusTeam · Smart India Gaming"
							android:textSize="12sp"
							android:alpha="0.75" />
					</LinearLayout>
					<com.google.android.material.chip.Chip
						android:id="@+id/chip27"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:clickable="false"
						app:chipBackgroundColor="@color/md_theme_light_primary"
						app:chipStrokeWidth="0dp"
						android:focusable="false" />
				</LinearLayout>
				<TextView
					android:id="@+id/textview28"
					android:focusable="false"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="18dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="© 2024–2026 NexusTeam."
					android:textSize="13sp"
					android:textStyle="bold" />
				<TextView
					android:id="@+id/textview29"
					android:focusable="false"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="BlackLogics is dual-licensed:\n- GNU General Public License v3.0 (GPL-3.0) — default\n- Commercial License — available upon request\n\nThis software is free software; you can redistribute it and/or modify it under the terms of the GPL-3.0. For commercial use without open source obligations, a Commercial License is required."
					android:textSize="12sp"
					android:alpha="0.85"
					android:lineSpacingMultiplier="1.5" />
			</LinearLayout>
			<TextView
				android:id="@+id/textview30"
				android:focusable="false"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="20dp"
				android:paddingBottom="10dp"
				android:text="THIRD-PARTY OPEN SOURCE COMPONENTS"
				android:textSize="11sp"
				android:textStyle="bold"
				android:letterSpacing="0.1"
				android:paddingStart="16dp"
				android:paddingEnd="16dp" />
			<LinearLayout
				android:id="@+id/ll_licenses_container"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingBottom="8dp"
				android:orientation="vertical"
				android:paddingStart="12dp"
				android:paddingEnd="12dp" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview8"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="28dp"
				app:cardBackgroundColor="@color/md_theme_light_surfaceVariant"
				android:layout_marginStart="12dp"
				android:layout_marginEnd="12dp"
				app:cardCornerRadius="12dp"
				app:cardElevation="0dp"
				app:strokeWidth="0dp">
				<LinearLayout
					android:id="@+id/linear28"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview31"
						android:focusable="false"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="License Compliance"
						android:textSize="13sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/textview32"
						android:focusable="false"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="6dp"
						android:text="BlackLogics fully respects all open-source licenses. All third-party components remain the exclusive property of their respective authors and are distributed strictly in accordance with their original license terms — including GPL-3.0, Apache 2.0, MIT, and others."
						android:textSize="12sp"
						android:lineSpacingMultiplier="1.5" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</LinearLayout>
