<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="265dp"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="@color/backgroundColor"
	android:fitsSystemWindows="true">
	<LinearLayout
		android:id="@+id/linear_header"
		android:layout_width="match_parent"
		android:layout_height="180dp"
		android:paddingBottom="16dp"
		android:background="@color/colorPrimary"
		android:gravity="bottom"
		android:orientation="vertical"
		android:paddingStart="16dp"
		android:paddingEnd="16dp">
		<de.hdodenhof.circleimageview.CircleImageView
			android:id="@+id/profileImage"
			android:layout_width="64dp"
			android:layout_height="64dp"
			android:padding="2dp"
			android:background="@color/md_theme_light_primaryContainer"
			android:src="@drawable/app_icon" />
		<TextView
			android:id="@+id/names"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="10dp"
			android:text="@string/developer_name"
			android:textSize="15sp"
			android:textStyle="bold"
			android:fontFamily="sans-serif-medium" />
		<TextView
			android:id="@+id/userEmail"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="2dp"
			android:text="@string/app_name"
			android:textSize="12sp" />
	</LinearLayout>
	<ScrollView
		android:id="@+id/vscroll1"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:overScrollMode="never">
		<LinearLayout
			android:id="@+id/linear11"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="8dp"
			android:paddingBottom="8dp"
			android:orientation="vertical">
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/about"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="4dp"
				app:cardBackgroundColor="@color/subBarColor2"
				android:layout_marginStart="12dp"
				android:layout_marginEnd="12dp"
				app:cardCornerRadius="12dp"
				app:cardElevation="0dp"
				app:rippleColor="@color/rippleColor"
				android:focusable="true">
				<LinearLayout
					android:id="@+id/linear12"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="12dp"
					android:paddingBottom="12dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="12dp"
					android:paddingEnd="12dp">
					<ImageView
						android:id="@+id/imageview10"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:src="@drawable/jdjd"
						android:scaleType="fitCenter"
						app:tint="@color/colorPrimary" />
					<TextView
						android:id="@+id/textview18"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:text="About Team"
						android:textSize="14sp"
						android:layout_weight="1"
						android:layout_marginStart="16dp"
						android:fontFamily="sans-serif-medium" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/Changelog"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="4dp"
				app:cardBackgroundColor="@color/subBarColor2"
				android:layout_marginStart="12dp"
				android:layout_marginEnd="12dp"
				app:cardCornerRadius="12dp"
				app:cardElevation="0dp"
				app:rippleColor="@color/rippleColor"
				android:focusable="true">
				<LinearLayout
					android:id="@+id/linear13"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="12dp"
					android:paddingBottom="12dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="12dp"
					android:paddingEnd="12dp">
					<ImageView
						android:id="@+id/imageview6"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:src="@drawable/rjrhjr"
						android:scaleType="fitCenter"
						app:tint="@color/colorPrimary" />
					<TextView
						android:id="@+id/textview13"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:text="Changelog"
						android:textSize="14sp"
						android:layout_weight="1"
						android:layout_marginStart="16dp"
						android:fontFamily="sans-serif-medium" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/Setting"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="4dp"
				app:cardBackgroundColor="@color/subBarColor2"
				android:layout_marginStart="12dp"
				android:layout_marginEnd="12dp"
				app:cardCornerRadius="12dp"
				app:cardElevation="0dp"
				app:rippleColor="@color/rippleColor"
				android:focusable="true">
				<LinearLayout
					android:id="@+id/linear14"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="12dp"
					android:paddingBottom="12dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="12dp"
					android:paddingEnd="12dp">
					<ImageView
						android:id="@+id/imageview12"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:src="@drawable/developer_4"
						android:scaleType="fitCenter"
						app:tint="@color/colorPrimary" />
					<TextView
						android:id="@+id/textview21"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:text="System Settings"
						android:textSize="14sp"
						android:layout_weight="1"
						android:layout_marginStart="16dp"
						android:fontFamily="sans-serif-medium" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/Programs"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="4dp"
				app:cardBackgroundColor="@color/subBarColor2"
				android:layout_marginStart="12dp"
				android:layout_marginEnd="12dp"
				app:cardCornerRadius="12dp"
				app:cardElevation="0dp"
				app:rippleColor="@color/rippleColor"
				android:focusable="true">
				<LinearLayout
					android:id="@+id/linear15"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="12dp"
					android:paddingBottom="12dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="12dp"
					android:paddingEnd="12dp">
					<ImageView
						android:id="@+id/imageview14"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:src="@drawable/jdjd"
						android:scaleType="fitCenter"
						app:tint="@color/colorPrimary" />
					<TextView
						android:id="@+id/textview23"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:text="Program Information"
						android:textSize="14sp"
						android:layout_weight="1"
						android:layout_marginStart="16dp"
						android:fontFamily="sans-serif-medium" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/developer"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="4dp"
				app:cardBackgroundColor="@color/subBarColor2"
				android:layout_marginStart="12dp"
				android:layout_marginEnd="12dp"
				app:cardCornerRadius="12dp"
				app:cardElevation="0dp"
				app:rippleColor="@color/rippleColor"
				android:focusable="true">
				<LinearLayout
					android:id="@+id/linear16"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="12dp"
					android:paddingBottom="12dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="12dp"
					android:paddingEnd="12dp">
					<ImageView
						android:id="@+id/imageview15"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:src="@drawable/developer_1"
						android:scaleType="fitCenter"
						app:tint="@color/colorPrimary" />
					<TextView
						android:id="@+id/textview24"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:text="Developer Tools"
						android:textSize="14sp"
						android:layout_weight="1"
						android:layout_marginStart="16dp"
						android:fontFamily="sans-serif-medium" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/Create"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="4dp"
				app:cardBackgroundColor="@color/subBarColor2"
				android:layout_marginStart="12dp"
				android:layout_marginEnd="12dp"
				app:cardCornerRadius="12dp"
				app:cardElevation="0dp"
				app:rippleColor="@color/rippleColor"
				android:focusable="true">
				<LinearLayout
					android:id="@+id/linear17"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="12dp"
					android:paddingBottom="12dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="12dp"
					android:paddingEnd="12dp">
					<ImageView
						android:id="@+id/imageview16"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:src="@drawable/developer_5"
						android:scaleType="fitCenter"
						app:tint="@color/colorPrimary" />
					<TextView
						android:id="@+id/textview25"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:text="Create Release Keystore"
						android:textSize="14sp"
						android:layout_weight="1"
						android:layout_marginStart="16dp"
						android:fontFamily="sans-serif-medium" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/webtoapktool"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="4dp"
				app:cardBackgroundColor="@color/subBarColor2"
				android:layout_marginStart="12dp"
				android:layout_marginEnd="12dp"
				app:cardCornerRadius="12dp"
				app:cardElevation="0dp"
				app:rippleColor="@color/rippleColor"
				android:focusable="true">
				<LinearLayout
					android:id="@+id/linear18"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="12dp"
					android:paddingBottom="12dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="12dp"
					android:paddingEnd="12dp">
					<ImageView
						android:id="@+id/imagevieejw16"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:src="@drawable/icon_android_round"
						android:scaleType="fitCenter"
						app:tint="@color/colorPrimary" />
					<TextView
						android:id="@+id/textviesw25"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:text="Web to APK (Beta)"
						android:textSize="14sp"
						android:layout_weight="1"
						android:layout_marginStart="16dp"
						android:fontFamily="sans-serif-medium" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/donate"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="4dp"
				app:cardBackgroundColor="@color/subBarColor2"
				android:layout_marginStart="12dp"
				android:layout_marginEnd="12dp"
				app:cardCornerRadius="12dp"
				app:cardElevation="0dp"
				app:rippleColor="@color/rippleColor"
				android:focusable="true">
				<LinearLayout
					android:id="@+id/linear19"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="12dp"
					android:paddingBottom="12dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="12dp"
					android:paddingEnd="12dp">
					<ImageView
						android:id="@+id/imageview18"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:src="@drawable/icon_android_round"
						android:scaleType="fitCenter"
						app:tint="@color/colorPrimary" />
					<TextView
						android:id="@+id/textview27"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:text="Donate"
						android:textSize="14sp"
						android:layout_weight="1"
						android:layout_marginStart="16dp"
						android:fontFamily="sans-serif-medium" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
	</ScrollView>
	<View
		android:id="@+id/view20"
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="@color/divider"
		android:layout_marginStart="16dp"
		android:layout_marginEnd="16dp" />
	<LinearLayout
		android:id="@+id/linear21"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="12dp"
		android:paddingBottom="16dp"
		android:background="@color/backgroundColor"
		android:gravity="center_horizontal"
		android:orientation="horizontal"
		android:paddingStart="16dp"
		android:paddingEnd="16dp">
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/facebook"
			android:layout_width="44dp"
			android:layout_height="44dp"
			app:cardBackgroundColor="@color/subBarColor"
			android:layout_gravity="center_horizontal|center_vertical"
			android:layout_marginEnd="10dp"
			app:cardCornerRadius="22dp"
			app:cardElevation="0dp"
			app:rippleColor="@color/rippleColor"
			android:focusable="true">
			<ImageView
				android:id="@+id/imageview4"
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:src="@drawable/developer_2"
				android:scaleType="fitCenter"
				app:tint="@color/colorPrimary" />
		</com.google.android.material.card.MaterialCardView>
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/Program"
			android:layout_width="44dp"
			android:layout_height="44dp"
			app:cardBackgroundColor="@color/subBarColor"
			android:layout_gravity="center_horizontal|center_vertical"
			android:layout_marginEnd="10dp"
			app:cardCornerRadius="22dp"
			app:cardElevation="0dp"
			app:rippleColor="@color/rippleColor"
			android:focusable="true">
			<ImageView
				android:id="@+id/imageview5"
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:src="@drawable/developer_6"
				android:scaleType="fitCenter"
				app:tint="@color/colorPrimary" />
		</com.google.android.material.card.MaterialCardView>
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/youtube"
			android:layout_width="44dp"
			android:layout_height="44dp"
			app:cardBackgroundColor="@color/subBarColor"
			android:layout_gravity="center_horizontal|center_vertical"
			app:cardCornerRadius="22dp"
			app:cardElevation="0dp"
			app:rippleColor="@color/rippleColor"
			android:focusable="true">
			<ImageView
				android:id="@+id/imageview7"
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:src="@drawable/developer_3"
				android:scaleType="fitCenter"
				app:tint="@color/colorPrimary" />
		</com.google.android.material.card.MaterialCardView>
	</LinearLayout>
</LinearLayout>
