<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:padding="12dp"
	android:background="?attr/colorSurface">
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview2"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:contentPadding="12dp"
		app:cardBackgroundColor="?attr/colorSurface"
		android:layout_marginVertical="4dp"
		app:cardCornerRadius="12dp"
		app:cardElevation="4dp"
		app:strokeColor="?attr/colorOutline"
		app:strokeWidth="1dp">
		<LinearLayout
			android:id="@+id/linear2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear4"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<ImageView
					android:id="@+id/app_icon"
					android:layout_width="48dp"
					android:layout_height="48dp"
					android:scaleType="centerCrop"
					android:src="@mipmap/ic_launcher"
					android:focusable="false" />
				<LinearLayout
					android:id="@+id/linear5"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:layout_weight="1"
					android:paddingStart="12dp">
					<TextView
						android:id="@+id/app_name"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="LinearColorPicker"
						android:textSize="16sp"
						android:textStyle="bold"
						android:focusable="false" />
					<TextView
						android:id="@+id/app_version_version_code"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="ColorPicker - 1.0 (1)"
						android:textSize="14sp"
						android:focusable="false" />
					<TextView
						android:id="@+id/package_name"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="com.nexusteam.color.os.colorpicker"
						android:textSize="13sp"
						android:focusable="false" />
				</LinearLayout>
				<TextView
					android:id="@+id/project_id"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="682"
					android:textSize="16sp"
					android:textStyle="bold"
					android:focusable="false" />
				<ImageView
					android:id="@+id/btn_expand"
					android:layout_width="24dp"
					android:layout_height="24dp"
					android:src="@drawable/ic_expand_more"
					android:scaleType="fitCenter"
					android:layout_marginStart="8dp"
					android:contentDescription="Expand"
					android:focusable="false"
					android:tint="?attr/colorOnSurface" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/expanded_content"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="12dp"
				android:orientation="horizontal"
				android:visibility="gone">
				<ImageView
					android:id="@+id/btn_edit"
					android:layout_width="32dp"
					android:layout_height="32dp"
					android:src="@drawable/ic_edit"
					android:scaleType="fitCenter"
					android:layout_weight="1"
					android:contentDescription="Edit"
					android:focusable="false" />
				<ImageView
					android:id="@+id/btn_backup"
					android:layout_width="32dp"
					android:layout_height="32dp"
					android:src="@drawable/ic_backup"
					android:scaleType="fitCenter"
					android:layout_weight="1"
					android:contentDescription="Backup"
					android:focusable="false" />
				<ImageView
					android:id="@+id/export_project"
					android:layout_width="32dp"
					android:layout_height="32dp"
					android:src="@drawable/export_project_512_by_512"
					android:scaleType="fitCenter"
					android:layout_weight="1"
					android:contentDescription="Export"
					android:focusable="false" />
				<ImageView
					android:id="@+id/btn_delete"
					android:layout_width="32dp"
					android:layout_height="32dp"
					android:src="@drawable/ic_delete"
					android:scaleType="fitCenter"
					android:layout_weight="1"
					android:contentDescription="Delete"
					android:focusable="false" />
				<ImageView
					android:id="@+id/configLayout"
					android:layout_width="32dp"
					android:layout_height="32dp"
					android:src="@drawable/icon_settings_round_blue"
					android:scaleType="fitCenter"
					android:layout_weight="1"
					android:contentDescription="Config"
					android:focusable="false" />
			</LinearLayout>
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
