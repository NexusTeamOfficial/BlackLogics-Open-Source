<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_coordinator"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<LinearLayout
		android:id="@+id/main_container"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="?attr/colorSurface"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/linear1"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:background="?attr/colorSurface"
			android:orientation="vertical"
			android:layout_weight="1">
			<LinearLayout
				android:id="@+id/mainContentLayout"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="horizontal">
				<com.besome.blacklogics.custom.SideBarVertical
					android:id="@+id/sidebar"
					android:layout_width="80dp"
					android:layout_height="match_parent"
					android:background="?attr/colorSurface"
					android:elevation="4dp"
					app:iconSize="30dp"
					app:selectedBackgroundColor="?attr/colorPrimaryContainer"
					app:nexusShowDividers="false"
					app:darkTheme="false" />
				<androidx.core.widget.NestedScrollView
					android:id="@+id/contentScrollView"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:fillViewport="true"
					android:scrollbars="vertical">
					<LinearLayout
						android:id="@+id/linear11"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="16dp"
						android:orientation="vertical">
						<LinearLayout
							android:id="@+id/lifecycleEvents"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:visibility="visible">
							<com.google.android.material.card.MaterialCardView
								android:id="@+id/initializeLogicCard"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginBottom="20dp"
								style="@style/Widget.Material3.CardView.Filled"
								app:cardCornerRadius="16dp"
								app:cardElevation="1dp"
								app:strokeColor="?attr/colorOutline"
								app:strokeWidth="1dp">
								<LinearLayout
									android:id="@+id/linear5"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:orientation="vertical">
									<LinearLayout
										android:id="@+id/linear2"
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:padding="8dp"
										android:background="?attr/selectableItemBackground"
										android:gravity="center_vertical"
										android:orientation="horizontal">
										<ImageView
											android:id="@+id/imageview1"
											android:layout_width="48dp"
											android:layout_height="48dp"
											android:padding="12dp"
											android:src="@drawable/widget_source"
											android:scaleType="fitCenter" />
										<LinearLayout
											android:id="@+id/linear3"
											android:layout_width="0dp"
											android:layout_height="wrap_content"
											android:orientation="vertical"
											android:layout_weight="1"
											android:layout_marginStart="16dp">
											<TextView
												android:id="@+id/textview2"
												android:layout_width="wrap_content"
												android:layout_height="wrap_content"
												android:text="initializeLogic"
												android:textSize="16sp"
												android:textStyle="bold" />
											<TextView
												android:id="@+id/textview1"
												android:layout_width="wrap_content"
												android:layout_height="wrap_content"
												android:layout_marginTop="4dp"
												android:text="On activity create"
												android:textSize="12sp" />
										</LinearLayout>
										<ImageView
											android:id="@+id/arrowIcon"
											android:layout_width="28dp"
											android:layout_height="28dp"
											android:src="@drawable/icon_arrow_drop_down_sharp"
											android:scaleType="fitCenter"
											android:tint="?attr/colorOnSurfaceVariant" />
									</LinearLayout>
									<LinearLayout
										android:id="@+id/actionLayout"
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:padding="8dp"
										android:orientation="horizontal"
										android:gravity="end"
										android:visibility="gone">
										<LinearLayout
											android:id="@+id/removeLayout"
											android:layout_width="wrap_content"
											android:layout_height="wrap_content"
											android:padding="6dp"
											android:background="?attr/selectableItemBackground"
											android:gravity="center_horizontal|center_vertical"
											android:orientation="horizontal"
											android:layout_weight="1">
											<ImageView
												android:id="@+id/imageview10"
												android:layout_width="20dp"
												android:layout_height="20dp"
												android:src="@drawable/ic_remove_24dp"
												android:scaleType="fitCenter"
												android:tint="?attr/colorPrimary" />
											<TextView
												android:id="@+id/textview10"
												android:layout_width="wrap_content"
												android:layout_height="wrap_content"
												android:text="Remove"
												android:textSize="14sp"
												android:layout_marginStart="6dp" />
										</LinearLayout>
										<LinearLayout
											android:id="@+id/deleteLayout"
											android:layout_width="wrap_content"
											android:layout_height="wrap_content"
											android:padding="6dp"
											android:background="?attr/selectableItemBackground"
											android:gravity="center_horizontal|center_vertical"
											android:orientation="horizontal"
											android:layout_weight="1"
											android:visibility="gone">
											<ImageView
												android:id="@+id/imageview11"
												android:layout_width="20dp"
												android:layout_height="20dp"
												android:src="@drawable/icon_delete"
												android:scaleType="fitCenter"
												android:tint="?attr/colorPrimary" />
											<TextView
												android:id="@+id/textview11"
												android:layout_width="wrap_content"
												android:layout_height="wrap_content"
												android:text="@string/delete"
												android:textSize="14sp"
												android:layout_marginStart="6dp" />
										</LinearLayout>
									</LinearLayout>
								</LinearLayout>
							</com.google.android.material.card.MaterialCardView>
							<TextView
								android:id="@+id/selectedEventsTitle"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginBottom="12dp"
								android:text="Selected Lifecycle Events"
								android:textSize="16sp"
								android:textStyle="bold"
								android:layout_marginStart="4dp"
								android:fontFamily="sans-serif-medium" />
							<androidx.recyclerview.widget.RecyclerView
								android:id="@+id/rvSelectedEvents"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginBottom="8dp"
								android:minHeight="100dp"
								android:nestedScrollingEnabled="false"
								android:visibility="visible" />
							<LinearLayout
								android:id="@+id/noEventsLayout"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:padding="32dp"
								android:gravity="center_horizontal|center_vertical"
								android:orientation="vertical"
								android:visibility="gone">
								<com.google.android.material.imageview.ShapeableImageView
									android:id="@+id/noEventsIcon"
									android:layout_width="64dp"
									android:layout_height="64dp"
									android:layout_marginBottom="16dp"
									android:src="@drawable/default_image"
									android:alpha="0.5"
									app:tint="?attr/colorOnSurfaceVariant" />
								<TextView
									android:id="@+id/noEventsText"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginBottom="4dp"
									android:text="No lifecycle events selected"
									android:textSize="16sp"
									android:textStyle="bold" />
								<TextView
									android:id="@+id/noEventsHint"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="Tap + to add lifecycle events"
									android:textSize="14sp"
									android:alpha="0.7" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/learnMoreSection"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginTop="20dp"
								android:orientation="vertical">
								<TextView
									android:id="@+id/learnMoreBtn"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:padding="10dp"
									android:background="?attr/selectableItemBackground"
									android:text="Learn more about events"
									android:textSize="15sp"
									android:textStyle="bold"
									android:drawablePadding="6dp"
									android:drawableEnd="@drawable/ic_expand_more"
									android:focusable="true"
									android:fontFamily="sans-serif-medium" />
								<com.google.android.material.card.MaterialCardView
									android:id="@+id/tipsCard"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:layout_marginTop="12dp"
									app:cardBackgroundColor="?attr/colorSurfaceVariant"
									android:visibility="gone"
									app:cardCornerRadius="20dp"
									app:cardElevation="0dp"
									app:strokeColor="?attr/colorOutline"
									app:strokeWidth="1dp">
									<LinearLayout
										android:id="@+id/tipsLayout"
										android:layout_width="match_parent"
										android:layout_height="wrap_content"
										android:padding="20dp"
										android:orientation="vertical">
										<TextView
											android:id="@+id/tipsTitle"
											android:layout_width="wrap_content"
											android:layout_height="wrap_content"
											android:layout_marginBottom="16dp"
											android:text="💡 Quick Event Tips"
											android:textSize="18sp"
											android:textStyle="bold" />
										<TextView
											android:id="@+id/tip1"
											android:layout_width="wrap_content"
											android:layout_height="wrap_content"
											android:layout_marginBottom="12dp"
											android:text="• Lifecycle events run automatically at specific times (onCreate, onResume, etc.)"
											android:textSize="14sp" />
										<TextView
											android:id="@+id/tip2"
											android:layout_width="wrap_content"
											android:layout_height="wrap_content"
											android:layout_marginBottom="12dp"
											android:text="• View events respond to user interactions like clicks, touches, and long presses"
											android:textSize="14sp" />
										<TextView
											android:id="@+id/tip3"
											android:layout_width="wrap_content"
											android:layout_height="wrap_content"
											android:layout_marginBottom="12dp"
											android:text="• MoreBlocks let you create reusable functions to organize your code"
											android:textSize="14sp" />
										<TextView
											android:id="@+id/tip4"
											android:layout_width="wrap_content"
											android:layout_height="wrap_content"
											android:text="• Events can be chained together to create complex behaviors"
											android:textSize="14sp" />
									</LinearLayout>
								</com.google.android.material.card.MaterialCardView>
							</LinearLayout>
						</LinearLayout>
						<LinearLayout
							android:id="@+id/viewLifeCycle"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:visibility="gone">
							<TextView
								android:id="@+id/viewsTitle"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginBottom="16dp"
								android:text="View Events"
								android:textSize="18sp"
								android:textStyle="bold" />
							<androidx.recyclerview.widget.RecyclerView
								android:id="@+id/viewsList"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:nestedScrollingEnabled="false"
								android:visibility="visible"
								tools:listitem="@layout/views_click_item" />
							<LinearLayout
								android:id="@+id/noViewsLayout"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:padding="40dp"
								android:gravity="center_horizontal|center_vertical"
								android:orientation="vertical"
								android:visibility="gone">
								<com.google.android.material.imageview.ShapeableImageView
									android:id="@+id/noViewsIcon"
									android:layout_width="80dp"
									android:layout_height="80dp"
									android:layout_marginBottom="20dp"
									android:src="@drawable/default_image"
									android:alpha="0.3"
									app:tint="?attr/colorOnSurfaceVariant" />
								<TextView
									android:id="@+id/noViewsText"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginBottom="8dp"
									android:text="No Views Yet"
									android:textSize="20sp"
									android:textStyle="bold" />
								<TextView
									android:id="@+id/noViewsDescription"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:gravity="center_horizontal|center_vertical"
									android:text="Add views in the Design tab first\nto create view events"
									android:textSize="15sp"
									android:lineSpacingExtra="4dp" />
							</LinearLayout>
						</LinearLayout>
						<LinearLayout
							android:id="@+id/moreBlockLifeCycle"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:visibility="gone">
							<TextView
								android:id="@+id/functionsTitle"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginBottom="16dp"
								android:text="MoreBlocks"
								android:textSize="18sp"
								android:textStyle="bold" />
							<LinearLayout
								android:id="@+id/linear12"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="vertical">
								<androidx.recyclerview.widget.RecyclerView
									android:id="@+id/functionsList"
									android:layout_width="match_parent"
									android:layout_height="match_parent"
									android:nestedScrollingEnabled="false"
									android:visibility="visible"
									tools:listitem="@layout/cus_item_functions" />
								<LinearLayout
									android:id="@+id/noFunctionsLayout"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:padding="40dp"
									android:gravity="center_horizontal|center_vertical"
									android:orientation="vertical"
									android:visibility="gone">
									<com.google.android.material.imageview.ShapeableImageView
										android:id="@+id/noFunctionsIcon"
										android:layout_width="80dp"
										android:layout_height="80dp"
										android:layout_marginBottom="20dp"
										android:src="@drawable/block"
										android:alpha="0.3"
										app:tint="?attr/colorOnSurfaceVariant" />
									<TextView
										android:id="@+id/noFunctionsText"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:layout_marginBottom="8dp"
										android:text="No MoreBlocks Yet"
										android:textSize="20sp"
										android:textStyle="bold" />
									<TextView
										android:id="@+id/noFunctionsDescription"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:gravity="center_horizontal|center_vertical"
										android:text="Create reusable functions and procedures\nusing MoreBlocks"
										android:textSize="15sp"
										android:lineSpacingExtra="4dp" />
								</LinearLayout>
							</LinearLayout>
						</LinearLayout>
						<com.nexusteam.blacklogics.widget.AdLayout
							android:id="@+id/adLayout"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							app:bannerAdUnitId="ca-app-pub-2903137488772866/3754424748"
							app:interstitialAdUnitId="ca-app-pub-2903137488772866/3754424748" />
					</LinearLayout>
				</androidx.core.widget.NestedScrollView>
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>
	<com.google.android.material.floatingactionbutton.FloatingActionButton
		android:id="@+id/_fab"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_margin="16dp"
		android:layout_gravity="right|bottom"
		app:srcCompat="@drawable/ic_add_black" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
