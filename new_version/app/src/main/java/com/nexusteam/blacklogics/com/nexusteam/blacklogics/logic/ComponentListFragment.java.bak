    /**
     * Load components from BlockStorage into memory (like LogicEditorActivity does)
     */
    private void loadComponenetsIntoMemory() {
        try {
            if (activityName == null || activityName.isEmpty()) {
                android.util.Log.e("ComponentList", "Activity name is null!");
                return;
            }
            
            // Remove .java extension if present
            String cleanActivityName = activityName;
            if (cleanActivityName.endsWith(".java")) {
                cleanActivityName = cleanActivityName.substring(0, cleanActivityName.length() - 5);
            }
            
            // Read all data from BlockStorage
            Object[] allData = BlockStorage.readAll();
            
            if (allData == null || allData.length <= 2) {
                android.util.Log.d("ComponentList", "No data in BlockStorage");
                return;
            }
            
            // Get components map from BlockStorage (index 2)
            HashMap<String, ArrayList<ComponentData>> componentsMap = 
                (HashMap<String, ArrayList<ComponentData>>) allData[2];
            
            if (componentsMap == null) {
                android.util.Log.d("ComponentList", "Components map is null");
                return;
            }
            
            // Get components for this activity
            ArrayList<ComponentData> storedComponents = componentsMap.get(cleanActivityName);
            if (storedComponents == null || storedComponents.isEmpty()) {
                android.util.Log.d("ComponentList", "No components found for activity: " + cleanActivityName);
                return;
            }
            
            // Use HashSet to avoid duplicates
            HashSet<String> addedComponents = new HashSet<String>();
            
            // Refresh ComponentManager to get latest custom components
            componentManager.refreshCustomComponents();
            List<ComponentBean> customComponents = componentManager.getCustomComponents();
            
            android.util.Log.d("ComponentList", "Loading " + storedComponents.size() + " components for " + cleanActivityName);
            
            // Iterate through stored components
            for (int i = 0; i < storedComponents.size(); i++) {
                ComponentData data = storedComponents.get(i);
                
                if (data == null) continue;
                
                // Create unique key to avoid duplicates
                String key = data.type + "_" + data.mainData + "_" + data.extraData;
                if (addedComponents.contains(key)) {
                    continue;
                }
                addedComponents.add(key);
                
                // Determine component type
                int componentType = data.type;
                
                // If type > 21, it's a custom component
                if (componentType > 21) {
                    // Find matching custom component
                    ComponentBean matchingCustom = null;
                    for (int j = 0; j < customComponents.size(); j++) {
                        ComponentBean cc = customComponents.get(j);
                        if (cc.type == componentType || 
                            (cc.typeName != null && cc.typeName.equals(data.extraData))) {
                            matchingCustom = cc;
                            break;
                        }
                    }
                    
                    if (matchingCustom != null) {
                        android.util.Log.d("ComponentList", "Loading custom component: " + matchingCustom.name + 
                            " (type: " + componentType + ", id: " + data.mainData + ")");
                    } else {
                        android.util.Log.d("ComponentList", "Loading unknown custom component type: " + componentType);
                    }
                }
                
                // Load component into memory using ma.a().a() method
                // Parameters: activityName, type, mainData (componentId), extraData (typeName)
                ma.a(this.screenId).a(
                    cleanActivityName,
                    data.type,
                    data.mainData,
                    data.extraData
                );
            }
            
            // After loading, refresh the component list
            refreshComponentList();
            android.util.Log.d("ComponentList", "Components loaded successfully!");
            
        } catch (Exception e) {
            android.util.Log.e("ComponentList", "Error loading components: " + e.getMessage());
            e.printStackTrace();
        }
    }
}