<resources>
    <style name="AppTheme.Button">
        <item name="colorButtonNormal">?attr/colorPrimary</item>
        <item name="colorControlHighlight">?attr/colorPrimary</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="ToolbarTextAppearance">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="progress">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowSoftInputMode">adjustUnspecified|stateVisible|adjustResize</item>
    </style>
    <style name="AppTheme.Button.Blue">
        <item name="colorButtonNormal">?attr/colorPrimary</item>
        <item name="colorControlHighlight">?attr/colorPrimary</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="AppTheme.Button.LightBlue">
        <item name="colorButtonNormal">?attr/colorPrimary</item>
        <item name="colorControlHighlight">?attr/colorPrimary</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="DesignTabTextAppearance">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="textAllCaps">true</item>
    </style>
    <style name="ManageViewTabLayout">
        <item name="android:background">?attr/colorSurface</item>
        <item name="tabGravity">@null</item>
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabMaxWidth">0dp</item>
        <item name="tabMode">scrollable</item>
        <item name="tabSelectedTextColor">?attr/colorOnSurface</item>
        <item name="tabTextAppearance">@style/DesignTabTextAppearance</item>
    </style>
    <style name="NumberPickerText">
        <item name="android:textColorPrimary">?attr/colorPrimary</item>
        <item name="android:textSize">14dp</item>
        <item name="android:textColorHighlight">?attr/colorSurfaceVariant</item>
    </style>
    <style name="TextAppearance">
        <item name="android:textColorPrimary">?attr/colorOutline</item>
        <item name="android:textSize">12sp</item>
        <item name="colorControlActivated">?attr/colorOutline</item>
        <item name="colorControlNormal">?attr/colorOutline</item>
    </style>
<style name="AppThemeButtonWhiteBlue">
    <item name="android:textColor">?attr/colorPrimary</item>
    <item name="colorButtonNormal">?attr/colorSurface</item>
    <item name="colorControlHighlight">?attr/colorSurface</item>
    <item name="textAllCaps">false</item>
</style>
    <style name="ThemeOverlay">
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="ThemeOverlay.ToolbarMenu">
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>
