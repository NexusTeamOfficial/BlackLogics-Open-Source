<resources>
    <style name="AppTheme.Button">
        <item name="colorButtonNormal">@color/color_btn_ltblue_normal</item>
        <item name="colorControlHighlight">@color/color_btn_ltblue_highlight</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="ToolbarTextAppearance">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tool_bar_text_color</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="progress">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowSoftInputMode">adjustUnspecified|stateVisible|adjustResize</item>
    </style>
    <style name="AppTheme.Button.Blue">
        <item name="colorButtonNormal">@color/color_btn_blue_normal</item>
        <item name="colorControlHighlight">@color/color_btn_blue_highlight</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="AppTheme.Button.LightBlue">
        <item name="colorButtonNormal">@color/color_btn_ltblue_normal</item>
        <item name="colorControlHighlight">@color/color_btn_ltblue_highlight</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="DesignTabTextAppearance">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/design_tab_text_color</item>
        <item name="textAllCaps">true</item>
    </style>
    <style name="ManageViewTabLayout">
        <item name="android:background">@color/design_tab_background</item>
        <item name="tabGravity">@null</item>
        <item name="tabIndicatorColor">@color/design_tab_indicator_color</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabMaxWidth">0dp</item>
        <item name="tabMode">scrollable</item>
        <item name="tabSelectedTextColor">@color/design_tab_selected_text_color</item>
        <item name="tabTextAppearance">@style/DesignTabTextAppearance</item>
    </style>
    <style name="NumberPickerText">
        <item name="android:textColorPrimary">@color/scolor_blue_01</item>
        <item name="android:textSize">14dp</item>
        <item name="android:textColorHighlight">#eee</item>
    </style>
    <style name="TextAppearance">
        <item name="android:textColorPrimary">@color/light_grey</item>
        <item name="android:textSize">12sp</item>
        <item name="colorControlActivated">@color/light_grey</item>
        <item name="colorControlNormal">@color/light_grey</item>
    </style>
    <style name="AppThemeButtonWhiteBlue">
        <item name="android:textColor">@color/color_primary</item>
        <item name="colorButtonNormal">#fff</item>
        <item name="colorControlHighlight">#ddd</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="ThemeOverlay">
        <item name="android:colorBackground">@color/design_menu_bg</item>
        <item name="android:textColor">@color/design_menu_text_color</item>
    </style>
    <style name="ThemeOverlay.ToolbarMenu">
        <item name="android:colorBackground">@color/design_menu_bg</item>
        <item name="android:textColor">@color/design_menu_text_color</item>
    </style>
</resources>
