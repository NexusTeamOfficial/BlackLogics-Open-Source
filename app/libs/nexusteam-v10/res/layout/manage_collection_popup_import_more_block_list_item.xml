<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:aapt="http://schemas.android.com/aapt" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView android:id="@+id/layout_item" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:layout_marginTop="2dp" android:layout_marginRight="4dp" android:layout_marginBottom="2dp" app:cardBackgroundColor="#f5f5f5">
        <LinearLayout android:gravity="left|center_vertical|center_horizontal|center" android:layout_gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="60dp">
            <LinearLayout android:orientation="vertical" android:background="?attr/selectableItemBackground" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_weight="1" android:layout_alignParentLeft="true" android:layout_centerVertical="true">
                <TextView android:textSize="16sp" android:textColor="#404040" android:id="@+id/tv_block_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="16dp" android:layout_marginTop="4dp" android:layout_marginRight="16dp"/>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginLeft="8dp" android:layout_marginTop="4dp" android:layout_marginRight="8dp">
                    <FrameLayout android:id="@+id/block_area" android:layout_width="wrap_content" android:layout_height="match_parent"/>
                </HorizontalScrollView>
            </LinearLayout>
            <ImageView android:id="@+id/img_selected" android:padding="8dp" android:visibility="gone" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_checkmark_green_48dp" android:layout_alignParentRight="true" android:layout_centerVertical="true"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
