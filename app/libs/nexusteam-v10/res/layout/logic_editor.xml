<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:aapt="http://schemas.android.com/aapt" android:id="@+id/layout" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
        <include layout="@layout/toolbar"/>
        <com.nexusteam.internal.editor.view.ViewLogicEditor android:id="@+id/editor" android:background="#ffffff" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="4dp"/>
    </LinearLayout>
    <com.nexusteam.internal.editor.LogicEditorDrawer android:id="@+id/right_drawer" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentTop="true" android:translationX="200dp" android:layout_alignParentEnd="true"/>
    <LinearLayout android:orientation="vertical" android:id="@+id/layout_palette" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fab_toggle_palette" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="@dimen/action_button_margin" android:src="@drawable/block_flled_white"/>
        <LinearLayout android:orientation="horizontal" android:id="@+id/area_palette" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <com.nexusteam.internal.editor.logic.PaletteBlock android:id="@+id/palette_block" android:layout_width="match_parent" android:layout_height="match_parent"/>
        </LinearLayout>
    </LinearLayout>
    <com.nexusteam.internal.editor.logic.LogicTopMenu android:id="@+id/top_menu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentTop="true" android:translationY="-48dp" android:layout_alignParentStart="true"/>
    <com.nexusteam.internal.editor.view.ViewDummy android:id="@+id/dummy" android:layout_width="match_parent" android:layout_height="match_parent"/>
</RelativeLayout>
