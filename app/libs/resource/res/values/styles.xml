<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Prevent this file from being deleted -->
    <style name="pleaseDontDeleteThisFile" parent="Theme.Material3.DayNight.NoActionBar" />


    <!-- Button Style -->
    <style name="ButtonStyle">
        <item name="android:background">@color/buttonColor</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- TextView Style -->
    <style name="TextViewStyle">
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Divider Style -->
    <style name="DividerStyle">
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!-- Status Bar Color -->
    <style name="StatusBarStyle">
        <item name="android:statusBarColor">@color/statusBarColor</item>
    </style>

    <!-- TabLayout Text Style -->
    <style name="TabLayoutTextStyle">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
    </style>

    <!-- Custom Action Bar Style -->
    <style name="CustomActionBarStyle">
        <item name="android:background">@android:color/white</item>
        <item name="android:titleTextColor">@android:color/white</item>
    </style>

    <!-- Custom Dialog Style -->
    <style name="CustomDialog" parent="@style/Base.Theme.AppCompat.Light.Dialog.FixedSize">
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowClipToOutline">false</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>

    <!-- Custom Dialog Theme -->
    <style name="CustomDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:layout_width">match_parent</item> <!-- Use match_parent or wrap_content -->
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- Collapsing Toolbar Style -->
    <style name="CustomCollapsingCollapsed">
        <item name="android:textColor">@color/tool_bar_text_color</item>
    </style>
    
     <style name="AppTheme.Et" parent="@style/AppTheme">
        <item name="colorControlHighlight">@android:color/transparent</item>
        <item name="colorControlNormal">@android:color/transparent</item>
        <item name="colorPrimary">#ff212121</item>
        <item name="colorPrimaryDark">#ff000000</item>
    </style>

    <style name="AppTheme.Button.LightBlue" parent="@style/Base.Widget.AppCompat.Button">
        <item name="colorButtonNormal">@color/color_btn_ltblue_normal</item>
        <item name="colorControlHighlight">@color/color_btn_ltblue_highlight</item>
        <item name="textAllCaps">false</item>
    </style>
    
    <style name="AppTheme.Button.CoolGreen" parent="@style/Base.Widget.AppCompat.Button">
        <item name="colorButtonNormal">#ff34bc7e</item>
        <item name="colorControlHighlight">@color/scolor_green_normal</item>
    </style>

    <!-- Toolbar Style -->
    <style name="ToolbarTextAppearance">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
    </style>
    
      <style name="progress">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowSoftInputMode">adjustPan</item>
    </style>
    
    <style name="MyTabTextAppearance" parent="TextAppearance.AppCompat.Button">
        <item name="android:textSize">14sp</item>
        <item name="textAllCaps">true</item>
    </style>
    
    <style name="AboutPageTabLayout" parent="Base.Widget.Design.TabLayout">
        <item name="tabTextAppearance">@style/MyTabTextAppearance</item>
    </style>
    
      <style name="Base.TextAppearance.AppCompat.Button" parent="@android:style/TextAppearance.Material.Button" />
      <style name="TextAppearance.AppCompat.Button" parent="@style/Base.TextAppearance.AppCompat.Button" />
    
    <!-- Light theme -->
<style name="BlackDialogThemeLight" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
    <item name="colorPrimary">@android:color/black</item>
    <item name="android:textColorPrimary">@android:color/white</item>
</style>

<!-- Dark theme -->
<style name="BlackDialogThemeDark" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
    <item name="colorPrimary">@android:color/white</item>
    <item name="android:textColorPrimary">@android:color/black</item>
</style>

<style name="CustomHeadline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textColor">#212121</item>
    </style>


</resources>
