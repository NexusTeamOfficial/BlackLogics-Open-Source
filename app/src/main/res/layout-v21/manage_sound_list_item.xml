<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_item"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginStart="4dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="2dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="?attr/colorSurface">
    
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        
        <CheckBox
            android:id="@+id/chk_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:contentDescription="@null"
            android:buttonTint="?attr/colorPrimary"/>
            
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp">
            
            <ImageView
                android:id="@+id/img_album"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:tint="?attr/colorPrimary"/>
                
            <LinearLayout
                android:gravity="center"
                android:id="@+id/delete_img_container"
                android:background="@drawable/circle_bg_dark_grey_alpha"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerInParent="true"
                android:layout_centerHorizontal="true"
                android:alpha="0.8">
                
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/img_delete"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_trashcan_white_48dp"
                    app:tint="?attr/colorOnSurface"/>
            </LinearLayout>
        </RelativeLayout>
        
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                
                <TextView
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnSurface"
                    android:id="@+id/tv_sound_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"/>
                    
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    
                    <TextView
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:id="@+id/tv_currenttime"
                        android:paddingEnd="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"/>
                        
                    <ProgressBar
                        android:id="@+id/prog_playtime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/SoundProgressBar"/>
                        
                    <TextView
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:id="@+id/tv_endtime"
                        android:paddingStart="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"/>
                </LinearLayout>
            </LinearLayout>
            
            <ImageView
                android:id="@+id/img_play"
                android:padding="8dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                app:tint="?attr/colorPrimary"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>