<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <attr
        name="colorBackground"
        format="color" />
    <declare-styleable
        name="CustomTabLayout">
        <attr
            name="tabMinWidth"
            format="dimension" />
        <attr
            name="tabPaddingStart"
            format="dimension" />
        <attr
            name="tabPaddingEnd"
            format="dimension" />
    </declare-styleable>
    <declare-styleable
        name="WidgetFrameLayout">
        <attr
            name="foreground"
            format="reference" />
        <attr
            name="foregroundGravity"
            format="integer" />
        <attr
            name="measureAllChildren"
            format="boolean" />
    </declare-styleable>
    <declare-styleable
        name="SideBarVertical">
        <attr
            name="iconSize"
            format="dimension" />
        <attr
            name="textColor"
            format="color" />
        <attr
            name="selectedBackgroundColor"
            format="color" />
        <attr
            name="nexusShowDividers"
            format="boolean" />
        <attr
            name="darkTheme"
            format="boolean" />
    </declare-styleable>
</resources>