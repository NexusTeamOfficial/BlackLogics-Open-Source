<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <attr
        name="colorBackground"
        format="color" />
    <declare-styleable
        name="CustomTabLayout">
        <attr
            name="tabMinWidth"
            format="dimension" />
        <attr
            name="tabPaddingStart"
            format="dimension" />
        <attr
            name="tabPaddingEnd"
            format="dimension" />
    </declare-styleable>
    <declare-styleable
        name="WidgetFrameLayout">
        <attr
            name="foreground"
            format="reference" />
        <attr
            name="foregroundGravity"
            format="integer" />
        <attr
            name="measureAllChildren"
            format="boolean" />
    </declare-styleable>
    <declare-styleable
        name="SideBarVertical">
        <attr
            name="iconSize"
            format="dimension" />
        <attr
            name="textColor"
            format="color" />
        <attr
            name="selectedBackgroundColor"
            format="color" />
        <attr
            name="nexusShowDividers"
            format="boolean" />
        <attr
            name="darkTheme"
            format="boolean" />
    </declare-styleable>
    <declare-styleable
        name="NavBarItem">
        <attr
            name="active_color"
            format="color" />
        <attr
            name="inactive_color"
            format="color" />
    </declare-styleable>
    <declare-styleable
        name="AdLayout">
        <attr
            name="bannerAdUnitId"
            format="string" />
        <attr
            name="interstitialAdUnitId"
            format="string" />
        <attr
            name="adSize"
            format="enum|string">
            <enum
                name="banner"
                value="1" />
            <enum
                name="full_banner"
                value="4" />
            <enum
                name="large_banner"
                value="2" />
            <enum
                name="leaderboard"
                value="5" />
            <enum
                name="medium_rectangle"
                value="3" />
            <enum
                name="smart_banner"
                value="0" />
        </attr>
    </declare-styleable>
</resources>