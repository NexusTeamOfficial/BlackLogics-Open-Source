<svg xmlns="http://www.w3.org/2000/svg"
  width="80" height="80"
  viewBox="0 0 80 80">

  <!-- Presenting hand -->
  <path
    d="M 10 68
       Q 4 61 5 48
       L 7 33
       Q 8 27 14 27
       Q 20 27 20 33 L 20 40
       Q 22 34 28 33
       Q 34 33 34 39
       L 62 39
       Q 70 39 70 47
       L 68 63
       Q 64 79 48 80
       L 25 80
       Q 14 78 10 68 Z"
    fill="#E8C99A"
    stroke="#C4965A"
    stroke-width="1.2"
    stroke-linejoin="round"
    stroke-linecap="round"/>

  <!-- Gift box body -->
  <rect
    x="28" y="18"
    width="34" height="20"
    rx="3"
    fill="#EF9F27"
    stroke="#BA7517"
    stroke-width="1"/>

  <!-- Ribbon vertical -->
  <line
    x1="45" y1="18" x2="45" y2="38"
    stroke="#A32D2D" stroke-width="2.5"/>

  <!-- Ribbon horizontal -->
  <line
    x1="28" y1="28" x2="62" y2="28"
    stroke="#A32D2D" stroke-width="2.5"/>

  <!-- Gift lid -->
  <rect
    x="26" y="12"
    width="38" height="8"
    rx="2"
    fill="#EF9F27"
    stroke="#BA7517"
    stroke-width="1"/>

  <!-- Bow left loop -->
  <path
    d="M 39 12 C 36 4, 30 4, 33 10 Z"
    fill="#E24B4A"
    stroke="#A32D2D"
    stroke-width="0.8"/>

  <!-- Bow right loop -->
  <path
    d="M 51 12 C 54 4, 60 4, 57 10 Z"
    fill="#E24B4A"
    stroke="#A32D2D"
    stroke-width="0.8"/>

  <!-- Bow center knot -->
  <circle
    cx="45" cy="10" r="3"
    fill="#E24B4A"
    stroke="#A32D2D"
    stroke-width="0.8"/>

</svg>