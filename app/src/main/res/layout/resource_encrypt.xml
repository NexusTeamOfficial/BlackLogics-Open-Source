<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:fitsSystemWindows="true"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="?attr/colorSurface"
	tools:context=".ResourceEncryptActivity">
	<include layout="@layout/toolbar_improved" />
	<ScrollView
		android:id="@+id/vscroll2"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:paddingBottom="96dp"
		android:fillViewport="true"
		android:scrollbars="none"
		android:clipToPadding="false">
		<LinearLayout
			android:id="@+id/linear10"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="16dp"
			android:paddingBottom="16dp"
			android:orientation="vertical"
			android:paddingStart="16dp"
			android:paddingEnd="16dp">
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview4"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
				style="@style/Widget.Material3.CardView.Filled"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeWidth="0dp">
				<LinearLayout
					android:id="@+id/linear11"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="20dp"
					android:orientation="vertical">
					<com.google.android.material.materialswitch.MaterialSwitch
						android:id="@+id/sw_encrypt_enabled"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="@string/activate_resource_encryption"
						android:textSize="12sp"
						android:minHeight="48dp"
						android:textAppearance="?attr/textAppearanceTitleMedium" />
					<LinearLayout
						android:id="@+id/linear12"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:gravity="top"
						android:orientation="horizontal">
						<ImageView
							android:id="@+id/imageview3"
							android:layout_width="24dp"
							android:layout_height="24dp"
							android:src="@drawable/ic_lock_96"
							android:scaleType="fitCenter"
							android:layout_marginEnd="12dp"
							app:tint="?attr/colorOnSurfaceVariant"
							android:contentDescription="@null"
							android:focusable="false" />
						<TextView
							android:id="@+id/textview5"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="@string/resource_encryption_desc"
							android:textSize="12sp"
							android:layout_weight="1"
							android:textAppearance="?attr/textAppearanceBodyMedium"
							android:lineSpacingExtra="2dp"
							android:focusable="false" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview5"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				app:cardBackgroundColor="?attr/colorErrorContainer"
				style="@style/Widget.Material3.CardView.Filled"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeWidth="0dp">
				<LinearLayout
					android:id="@+id/linear13"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="20dp"
					android:gravity="top"
					android:orientation="horizontal">
					<ImageView
						android:id="@+id/imageview2"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:src="@drawable/default_image"
						android:scaleType="fitCenter"
						android:layout_marginEnd="12dp"
						app:tint="?attr/colorOnErrorContainer"
						android:contentDescription="@null"
						android:focusable="false"
						tools:ignore="MissingPrefix" />
					<LinearLayout
						android:id="@+id/linear4"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1">
						<TextView
							android:id="@+id/textview6"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/warning"
							android:textSize="12sp"
							android:textAppearance="?attr/textAppearanceTitleSmall"
							android:focusable="false" />
						<TextView
							android:id="@+id/textview7"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="4dp"
							android:text="@string/resource_encryption_warning"
							android:textSize="12sp"
							android:textAppearance="?attr/textAppearanceBodySmall"
							android:lineSpacingExtra="2dp"
							android:focusable="false" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview6"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
				style="@style/Widget.Material3.CardView.Filled"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeWidth="0dp">
				<LinearLayout
					android:id="@+id/linear14"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="20dp"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/linear15"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/textview9"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="@string/encryption_key"
							android:textSize="12sp"
							android:layout_weight="1"
							android:textAppearance="?attr/textAppearanceTitleMedium"
							android:maxLines="1"
							android:ellipsize="end"
							android:focusable="false" />
						<ImageView
							android:id="@+id/btn_edit_key"
							android:layout_width="48dp"
							android:layout_height="48dp"
							android:padding="12dp"
							android:background="?attr/selectableItemBackgroundBorderless"
							android:src="@drawable/ic_edit_white_48dp"
							android:scaleType="fitCenter"
							app:tint="?attr/colorPrimary"
							android:contentDescription="@string/encryption_key"
							android:focusable="true" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear16"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:gravity="top"
						android:orientation="horizontal">
						<ImageView
							android:id="@+id/imageview4"
							android:layout_width="24dp"
							android:layout_height="24dp"
							android:src="@drawable/icon_key_round"
							android:scaleType="fitCenter"
							android:layout_marginEnd="12dp"
							app:tint="?attr/colorOnSurfaceVariant"
							android:contentDescription="@null"
							android:focusable="false" />
						<TextView
							android:id="@+id/textview8"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="@string/encryption_key_desc"
							android:textSize="12sp"
							android:layout_weight="1"
							android:textAppearance="?attr/textAppearanceBodyMedium"
							android:lineSpacingExtra="2dp"
							android:focusable="false" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.nexusteam.blacklogics.widget.AdLayout
				android:id="@+id/adLayout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				app:bannerAdUnitId="ca-app-pub-2903137488772866/3754424748"
				app:interstitialAdUnitId="ca-app-pub-2903137488772866/3754424748" />
		</LinearLayout>
	</ScrollView>
</LinearLayout>
