<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:fitsSystemWindows="true"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="?attr/colorSurface"
	android:theme="@style/Theme.Material3.DayNight.NoActionBar">
	<include layout="@layout/toolbar_improved" />
	<ScrollView
		android:id="@+id/vscroll2"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:paddingBottom="96dp"
		android:fillViewport="true"
		android:scrollbars="none"
		android:clipToPadding="false">
		<LinearLayout
			android:id="@+id/linear1"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="16dp"
			android:orientation="vertical">
			<TextView
				android:id="@+id/textview7"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:text="@string/settings"
				android:textSize="12sp"
				android:layout_marginStart="4dp"
				android:textAppearance="?attr/textAppearanceLabelLarge"
				android:letterSpacing="0.1"
				android:focusable="false" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/blockManagerCard"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
				style="@style/Widget.Material3.CardView.Filled"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeWidth="0dp"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground">
				<LinearLayout
					android:id="@+id/linear11"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="20dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<com.google.android.material.imageview.ShapeableImageView
						android:id="@+id/blockManager"
						android:layout_width="52dp"
						android:layout_height="52dp"
						android:padding="13dp"
						android:background="@drawable/circle_background"
						android:src="@drawable/block_flled_white"
						app:tint="?attr/colorPrimary"
						android:contentDescription="@null"
						android:focusable="false" />
					<LinearLayout
						android:id="@+id/linear3"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1"
						android:paddingStart="16dp"
						android:paddingEnd="8dp">
						<TextView
							android:id="@+id/blocksManagerTitle"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginBottom="4dp"
							android:text="@string/block_manager_title"
							android:textSize="12sp"
							android:textAppearance="?attr/textAppearanceTitleMedium"
							android:maxLines="1"
							android:ellipsize="end"
							android:focusable="false" />
						<TextView
							android:id="@+id/blockManagerDesc"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/block_manager_sub_title"
							android:textSize="12sp"
							android:textAppearance="?attr/textAppearanceBodySmall"
							android:lineSpacingExtra="2dp"
							android:maxLines="2"
							android:ellipsize="end"
							android:focusable="false" />
					</LinearLayout>
					<ImageView
						android:id="@+id/imageview7"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:src="@drawable/ic_chevron_right"
						android:scaleType="center"
						app:tint="?attr/colorOnSurfaceVariant"
						android:contentDescription="@null"
						android:importantForAccessibility="no"
						android:focusable="false" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/aboutAppCard"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
				style="@style/Widget.Material3.CardView.Filled"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeWidth="0dp"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground">
				<LinearLayout
					android:id="@+id/linear12"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="20dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<com.google.android.material.imageview.ShapeableImageView
						android:id="@+id/imageview1"
						android:layout_width="52dp"
						android:layout_height="52dp"
						android:padding="13dp"
						android:background="@drawable/circle_background_secondary"
						android:src="@drawable/icon_info_round"
						app:tint="?attr/colorSecondary"
						android:contentDescription="@null"
						android:focusable="false" />
					<LinearLayout
						android:id="@+id/linear6"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1"
						android:paddingStart="16dp"
						android:paddingEnd="8dp">
						<TextView
							android:id="@+id/textview1"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginBottom="4dp"
							android:text="@string/about_app_title"
							android:textSize="12sp"
							android:textAppearance="?attr/textAppearanceTitleMedium"
							android:maxLines="1"
							android:ellipsize="end"
							android:focusable="false" />
						<TextView
							android:id="@+id/textview2"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/application_environment_desc"
							android:textSize="12sp"
							android:textAppearance="?attr/textAppearanceBodySmall"
							android:lineSpacingExtra="2dp"
							android:maxLines="2"
							android:ellipsize="end"
							android:focusable="false" />
					</LinearLayout>
					<ImageView
						android:id="@+id/imageview8"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:src="@drawable/ic_chevron_right"
						android:scaleType="center"
						app:tint="?attr/colorOnSurfaceVariant"
						android:contentDescription="@null"
						android:importantForAccessibility="no"
						android:focusable="false" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/componentManagerCard"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
				style="@style/Widget.Material3.CardView.Filled"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeWidth="0dp"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground">
				<LinearLayout
					android:id="@+id/linear17"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="20dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<com.google.android.material.imageview.ShapeableImageView
						android:id="@+id/imageview2"
						android:layout_width="52dp"
						android:layout_height="52dp"
						android:padding="13dp"
						android:background="@drawable/circle_background_secondary"
						android:src="@drawable/icon_dataset_round"
						app:tint="?attr/colorSecondary"
						android:contentDescription="@null"
						android:focusable="false" />
					<LinearLayout
						android:id="@+id/linear18"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1"
						android:paddingStart="16dp"
						android:paddingEnd="8dp">
						<TextView
							android:id="@+id/textview11"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginBottom="4dp"
							android:text="@string/title_component_manager"
							android:textSize="12sp"
							android:textAppearance="?attr/textAppearanceTitleMedium"
							android:maxLines="1"
							android:ellipsize="end"
							android:focusable="false" />
						<TextView
							android:id="@+id/textview12"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/component_manager_desc"
							android:textSize="12sp"
							android:textAppearance="?attr/textAppearanceBodySmall"
							android:lineSpacingExtra="2dp"
							android:maxLines="2"
							android:ellipsize="end"
							android:focusable="false" />
					</LinearLayout>
					<ImageView
						android:id="@+id/imageview9"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:src="@drawable/ic_chevron_right"
						android:scaleType="center"
						app:tint="?attr/colorOnSurfaceVariant"
						android:contentDescription="@null"
						android:importantForAccessibility="no"
						android:focusable="false" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/textview8"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="24dp"
				android:layout_marginBottom="12dp"
				android:text="@string/preferences"
				android:textSize="12sp"
				android:layout_marginStart="4dp"
				android:textAppearance="?attr/textAppearanceLabelLarge"
				android:letterSpacing="0.1"
				android:focusable="false" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview2"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="24dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
				style="@style/Widget.Material3.CardView.Filled"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeWidth="0dp">
				<LinearLayout
					android:id="@+id/linear13"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/linear14"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="20dp"
						android:background="?attr/selectableItemBackground"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:focusable="true">
						<TextView
							android:id="@+id/textview9"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="@string/app_dark_mode_title"
							android:textSize="12sp"
							android:layout_weight="1"
							android:textAppearance="?attr/textAppearanceBodyLarge"
							android:maxLines="1"
							android:ellipsize="end"
							android:focusable="false" />
						<TextView
							android:id="@+id/themeValue"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/theme_system_default"
							android:textSize="12sp"
							android:layout_marginEnd="8dp"
							android:textAppearance="?attr/textAppearanceBodyMedium"
							android:maxLines="1"
							android:ellipsize="end"
							android:focusable="false" />
						<ImageView
							android:id="@+id/imageview4"
							android:layout_width="24dp"
							android:layout_height="24dp"
							android:src="@drawable/ic_chevron_right"
							android:scaleType="center"
							app:tint="?attr/colorOnSurfaceVariant"
							android:contentDescription="@null"
							android:importantForAccessibility="no"
							android:focusable="false" />
					</LinearLayout>
					<View
						android:id="@+id/view15"
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:background="?attr/colorOutlineVariant"
						android:layout_marginStart="20dp"
						android:layout_marginEnd="20dp" />
					<LinearLayout
						android:id="@+id/linear16"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="20dp"
						android:background="?attr/selectableItemBackground"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:focusable="true">
						<TextView
							android:id="@+id/textview10"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="@string/language"
							android:textSize="12sp"
							android:layout_weight="1"
							android:textAppearance="?attr/textAppearanceBodyLarge"
							android:maxLines="1"
							android:ellipsize="end"
							android:focusable="false" />
						<TextView
							android:id="@+id/languageValue"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/language_title"
							android:textSize="12sp"
							android:layout_marginEnd="8dp"
							android:textAppearance="?attr/textAppearanceBodyMedium"
							android:maxLines="1"
							android:ellipsize="end"
							android:focusable="false" />
						<ImageView
							android:id="@+id/imageview10"
							android:layout_width="24dp"
							android:layout_height="24dp"
							android:src="@drawable/ic_chevron_right"
							android:scaleType="center"
							app:tint="?attr/colorOnSurfaceVariant"
							android:contentDescription="@null"
							android:importantForAccessibility="no"
							android:focusable="false" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.nexusteam.blacklogics.widget.AdLayout
				android:id="@+id/adLayout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				app:bannerAdUnitId="ca-app-pub-2903137488772866/3754424748"
				app:interstitialAdUnitId="ca-app-pub-2903137488772866/3754424748" />
		</LinearLayout>
	</ScrollView>
</LinearLayout>
