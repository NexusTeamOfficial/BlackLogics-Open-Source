<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:fitsSystemWindows="true"
	android:id="@+id/linear1"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingStart="24dp"
	android:paddingEnd="24dp"
	android:paddingTop="20dp"
	android:paddingBottom="20dp"
	android:background="?attr/colorSurfaceContainerHigh">
	<TextView
		android:id="@+id/textview7"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="Write lib dependency"
		android:textSize="12sp"
		android:textAppearance="?attr/textAppearanceHeadlineSmall"
		android:maxLines="1"
		android:ellipsize="end"
		android:focusable="false" />
	<LinearLayout
		android:id="@+id/linear3"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="horizontal"
		android:visibility="gone"
		tools:visibility="visible">
		<com.google.android.material.progressindicator.LinearProgressIndicator
			android:id="@+id/progressbar1"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:layout_marginBottom="8dp"
			app:indicatorColor="?attr/colorPrimary"
			app:trackColor="?attr/colorSurfaceContainerHighest"
			app:trackCornerRadius="2dp"
			app:trackThickness="4dp" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/linear4"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp"
		android:orientation="vertical">
		<com.google.android.material.textfield.TextInputLayout
			android:id="@+id/til_dependency"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/edittext1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textSize="12sp"
				android:inputType="textNoSuggestions"
				android:textAppearance="?attr/textAppearanceBodyLarge"
				android:maxLines="1"
				android:focusable="true"
				android:focusableInTouchMode="true" />
		</com.google.android.material.textfield.TextInputLayout>
	</LinearLayout>
	<LinearLayout
		android:id="@+id/linear7"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp"
		android:gravity="top"
		android:orientation="horizontal">
		<TextView
			android:id="@+id/textview3"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:text="You can find the dependency of a library in GitHub, typically in the Readme file. However, please note that this is not Gradle system, so it won't download inner dependencies of a library. If the library you download has inner dependencies, you will need to download them separately."
			android:textSize="12sp"
			android:layout_weight="1"
			android:textAppearance="?attr/textAppearanceBodySmall"
			android:lineSpacingExtra="2dp"
			android:focusable="false" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/linear8"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="20dp"
		android:orientation="horizontal"
		android:gravity="end|center_vertical">
		<LinearLayout
			android:id="@+id/linear9"
			android:layout_width="wrap_content"
			android:layout_height="48dp"
			android:background="@drawable/bg_m3_button_filled"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="horizontal"
			android:minWidth="88dp"
			android:paddingStart="20dp"
			android:paddingEnd="20dp"
			android:focusable="true">
			<TextView
				android:id="@+id/textview8"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Start"
				android:textSize="12sp"
				android:textAppearance="?attr/textAppearanceLabelLarge"
				android:focusable="false" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear10"
			android:layout_width="wrap_content"
			android:layout_height="48dp"
			android:background="@drawable/bg_m3_button_tonal"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="horizontal"
			android:layout_marginStart="8dp"
			android:minWidth="88dp"
			android:paddingStart="20dp"
			android:paddingEnd="20dp"
			android:visibility="invisible"
			android:focusable="true">
			<TextView
				android:id="@+id/textview9"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Pause"
				android:textSize="12sp"
				android:textAppearance="?attr/textAppearanceLabelLarge"
				android:focusable="false" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear11"
			android:layout_width="wrap_content"
			android:layout_height="48dp"
			android:background="@drawable/bg_m3_button_tonal"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="horizontal"
			android:layout_marginStart="8dp"
			android:minWidth="88dp"
			android:paddingStart="20dp"
			android:paddingEnd="20dp"
			android:visibility="invisible"
			android:focusable="true">
			<TextView
				android:id="@+id/textview10"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Resume"
				android:textSize="12sp"
				android:textAppearance="?attr/textAppearanceLabelLarge"
				android:focusable="false" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear12"
			android:layout_width="wrap_content"
			android:layout_height="48dp"
			android:background="?attr/selectableItemBackground"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="horizontal"
			android:layout_marginStart="8dp"
			android:minWidth="88dp"
			android:paddingStart="20dp"
			android:paddingEnd="20dp"
			android:visibility="invisible"
			android:focusable="true">
			<TextView
				android:id="@+id/textview11"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Cancel"
				android:textSize="12sp"
				android:textAppearance="?attr/textAppearanceLabelLarge"
				android:focusable="false" />
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
