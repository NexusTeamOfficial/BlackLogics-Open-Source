<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:fitsSystemWindows="true"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface"
	tools:context=".security.AiJiaMiEnterpriseActivity">
	<include layout="@layout/toolbar_improved" />
	<ScrollView
		android:id="@+id/vscroll2"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:paddingBottom="96dp"
		android:fillViewport="true"
		android:scrollbars="none"
		android:clipToPadding="false">
		<LinearLayout
			android:id="@+id/linear6"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="16dp"
			android:paddingBottom="16dp"
			android:orientation="vertical"
			android:paddingStart="16dp"
			android:paddingEnd="16dp">
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview3"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
				style="@style/Widget.Material3.CardView.Filled"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeWidth="0dp">
				<LinearLayout
					android:id="@+id/linear11"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="20dp"
					android:orientation="vertical">
					<com.google.android.material.materialswitch.MaterialSwitch
						android:id="@+id/sw_dex_protect"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="@string/enable_dex_protection"
						android:textSize="12sp"
						android:minHeight="48dp"
						android:textAppearance="?attr/textAppearanceTitleMedium" />
					<LinearLayout
						android:id="@+id/linear7"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:gravity="top"
						android:orientation="horizontal">
						<ImageView
							android:id="@+id/imageview3"
							android:layout_width="24dp"
							android:layout_height="24dp"
							android:src="@drawable/ic_lock_96"
							android:scaleType="fitCenter"
							android:layout_marginEnd="12dp"
							app:tint="?attr/colorOnSurfaceVariant"
							android:contentDescription="@null"
							android:focusable="false" />
						<TextView
							android:id="@+id/textview8"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:text="@string/aijiami_enterprise_desc"
							android:textSize="12sp"
							android:layout_weight="1"
							android:textAppearance="?attr/textAppearanceBodyMedium"
							android:lineSpacingExtra="2dp"
							android:focusable="false" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/textview9"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:paddingTop="12dp"
				android:paddingBottom="12dp"
				android:background="?attr/colorErrorContainer"
				android:gravity="center_vertical"
				android:text="@string/dex_protection_warning"
				android:textSize="12sp"
				android:paddingStart="16dp"
				android:paddingEnd="16dp"
				android:textAppearance="?attr/textAppearanceBodyMedium"
				android:drawableStart="@drawable/ic_warning_amber_rounded"
				android:drawablePadding="12dp"
				android:drawableTint="?attr/colorOnErrorContainer"
				android:focusable="false" />
			<TextView
				android:id="@+id/textview10"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:layout_marginBottom="8dp"
				android:text="@string/benefits"
				android:textSize="12sp"
				android:textAppearance="?attr/textAppearanceTitleMedium"
				android:focusable="false" />
			<TextView
				android:id="@+id/textview11"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/dex_protection_benefits"
				android:textSize="12sp"
				android:textAppearance="?attr/textAppearanceBodyMedium"
				android:lineSpacingExtra="2dp"
				android:focusable="false" />
			<TextView
				android:id="@+id/textview12"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:layout_marginBottom="8dp"
				android:text="@string/disadvantages"
				android:textSize="12sp"
				android:textAppearance="?attr/textAppearanceTitleMedium"
				android:focusable="false" />
			<TextView
				android:id="@+id/textview13"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/dex_protection_disadvantages"
				android:textSize="12sp"
				android:textAppearance="?attr/textAppearanceBodyMedium"
				android:lineSpacingExtra="2dp"
				android:focusable="false" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview4"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
				style="@style/Widget.Material3.CardView.Filled"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeWidth="0dp"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground">
				<LinearLayout
					android:id="@+id/linear8"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="12dp"
					android:paddingBottom="12dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:minHeight="64dp"
					android:paddingStart="20dp"
					android:paddingEnd="12dp">
					<TextView
						android:id="@+id/textview14"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:text="@string/encryption_configuration"
						android:textSize="12sp"
						android:layout_weight="1"
						android:textAppearance="?attr/textAppearanceTitleMedium"
						android:maxLines="1"
						android:ellipsize="end"
						android:focusable="false" />
					<ImageView
						android:id="@+id/imageview4"
						android:layout_width="48dp"
						android:layout_height="48dp"
						android:padding="12dp"
						android:background="?attr/selectableItemBackgroundBorderless"
						android:src="@drawable/ic_edit_white_48dp"
						android:scaleType="fitCenter"
						app:tint="?attr/colorPrimary"
						android:contentDescription="@string/encryption_configuration"
						android:focusable="true" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
