<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="?attr/colorSurface"
	android:padding="0dp">
	<LinearLayout
		android:id="@+id/base"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="12dp"
		android:background="?attr/selectableItemBackground"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:elevation="2dp">
		<LinearLayout
			android:id="@+id/baseIconUi"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="horizontal">
			<ImageView
				android:id="@+id/baseComponentIcon"
				android:layout_width="45dp"
				android:layout_height="45dp"
				android:src="@drawable/default_image"
				android:scaleType="center"
				android:focusable="false"
				android:visibility="gone" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/baseLayout"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:gravity="center_vertical"
			android:orientation="vertical"
			android:layout_weight="1"
			android:paddingStart="12dp">
			<TextView
				android:id="@+id/baseComponentName"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Intent"
				android:textSize="16sp"
				android:singleLine="true"
				android:focusable="false"
				android:ellipsize="end" />
			<TextView
				android:id="@+id/baseComponentSubName"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="intent"
				android:textSize="12sp"
				android:focusable="false" />
		</LinearLayout>
		<ImageView
			android:id="@+id/baseComponentMoreOptions"
			android:layout_width="28dp"
			android:layout_height="28dp"
			android:src="@drawable/icon_arrow_drop_down_sharp"
			android:scaleType="centerInside"
			android:layout_gravity="center_vertical"
			android:focusable="false"
			android:tint="?attr/colorOnSurface" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/baseOptions"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="8dp"
		android:orientation="horizontal" />
	<LinearLayout
		android:id="@+id/baseComponentDeleteUi"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="8dp"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="horizontal"
		android:visibility="gone">
		<ImageView
			android:id="@+id/baseDeleteIcon"
			android:layout_width="28dp"
			android:layout_height="28dp"
			android:src="@drawable/icon_delete_twotone"
			android:scaleType="centerInside"
			android:focusable="false"
			android:tint="?attr/colorError"
			android:layout_marginEnd="6dp" />
		<TextView
			android:id="@+id/baseDeleteText"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Delete Component"
			android:textSize="14sp"
			android:focusable="false" />
	</LinearLayout>
</LinearLayout>
