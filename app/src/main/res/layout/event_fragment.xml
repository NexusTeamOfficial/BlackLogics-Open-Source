<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_coordinator"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<LinearLayout
		android:fitsSystemWindows="true"
		android:id="@+id/linear1"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="?attr/colorSurface"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/mainContentLayout"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="horizontal">
			<com.nexusteam.blacklogics.custom.SideBarVertical
				android:id="@+id/sidebar"
				android:layout_width="80dp"
				android:layout_height="match_parent"
				android:background="?attr/colorSurface"
				app:iconSize="30dp"
				app:nexusShowDividers="false" />
			<View
				android:id="@+id/view8"
				android:layout_width="1dp"
				android:layout_height="match_parent"
				android:background="?attr/colorOutlineVariant" />
			<androidx.core.widget.NestedScrollView
				android:id="@+id/contentScrollView"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:fillViewport="true"
				android:scrollbars="vertical">
				<LinearLayout
					android:id="@+id/linear11"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="16dp"
					android:paddingBottom="88dp"
					android:orientation="vertical"
					android:paddingStart="16dp"
					android:paddingEnd="16dp"
					android:clipToPadding="false">
					<LinearLayout
						android:id="@+id/lifecycleEvents"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:visibility="visible">
						<com.google.android.material.card.MaterialCardView
							android:id="@+id/initializeLogicCard"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginBottom="24dp"
							app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
							style="@style/Widget.Material3.CardView.Filled"
							app:cardCornerRadius="16dp"
							app:cardElevation="0dp"
							app:strokeWidth="0dp">
							<LinearLayout
								android:id="@+id/linear5"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="vertical">
								<LinearLayout
									android:id="@+id/linear2"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:paddingTop="12dp"
									android:paddingBottom="12dp"
									android:background="?attr/selectableItemBackground"
									android:gravity="center_vertical"
									android:orientation="horizontal"
									android:minHeight="72dp"
									android:paddingStart="16dp"
									android:paddingEnd="16dp">
									<ImageView
										android:id="@+id/imageview1"
										android:layout_width="40dp"
										android:layout_height="40dp"
										android:padding="8dp"
										android:src="@drawable/widget_source"
										android:scaleType="fitCenter"
										android:importantForAccessibility="no" />
									<LinearLayout
										android:id="@+id/linear3"
										android:layout_width="0dp"
										android:layout_height="wrap_content"
										android:orientation="vertical"
										android:layout_weight="1"
										android:layout_marginStart="16dp">
										<TextView
											android:id="@+id/textview2"
											android:layout_width="wrap_content"
											android:layout_height="wrap_content"
											android:text="@string/initialize_logic"
											android:textSize="12sp"
											android:textAppearance="?attr/textAppearanceTitleMedium" />
										<TextView
											android:id="@+id/textview1"
											android:layout_width="wrap_content"
											android:layout_height="wrap_content"
											android:text="@string/on_activity_create"
											android:textSize="12sp"
											android:textAppearance="?attr/textAppearanceBodyMedium" />
									</LinearLayout>
									<ImageView
										android:id="@+id/arrowIcon"
										android:layout_width="40dp"
										android:layout_height="40dp"
										android:padding="8dp"
										android:src="@drawable/icon_arrow_drop_down_sharp"
										android:scaleType="fitCenter"
										android:tint="?attr/colorOnSurfaceVariant"
										android:importantForAccessibility="no" />
								</LinearLayout>
								<LinearLayout
									android:id="@+id/actionLayout"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:paddingBottom="8dp"
									android:orientation="horizontal"
									android:gravity="end"
									android:paddingStart="8dp"
									android:paddingEnd="8dp"
									android:visibility="gone">
									<LinearLayout
										android:id="@+id/removeLayout"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:background="?attr/selectableItemBackground"
										android:gravity="center_horizontal|center_vertical"
										android:orientation="horizontal"
										android:layout_weight="1"
										android:minHeight="48dp"
										android:paddingStart="12dp"
										android:paddingEnd="16dp"
										android:focusable="true">
										<ImageView
											android:id="@+id/imageview10"
											android:layout_width="20dp"
											android:layout_height="20dp"
											android:src="@drawable/ic_remove_24dp"
											android:scaleType="fitCenter"
											android:tint="?attr/colorPrimary"
											android:importantForAccessibility="no" />
										<TextView
											android:id="@+id/textview10"
											android:layout_width="wrap_content"
											android:layout_height="wrap_content"
											android:text="@string/remove"
											android:textSize="12sp"
											android:textAppearance="?attr/textAppearanceLabelLarge"
											android:layout_marginStart="8dp" />
									</LinearLayout>
									<LinearLayout
										android:id="@+id/deleteLayout"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:background="?attr/selectableItemBackground"
										android:gravity="center_horizontal|center_vertical"
										android:orientation="horizontal"
										android:layout_weight="1"
										android:minHeight="48dp"
										android:paddingStart="12dp"
										android:paddingEnd="16dp"
										android:focusable="true"
										android:visibility="gone">
										<ImageView
											android:id="@+id/imageview11"
											android:layout_width="20dp"
											android:layout_height="20dp"
											android:src="@drawable/icon_delete"
											android:scaleType="fitCenter"
											android:tint="?attr/colorError"
											android:importantForAccessibility="no" />
										<TextView
											android:id="@+id/textview11"
											android:layout_width="wrap_content"
											android:layout_height="wrap_content"
											android:text="@string/delete"
											android:textSize="12sp"
											android:textAppearance="?attr/textAppearanceLabelLarge"
											android:layout_marginStart="8dp" />
									</LinearLayout>
								</LinearLayout>
							</LinearLayout>
						</com.google.android.material.card.MaterialCardView>
						<TextView
							android:id="@+id/selectedEventsTitle"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginBottom="12dp"
							android:text="@string/selected_lifecycle_events"
							android:textSize="12sp"
							android:layout_marginStart="4dp"
							android:textAppearance="?attr/textAppearanceTitleMedium" />
						<androidx.recyclerview.widget.RecyclerView
							android:id="@+id/rvSelectedEvents"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginBottom="8dp"
							android:minHeight="100dp"
							android:nestedScrollingEnabled="false"
							android:visibility="visible" />
						<LinearLayout
							android:id="@+id/noEventsLayout"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="32dp"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="vertical"
							android:visibility="gone">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/noEventsIcon"
								android:layout_width="64dp"
								android:layout_height="64dp"
								android:layout_marginBottom="16dp"
								android:src="@drawable/default_image"
								android:alpha="0.5"
								android:importantForAccessibility="no"
								app:tint="?attr/colorOnSurfaceVariant" />
							<TextView
								android:id="@+id/noEventsText"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginBottom="4dp"
								android:gravity="center_horizontal|center_vertical"
								android:text="@string/no_lifecycle_events_selected"
								android:textSize="12sp"
								android:textAppearance="?attr/textAppearanceTitleMedium" />
							<TextView
								android:id="@+id/noEventsHint"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:gravity="center_horizontal|center_vertical"
								android:text="@string/tap_plus_to_add_lifecycle_events"
								android:textSize="12sp"
								android:textAppearance="?attr/textAppearanceBodyMedium" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/learnMoreSection"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="16dp"
							android:orientation="vertical">
							<TextView
								android:id="@+id/learnMoreBtn"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:background="?attr/selectableItemBackground"
								android:gravity="center_vertical"
								android:text="@string/learn_more_about_events"
								android:textSize="12sp"
								android:minHeight="48dp"
								android:paddingStart="12dp"
								android:paddingEnd="12dp"
								android:textAppearance="?attr/textAppearanceLabelLarge"
								android:drawablePadding="8dp"
								android:drawableEnd="@drawable/ic_expand_more"
								android:drawableTint="?attr/colorPrimary"
								android:focusable="true" />
							<com.google.android.material.card.MaterialCardView
								android:id="@+id/tipsCard"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginTop="8dp"
								app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
								style="@style/Widget.Material3.CardView.Filled"
								android:visibility="gone"
								app:cardCornerRadius="16dp"
								app:cardElevation="0dp"
								app:strokeWidth="0dp">
								<LinearLayout
									android:id="@+id/tipsLayout"
									android:layout_width="match_parent"
									android:layout_height="wrap_content"
									android:padding="16dp"
									android:orientation="vertical">
									<TextView
										android:id="@+id/tipsTitle"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:layout_marginBottom="12dp"
										android:text="@string/quick_event_tips"
										android:textSize="12sp"
										android:textAppearance="?attr/textAppearanceTitleMedium" />
									<TextView
										android:id="@+id/tip1"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:layout_marginBottom="12dp"
										android:text="@string/tip_lifecycle_events"
										android:textSize="12sp"
										android:textAppearance="?attr/textAppearanceBodyMedium" />
									<TextView
										android:id="@+id/tip2"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:layout_marginBottom="12dp"
										android:text="@string/tip_view_events"
										android:textSize="12sp"
										android:textAppearance="?attr/textAppearanceBodyMedium" />
									<TextView
										android:id="@+id/tip3"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:layout_marginBottom="12dp"
										android:text="@string/tip_moreblocks"
										android:textSize="12sp"
										android:textAppearance="?attr/textAppearanceBodyMedium" />
									<TextView
										android:id="@+id/tip4"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:text="@string/tip_chained_events"
										android:textSize="12sp"
										android:textAppearance="?attr/textAppearanceBodyMedium" />
								</LinearLayout>
							</com.google.android.material.card.MaterialCardView>
						</LinearLayout>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/viewLifeCycle"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:visibility="gone">
						<TextView
							android:id="@+id/viewsTitle"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginBottom="12dp"
							android:text="@string/view_events"
							android:textSize="12sp"
							android:layout_marginStart="4dp"
							android:textAppearance="?attr/textAppearanceTitleMedium" />
						<androidx.recyclerview.widget.RecyclerView
							android:id="@+id/viewsList"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:nestedScrollingEnabled="false"
							android:visibility="visible"
							tools:listitem="@layout/views_click_item" />
						<LinearLayout
							android:id="@+id/noViewsLayout"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="32dp"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="vertical"
							android:visibility="gone">
							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/noViewsIcon"
								android:layout_width="64dp"
								android:layout_height="64dp"
								android:layout_marginBottom="16dp"
								android:src="@drawable/default_image"
								android:alpha="0.5"
								android:importantForAccessibility="no"
								app:tint="?attr/colorOnSurfaceVariant" />
							<TextView
								android:id="@+id/noViewsText"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginBottom="4dp"
								android:gravity="center_horizontal|center_vertical"
								android:text="@string/no_views_yet"
								android:textSize="12sp"
								android:textAppearance="?attr/textAppearanceTitleMedium" />
							<TextView
								android:id="@+id/noViewsDescription"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:gravity="center_horizontal|center_vertical"
								android:text="@string/no_views_description"
								android:textSize="12sp"
								android:textAppearance="?attr/textAppearanceBodyMedium" />
						</LinearLayout>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/moreBlockLifeCycle"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:visibility="gone">
						<TextView
							android:id="@+id/functionsTitle"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginBottom="12dp"
							android:text="@string/moreblocks"
							android:textSize="12sp"
							android:layout_marginStart="4dp"
							android:textAppearance="?attr/textAppearanceTitleMedium" />
						<LinearLayout
							android:id="@+id/linear12"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical">
							<androidx.recyclerview.widget.RecyclerView
								android:id="@+id/functionsList"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:nestedScrollingEnabled="false"
								android:visibility="visible"
								tools:listitem="@layout/cus_item_functions" />
							<LinearLayout
								android:id="@+id/noFunctionsLayout"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:padding="32dp"
								android:gravity="center_horizontal|center_vertical"
								android:orientation="vertical"
								android:visibility="gone">
								<com.google.android.material.imageview.ShapeableImageView
									android:id="@+id/noFunctionsIcon"
									android:layout_width="64dp"
									android:layout_height="64dp"
									android:layout_marginBottom="16dp"
									android:src="@drawable/block"
									android:alpha="0.5"
									android:importantForAccessibility="no"
									app:tint="?attr/colorOnSurfaceVariant" />
								<TextView
									android:id="@+id/noFunctionsText"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginBottom="4dp"
									android:gravity="center_horizontal|center_vertical"
									android:text="@string/no_moreblocks_yet"
									android:textSize="12sp"
									android:textAppearance="?attr/textAppearanceTitleMedium" />
								<TextView
									android:id="@+id/noFunctionsDescription"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:gravity="center_horizontal|center_vertical"
									android:text="@string/no_moreblocks_description"
									android:textSize="12sp"
									android:textAppearance="?attr/textAppearanceBodyMedium" />
							</LinearLayout>
						</LinearLayout>
					</LinearLayout>
					<com.nexusteam.blacklogics.widget.AdLayout
						android:id="@+id/adLayout"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						app:bannerAdUnitId="ca-app-pub-2903137488772866/3754424748"
						app:interstitialAdUnitId="ca-app-pub-2903137488772866/3754424748" />
				</LinearLayout>
			</androidx.core.widget.NestedScrollView>
		</LinearLayout>
	</LinearLayout>
	<com.google.android.material.floatingactionbutton.FloatingActionButton
		android:id="@+id/_fab"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_margin="16dp"
		android:layout_gravity="right|bottom"
		app:srcCompat="@drawable/ic_add_black" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
