<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="?attr/colorPrimary"
	android:gravity="center_vertical"
	android:orientation="horizontal"
	android:paddingStart="10dp"
	android:paddingTop="8dp"
	android:paddingEnd="4dp"
	android:paddingBottom="8dp"
	android:elevation="4dp">
	<ImageView
		android:id="@+id/ig_toolbar_back"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:padding="8dp"
		android:src="@drawable/arrow_back_white_48dp"
		android:scaleType="centerInside"
		android:focusable="false" />
	<TextView
		android:id="@+id/tx_toolbar_title"
		android:layout_width="0dp"
		android:layout_height="match_parent"
		android:paddingTop="4dp"
		android:paddingBottom="6dp"
		android:text="Title"
		android:textSize="16sp"
		android:textStyle="bold"
		android:textColor="#000000"
		android:layout_weight="1"
		android:gravity="center_vertical|start"
		android:paddingStart="10dp"
		android:paddingEnd="8dp"
		android:focusable="false" />
	<ImageView
		android:id="@+id/ig_toolbar_refactor"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:padding="9dp"
		android:src="@drawable/ic_refactor"
		android:scaleType="center"
		android:focusable="false"
		android:visibility="gone"
		android:tooltipText="RefactorPackage" />
	<ImageView
		android:id="@+id/ig_toolbar_load_file"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:padding="9dp"
		android:src="@drawable/add_file_48"
		android:scaleType="centerInside"
		android:focusable="false"
		android:visibility="gone" />
</LinearLayout>
