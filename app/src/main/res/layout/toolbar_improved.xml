<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:fitsSystemWindows="true"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="?attr/colorSurface"
	android:gravity="center_vertical"
	android:orientation="horizontal"
	android:minHeight="64dp"
	android:paddingStart="4dp"
	android:paddingEnd="4dp"
	android:elevation="0dp">
	<ImageView
		android:id="@+id/ig_toolbar_back"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:padding="12dp"
		android:background="?attr/selectableItemBackgroundBorderless"
		android:src="@drawable/arrow_back_white_48dp"
		android:scaleType="fitCenter"
		android:contentDescription="Back"
		android:focusable="false"
		app:tint="?attr/colorOnSurface" />
	<TextView
		android:id="@+id/tx_toolbar_title"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:text="Title"
		android:textSize="12sp"
		android:layout_weight="1"
		android:gravity="center_vertical|start"
		android:paddingStart="8dp"
		android:paddingEnd="8dp"
		android:textAppearance="?attr/textAppearanceTitleLarge"
		android:maxLines="1"
		android:ellipsize="end"
		android:focusable="false" />
	<ImageView
		android:id="@+id/ig_toolbar_refactor"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:padding="12dp"
		android:background="?attr/selectableItemBackgroundBorderless"
		android:src="@drawable/ic_refactor"
		android:scaleType="fitCenter"
		android:contentDescription="Refactorpackage"
		android:tooltipText="RefactorPackage"
		android:focusable="false"
		android:visibility="gone"
		app:tint="?attr/colorOnSurfaceVariant" />
	<ImageView
		android:id="@+id/ig_toolbar_load_file"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:padding="12dp"
		android:background="?attr/selectableItemBackgroundBorderless"
		android:src="@drawable/add_file_48"
		android:scaleType="fitCenter"
		android:contentDescription="Addfile"
		android:focusable="false"
		android:visibility="gone"
		app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
