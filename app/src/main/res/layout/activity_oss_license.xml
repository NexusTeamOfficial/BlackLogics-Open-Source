<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:fitsSystemWindows="true"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="?attr/colorSurface">
	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:background="?attr/colorSurface"
		android:layout_height="?attr/actionBarSize"
		app:title="@string/opensource_licenses"
		app:titleTextAppearance="?attr/textAppearanceTitleLarge"
		app:titleTextColor="?attr/colorOnSurface"
		app:navigationIcon="@drawable/icon_arrow_back_round"
		app:navigationIconTint="?attr/colorOnSurface" />
	<View
		android:id="@+id/view22"
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="?attr/colorOutlineVariant" />
	<androidx.core.widget.NestedScrollView
		android:id="@+id/vscroll4"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:fillViewport="true"
		android:overScrollMode="never"
		android:scrollbars="none"
		android:clipToPadding="false">
		<LinearLayout
			android:id="@+id/linear23"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear24"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="24dp"
				android:paddingBottom="24dp"
				android:background="?attr/colorPrimaryContainer"
				android:orientation="vertical"
				android:paddingStart="20dp"
				android:paddingEnd="20dp">
				<LinearLayout
					android:id="@+id/linear25"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview7"
						android:layout_width="52dp"
						android:layout_height="52dp"
						app:cardBackgroundColor="?attr/colorPrimary"
						style="@style/Widget.Material3.CardView.Filled"
						app:cardCornerRadius="16dp"
						app:cardElevation="0dp"
						app:strokeWidth="0dp">
						<TextView
							android:id="@+id/textview25"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:gravity="center_horizontal|center_vertical"
							android:text="@string/lightning_emoji"
							android:textSize="24sp"
							android:focusable="false" />
					</com.google.android.material.card.MaterialCardView>
					<LinearLayout
						android:id="@+id/linear26"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1"
						android:layout_marginStart="14dp">
						<TextView
							android:id="@+id/textview26"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="@string/blacklogics"
							android:textSize="12sp"
							android:textAppearance="?attr/textAppearanceTitleLarge"
							android:maxLines="1"
							android:ellipsize="end"
							android:focusable="false" />
						<TextView
							android:id="@+id/textview27"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="2dp"
							android:text="@string/nexusteam_smart_india_gaming"
							android:textSize="12sp"
							android:textAppearance="?attr/textAppearanceBodySmall"
							android:alpha="0.75"
							android:maxLines="1"
							android:ellipsize="end"
							android:focusable="false" />
					</LinearLayout>
					<com.google.android.material.chip.Chip
						android:id="@+id/chip27"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:clickable="false"
						android:focusable="false"
						style="@style/Widget.Material3.Chip.Assist"
						app:chipBackgroundColor="?attr/colorPrimary"
						app:chipStrokeWidth="0dp"
						app:chipIconTint="?attr/colorOnPrimary" />
				</LinearLayout>
				<TextView
					android:id="@+id/textview28"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="20dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="@string/copyright_nexusteam"
					android:textSize="12sp"
					android:textAppearance="?attr/textAppearanceLabelLarge"
					android:focusable="false" />
				<TextView
					android:id="@+id/textview29"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="@string/blacklogics_license_desc"
					android:textSize="12sp"
					android:textAppearance="?attr/textAppearanceBodySmall"
					android:alpha="0.85"
					android:lineSpacingMultiplier="1.4"
					android:focusable="false" />
			</LinearLayout>
			<TextView
				android:id="@+id/textview30"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="24dp"
				android:paddingBottom="8dp"
				android:text="@string/third_party_open_source_components"
				android:textSize="12sp"
				android:paddingStart="20dp"
				android:paddingEnd="20dp"
				android:textAppearance="?attr/textAppearanceTitleSmall"
				android:letterSpacing="0.1"
				android:focusable="false" />
			<LinearLayout
				android:id="@+id/ll_licenses_container"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingBottom="8dp"
				android:orientation="vertical"
				android:paddingStart="12dp"
				android:paddingEnd="12dp" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview8"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="28dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
				android:layout_marginStart="12dp"
				android:layout_marginEnd="12dp"
				style="@style/Widget.Material3.CardView.Filled"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeWidth="0dp">
				<LinearLayout
					android:id="@+id/linear28"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="20dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview31"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="@string/license_compliance"
						android:textSize="12sp"
						android:textAppearance="?attr/textAppearanceTitleMedium"
						android:focusable="false" />
					<TextView
						android:id="@+id/textview32"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="6dp"
						android:text="@string/license_compliance_desc"
						android:textSize="12sp"
						android:textAppearance="?attr/textAppearanceBodySmall"
						android:lineSpacingMultiplier="1.4"
						android:focusable="false" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</LinearLayout>
