<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:padding="0dp">
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview2"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:cardBackgroundColor="?attr/colorSurface"
		app:cardCornerRadius="16dp"
		app:cardElevation="4dp">
		<LinearLayout
			android:id="@+id/linear3"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/lin_header"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="2dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<ImageView
					android:id="@+id/img_edit_id"
					android:layout_width="24dp"
					android:layout_height="24dp"
					android:src="@drawable/ic_edit_black"
					android:scaleType="center"
					android:focusable="false"
					android:layout_marginEnd="4dp" />
				<ImageView
					android:id="@+id/img_common_attributes"
					android:layout_width="24dp"
					android:layout_height="24dp"
					android:src="@drawable/dimention"
					android:scaleType="centerInside"
					android:focusable="false"
					android:layout_marginEnd="4dp" />
				<ImageView
					android:id="@+id/img_custom"
					android:layout_width="0dp"
					android:layout_height="0dp"
					android:src="@drawable/ic_add_black"
					android:scaleType="center"
					android:focusable="false" />
				<com.nexusteam.blacklogics.custom.ViewItems
					android:id="@+id/viewItems"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_margin="2dp"
					android:padding="4dp"
					android:orientation="horizontal" />
			</LinearLayout>
			<View
				android:id="@+id/lin_divider"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:background="?attr/colorOutline" />
			<com.google.android.material.tabs.TabLayout
				android:id="@+id/attributesOrListener"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:background="?attr/colorSecondary"
				app:tabGravity="fill"
				app:tabMode="fixed"
				app:tabIndicatorHeight="2dp"
				app:tabIndicatorColor="@android:color/white"
				app:tabSelectedTextColor="@android:color/white"
				app:tabTextColor="@android:color/white"
				app:tabTextAppearance="@android:style/TextAppearance.Widget.TabWidget" />
			<LinearLayout
				android:id="@+id/linear1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="4dp"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/attributesTab"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical">
					<androidx.recyclerview.widget.RecyclerView
						android:id="@+id/rv_attributes"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:paddingTop="2dp"
						android:paddingBottom="2dp"
						android:overScrollMode="never" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/eventTab"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:visibility="gone">
					<androidx.recyclerview.widget.RecyclerView
						android:id="@+id/listeners"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:paddingTop="2dp"
						android:paddingBottom="2dp" />
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
