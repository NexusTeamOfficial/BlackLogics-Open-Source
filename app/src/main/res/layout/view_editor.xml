<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:fitsSystemWindows="true"
	android:id="@+id/root_layout"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<LinearLayout
		android:id="@+id/lin_toolbar"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:background="?attr/colorSurface"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingStart="4dp"
		android:paddingEnd="4dp"
		android:elevation="0dp"
		android:layout_alignParentTop="true">
		<ImageView
			android:id="@+id/img_views"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:padding="12dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:src="@drawable/ic_view_headline_black"
			android:scaleType="fitCenter"
			app:tint="?attr/colorOnSurface"
			android:contentDescription="@null"
			android:focusable="true" />
		<ImageView
			android:id="@+id/img_import"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:padding="12dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:src="@drawable/ic_get_app_black"
			android:scaleType="fitCenter"
			app:tint="?attr/colorOnSurface"
			android:contentDescription="@null"
			android:focusable="true" />
		<ImageView
			android:id="@+id/img_copy"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:padding="12dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:src="@drawable/ic_content_copy_black"
			android:scaleType="fitCenter"
			app:tint="?attr/colorOnSurface"
			android:contentDescription="@null"
			android:focusable="true" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/linear7"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="horizontal"
		android:layout_below="@id/lin_toolbar">
		<LinearLayout
			android:id="@+id/linear8"
			android:layout_width="120dp"
			android:layout_height="match_parent"
			android:background="?attr/colorSurface"
			android:orientation="vertical"
			android:elevation="0dp">
			<com.nexusteam.blacklogics.custom.NavBar
				android:id="@+id/customNav"
				android:layout_width="match_parent"
				android:layout_height="40dp"
				android:background="?attr/colorSurface"
				app:active_color="?attr/colorPrimary"
				app:inactive_color="?attr/colorOnSurfaceVariant" />
			<LinearLayout
				android:id="@+id/linear19"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="horizontal">
				<LinearLayout
					android:id="@+id/widgetPalette"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:orientation="vertical">
					<ImageView
						android:id="@+id/img_add_view"
						android:layout_width="48dp"
						android:layout_height="48dp"
						android:layout_margin="6dp"
						android:padding="12dp"
						android:background="?attr/selectableItemBackgroundBorderless"
						android:src="@drawable/ic_add_black"
						android:scaleType="fitCenter"
						android:layout_gravity="center_horizontal"
						app:tint="?attr/colorPrimary"
						android:focusable="true" />
					<androidx.recyclerview.widget.RecyclerView
						android:id="@+id/listview_widgets"
						android:layout_width="match_parent"
						android:layout_height="0dp"
						android:paddingTop="2dp"
						android:paddingBottom="24dp"
						android:layout_weight="1"
						android:paddingStart="4dp"
						android:paddingEnd="4dp"
						android:clipToPadding="false"
						android:overScrollMode="never"
						android:nestedScrollingEnabled="true"
						tools:listitem="@layout/views_item" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/collectionPalette"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:orientation="vertical"
					android:visibility="gone">
					<androidx.recyclerview.widget.RecyclerView
						android:id="@+id/collection_list"
						android:layout_width="match_parent"
						android:layout_height="0dp"
						android:padding="4dp"
						android:layout_weight="1"
						android:clipToPadding="false"
						tools:listitem="@layout/views_item" />
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
		<View
			android:id="@+id/view9"
			android:layout_width="1dp"
			android:layout_height="match_parent"
			android:background="?attr/colorOutlineVariant" />
		<LinearLayout
			android:id="@+id/linear10"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:orientation="vertical"
			android:layout_weight="1">
			<LinearLayout
				android:id="@+id/linear13"
				android:layout_width="match_parent"
				android:layout_height="24dp"
				android:background="#303F9F"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingStart="8dp"
				android:paddingEnd="8dp">
				<TextView
					android:id="@+id/tv_view_name"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="2dp"
					android:paddingBottom="2dp"
					android:textSize="11sp"
					android:textColor="#000000"
					android:layout_weight="1"
					android:paddingStart="6dp"
					android:paddingEnd="6dp"
					android:maxLines="1"
					android:ellipsize="end"
					android:focusable="false" />
				<TextView
					android:id="@+id/textview5"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="10:44"
					android:textSize="12sp"
					android:textColor="#FFFFFF"
					android:fontFamily="sans-serif-medium"
					android:maxLines="1"
					android:focusable="false" />
				<LinearLayout
					android:id="@+id/linear14"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<ImageView
						android:id="@+id/imageview4"
						android:layout_width="14dp"
						android:layout_height="14dp"
						android:src="@drawable/ic_signal_wifi_statusbar_4_bar_white"
						android:scaleType="fitCenter"
						android:contentDescription="@null"
						android:focusable="false" />
					<ImageView
						android:id="@+id/imageview5"
						android:layout_width="14dp"
						android:layout_height="14dp"
						android:src="@drawable/ic_signal_cellular_4_bar_white"
						android:scaleType="fitCenter"
						android:layout_marginStart="2dp"
						android:contentDescription="@null"
						android:focusable="false" />
					<ImageView
						android:id="@+id/imageview6"
						android:layout_width="14dp"
						android:layout_height="14dp"
						android:src="@drawable/ic_battery_full_white"
						android:scaleType="fitCenter"
						android:layout_marginStart="2dp"
						android:contentDescription="@null"
						android:focusable="false" />
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/phone_action_bar"
				android:layout_width="match_parent"
				android:layout_height="40dp"
				android:background="#3F51B5"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingStart="16dp"
				android:paddingEnd="16dp"
				android:elevation="4dp">
				<TextView
					android:id="@+id/textview6"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/app_editor_toolbar_title"
					android:textSize="15sp"
					android:textColor="#FFFFFF"
					android:fontFamily="sans-serif-medium"
					android:maxLines="1"
					android:ellipsize="end"
					android:focusable="false" />
			</LinearLayout>
			<FrameLayout
				android:id="@+id/editorCanvasFrame"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1">
				<LinearLayout
					android:id="@+id/editorCanvasViewport"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:orientation="vertical"
					android:clipChildren="true">
					<LinearLayout
						android:id="@+id/editorLayout"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="#EEEEEE"
						android:orientation="vertical" />
				</LinearLayout>
				<TextView
					android:id="@+id/tv_canvas_empty"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="24dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="@string/canvas_empty"
					android:textSize="12sp"
					android:clickable="false"
					android:layout_gravity="center_horizontal|center_vertical"
					android:textAppearance="?attr/textAppearanceBodyMedium"
					android:alpha="0"
					android:visibility="gone"
					android:focusable="false"
					android:importantForAccessibility="no" />
			</FrameLayout>
		</LinearLayout>
	</LinearLayout>
</RelativeLayout>
