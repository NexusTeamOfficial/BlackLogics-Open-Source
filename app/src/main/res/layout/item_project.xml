<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:fitsSystemWindows="true"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingHorizontal="12dp"
	android:paddingVertical="6dp">
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview2"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:contentPadding="16dp"
		app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
		style="@style/Widget.Material3.CardView.Filled"
		app:cardCornerRadius="20dp"
		app:cardElevation="0dp"
		app:strokeWidth="0dp">
		<LinearLayout
			android:id="@+id/linear2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear4"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<com.google.android.material.imageview.ShapeableImageView
					android:id="@+id/app_icon"
					android:layout_width="52dp"
					android:layout_height="52dp"
					android:src="@mipmap/ic_launcher"
					android:focusable="false"
					app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />
				<LinearLayout
					android:id="@+id/linear5"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:layout_weight="1"
					android:paddingStart="14dp"
					android:paddingEnd="8dp">
					<TextView
						android:id="@+id/app_name"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="LinearColorPicker"
						android:textSize="12sp"
						android:textAppearance="?attr/textAppearanceTitleMedium"
						android:maxLines="1"
						android:ellipsize="end"
						android:focusable="false" />
					<TextView
						android:id="@+id/app_version_version_code"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="ColorPicker - 1.0 (1)"
						android:textSize="12sp"
						android:textAppearance="?attr/textAppearanceBodyMedium"
						android:focusable="false" />
					<TextView
						android:id="@+id/package_name"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="com.nexusteam.color.os.colorpicker"
						android:textSize="12sp"
						android:textAppearance="?attr/textAppearanceBodySmall"
						android:alpha="0.7"
						android:maxLines="1"
						android:ellipsize="middle"
						android:focusable="false" />
				</LinearLayout>
				<TextView
					android:id="@+id/project_id"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:background="@drawable/bg_id_badge"
					android:text="682"
					android:textSize="12sp"
					android:paddingHorizontal="10dp"
					android:paddingVertical="4dp"
					android:textAppearance="?attr/textAppearanceLabelMedium"
					android:focusable="false" />
				<ImageView
					android:id="@+id/btn_expand"
					android:layout_width="24dp"
					android:layout_height="24dp"
					android:src="@drawable/ic_expand_more"
					android:scaleType="fitCenter"
					android:layout_marginStart="8dp"
					android:contentDescription="Expand"
					android:focusable="false"
					app:tint="?attr/colorOnSurfaceVariant" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/expanded_content"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:orientation="horizontal"
				android:visibility="gone">
				<ImageView
					android:id="@+id/btn_edit"
					android:layout_width="0dp"
					android:layout_height="44dp"
					android:padding="10dp"
					android:background="?attr/selectableItemBackgroundBorderless"
					android:src="@drawable/ic_edit"
					android:scaleType="fitCenter"
					android:layout_weight="1"
					android:contentDescription="Edit"
					android:focusable="false" />
				<ImageView
					android:id="@+id/btn_backup"
					android:layout_width="0dp"
					android:layout_height="44dp"
					android:padding="10dp"
					android:background="?attr/selectableItemBackgroundBorderless"
					android:src="@drawable/ic_backup"
					android:scaleType="fitCenter"
					android:layout_weight="1"
					android:contentDescription="Backup"
					android:focusable="false" />
				<ImageView
					android:id="@+id/export_project"
					android:layout_width="0dp"
					android:layout_height="44dp"
					android:padding="10dp"
					android:background="?attr/selectableItemBackgroundBorderless"
					android:src="@drawable/export_project_512_by_512"
					android:scaleType="fitCenter"
					android:layout_weight="1"
					android:contentDescription="Export"
					android:focusable="false" />
				<ImageView
					android:id="@+id/btn_delete"
					android:layout_width="0dp"
					android:layout_height="44dp"
					android:padding="10dp"
					android:background="?attr/selectableItemBackgroundBorderless"
					android:src="@drawable/ic_delete"
					android:scaleType="fitCenter"
					android:layout_weight="1"
					android:contentDescription="Delete"
					android:focusable="false" />
				<ImageView
					android:id="@+id/configLayout"
					android:layout_width="0dp"
					android:layout_height="44dp"
					android:padding="10dp"
					android:background="?attr/selectableItemBackgroundBorderless"
					android:src="@drawable/icon_settings_round_blue"
					android:scaleType="fitCenter"
					android:layout_weight="1"
					android:contentDescription="Config"
					android:focusable="false" />
			</LinearLayout>
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
