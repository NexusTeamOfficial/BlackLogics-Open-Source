<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    android:fitsSystemWindows="true" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/layout_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_main"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include layout="@layout/toolbar"/>
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_layout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    />
                <com.nexusteam.blacklogics.custom.CustomViewPager
                    android:id="@+id/viewpager"
                    android:background="?attr/colorOnPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <View
                    android:background="@color/backgroundColor"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/layout_btn_group"
                    android:background="@color/backgroundColor"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="44dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/img_orientation"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_screen_portrait_grey600_24dp"
                            android:scaleType="fitXY"/>
                        <com.nexusteam.internal.editor.view.ProjectFileSelector
                            android:id="@+id/file_selector"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"/>
                    </LinearLayout>
                    <Button
                        android:theme="@style/AppTheme.Button.LightBlue"
                        android:textSize="@dimen/text_size_button_material"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"
                        android:id="@+id/btn_execute"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"/>
                </LinearLayout>
            </LinearLayout>
            <com.nexusteam.internal.editor.view.ViewProperty
                android:id="@+id/view_property"
                android:layout_width="match_parent"
                android:layout_height="156dp"
                android:layout_alignParentBottom="true"
                android:translationY="156dp"/>
        </RelativeLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <com.nexusteam.blacklogics.design.DesignDrawer
        android:layout_gravity="end"
        android:id="@+id/right_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
</androidx.drawerlayout.widget.DrawerLayout>
