<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:fitsSystemWindows="true"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="?attr/colorSurface">
	<include layout="@layout/toolbar_improved" />
	<ScrollView
		android:id="@+id/vscroll2"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:paddingBottom="96dp"
		android:fillViewport="true"
		android:scrollbars="none"
		android:clipToPadding="false">
		<LinearLayout
			android:id="@+id/linear1"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="16dp"
			android:paddingBottom="16dp"
			android:orientation="vertical"
			android:paddingStart="16dp"
			android:paddingEnd="16dp">
			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/textinputlayout8"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:layout_marginBottom="8dp"
				style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/appName"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:textSize="12sp"
					android:inputType="textCapWords"
					android:textAppearance="?attr/textAppearanceBodyLarge"
					android:maxLines="1" />
			</com.google.android.material.textfield.TextInputLayout>
			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/textinputlayout9"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:layout_marginBottom="8dp"
				style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/pkgName"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:textSize="12sp"
					android:inputType="textNoSuggestions"
					android:textAppearance="?attr/textAppearanceBodyLarge"
					android:maxLines="1" />
			</com.google.android.material.textfield.TextInputLayout>
			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/textinputlayout10"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:layout_marginBottom="8dp"
				style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/edittext3"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:textSize="12sp"
					android:inputType="number"
					android:textAppearance="?attr/textAppearanceBodyLarge"
					android:maxLines="1" />
			</com.google.android.material.textfield.TextInputLayout>
			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/textinputlayout11"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:layout_marginBottom="8dp"
				style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/edittext4"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:textSize="12sp"
					android:textAppearance="?attr/textAppearanceBodyLarge"
					android:maxLines="1" />
			</com.google.android.material.textfield.TextInputLayout>
			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/textinputlayout12"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:layout_marginBottom="8dp"
				style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/edittext5"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:textSize="12sp"
					android:inputType="textUri"
					android:textAppearance="?attr/textAppearanceBodyMedium"
					android:maxLines="1" />
			</com.google.android.material.textfield.TextInputLayout>
			<TextView
				android:id="@+id/textview2"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:layout_marginBottom="8dp"
				android:text="@string/developer_options"
				android:textSize="12sp"
				android:textAppearance="?attr/textAppearanceTitleMedium"
				android:focusable="false" />
			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switch_splash"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="4dp"
				android:text="@string/enable_splash_screen"
				android:textSize="12sp"
				android:minHeight="48dp"
				android:textAppearance="?attr/textAppearanceBodyLarge" />
			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/textinputlayout13"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:layout_marginBottom="8dp"
				style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">
				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/minSdkInput"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:textSize="12sp"
					android:inputType="number"
					android:textAppearance="?attr/textAppearanceBodyMedium"
					android:maxLines="1" />
			</com.google.android.material.textfield.TextInputLayout>
			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/textinputlayout14"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:layout_marginBottom="8dp"
				style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">
				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/targetSdkInput"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:textSize="12sp"
					android:inputType="number"
					android:textAppearance="?attr/textAppearanceBodyMedium"
					android:maxLines="1" />
			</com.google.android.material.textfield.TextInputLayout>
			<TextView
				android:id="@+id/textview3"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:layout_marginBottom="8dp"
				android:text="@string/additional_options"
				android:textSize="12sp"
				android:textAppearance="?attr/textAppearanceTitleMedium"
				android:focusable="false" />
			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switch_debuggable"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="4dp"
				android:text="@string/debuggable"
				android:textSize="12sp"
				android:minHeight="48dp"
				android:textAppearance="?attr/textAppearanceBodyLarge" />
			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switch_proguard"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="4dp"
				android:text="@string/enable_proguard"
				android:textSize="12sp"
				android:minHeight="48dp"
				android:textAppearance="?attr/textAppearanceBodyLarge" />
			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switch_cleartext"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="4dp"
				android:text="@string/allow_cleartext"
				android:textSize="12sp"
				android:minHeight="48dp"
				android:textAppearance="?attr/textAppearanceBodyLarge" />
			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerview1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:nestedScrollingEnabled="false"
				android:clipToPadding="false" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_build_apk"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="24dp"
				android:text="@string/build_apk"
				android:textSize="12sp"
				style="@style/Widget.Material3.Button"
				app:icon="@drawable/ic_build"
				app:iconPadding="8dp"
				app:iconGravity="textStart"
				app:cornerRadius="20dp" />
			<com.nexusteam.blacklogics.widget.AdLayout
				android:id="@+id/adLayout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				app:bannerAdUnitId="ca-app-pub-2903137488772866/3754424748"
				app:interstitialAdUnitId="ca-app-pub-2903137488772866/3754424748" />
		</LinearLayout>
	</ScrollView>
</LinearLayout>
