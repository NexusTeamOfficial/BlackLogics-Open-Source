<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:fitsSystemWindows="true"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface"
	tools:context="AppSettings">
	<include
		layout="@layout/toolbar_improved"
		android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_alignParentTop="true" />
	<ScrollView
		android:id="@+id/scrollView"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:paddingTop="16dp"
		android:paddingBottom="96dp"
		android:paddingStart="16dp"
		android:paddingEnd="16dp"
		android:clipToPadding="false"
		android:fillViewport="true"
		android:scrollbars="none"
		android:layout_below="@id/toolbar"
		android:layout_alignParentBottom="true">
		<RelativeLayout
			android:id="@+id/relativelayout97"
			android:layout_width="match_parent"
			android:layout_height="wrap_content">
			<RelativeLayout
				android:id="@+id/headerLayout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="24dp"
				android:layout_alignParentTop="true">
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardview6"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginBottom="12dp"
					app:contentPadding="16dp"
					app:cardBackgroundColor="?attr/colorPrimaryContainer"
					style="@style/Widget.Material3.CardView.Filled"
					app:cardCornerRadius="28dp"
					app:cardElevation="0dp"
					app:strokeWidth="0dp"
					android:layout_centerHorizontal="true">
					<ImageView
						android:id="@+id/imageview1"
						android:layout_width="64dp"
						android:layout_height="64dp"
						android:src="@drawable/app_icon"
						android:scaleType="fitCenter"
						android:contentDescription="@null"
						android:importantForAccessibility="no" />
				</com.google.android.material.card.MaterialCardView>
				<TextView
					android:id="@+id/textview1"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginBottom="4dp"
					android:text="@string/app_name"
					android:textSize="12sp"
					android:textAppearance="?attr/textAppearanceHeadlineSmall"
					android:maxLines="1"
					android:ellipsize="end"
					android:focusable="false"
					android:layout_below="@id/cardview6"
					android:layout_centerHorizontal="true" />
				<TextView
					android:id="@+id/textViewVersion"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="0.0.5 alpha5 (1459)"
					android:textSize="12sp"
					android:textAppearance="?attr/textAppearanceBodyMedium"
					android:maxLines="1"
					android:ellipsize="end"
					android:focusable="false"
					android:layout_below="@id/textview1"
					android:layout_centerHorizontal="true" />
			</RelativeLayout>
			<LinearLayout
				android:id="@+id/buttonLayout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="24dp"
				android:orientation="horizontal"
				android:layout_below="@id/headerLayout">
				<com.google.android.material.button.MaterialButton
					android:id="@+id/materialbutton1"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:text="@string/app_reset_settings"
					android:textSize="12sp"
					android:layout_weight="1"
					android:layout_marginEnd="8dp"
					style="@style/Widget.Material3.Button"
					app:icon="@drawable/ic_reset"
					app:iconGravity="textStart"
					app:cornerRadius="12dp" />
				<com.google.android.material.button.MaterialButton
					android:id="@+id/materialbutton2"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:text="@string/app_check_update_title"
					android:textSize="12sp"
					android:layout_weight="1"
					android:layout_marginStart="8dp"
					style="@style/Widget.Material3.Button.OutlinedButton"
					app:icon="@drawable/ic_update"
					app:iconGravity="textStart"
					app:cornerRadius="12dp" />
			</LinearLayout>
			<TextView
				android:id="@+id/settingsHeader"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="8dp"
				android:text="@string/settings_title"
				android:textSize="12sp"
				android:layout_marginStart="4dp"
				android:textAppearance="?attr/textAppearanceTitleMedium"
				android:visibility="gone"
				android:focusable="false"
				tools:visibility="visible"
				android:layout_below="@id/buttonLayout" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="8dp"
				app:contentPadding="20dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
				style="@style/Widget.Material3.CardView.Filled"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeWidth="0dp"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground"
				android:layout_below="@id/buttonLayout">
				<RelativeLayout
					android:id="@+id/relativelayout98"
					android:layout_width="match_parent"
					android:layout_height="wrap_content">
					<TextView
						android:id="@+id/textview3"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/app_docs_title"
						android:textSize="12sp"
						android:textAppearance="?attr/textAppearanceTitleMedium"
						android:maxLines="1"
						android:ellipsize="end"
						android:focusable="false"
						android:layout_alignParentTop="true"
						android:layout_alignParentStart="true" />
					<TextView
						android:id="@+id/textview4"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:text="@string/common_word_unavailable"
						android:textSize="12sp"
						android:textAppearance="?attr/textAppearanceBodyMedium"
						android:maxLines="2"
						android:ellipsize="end"
						android:focusable="false"
						android:layout_below="@id/textview3"
						android:layout_alignParentStart="true" />
				</RelativeLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview2"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="8dp"
				app:contentPadding="20dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
				style="@style/Widget.Material3.CardView.Filled"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeWidth="0dp"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground"
				android:layout_below="@id/cardview1">
				<RelativeLayout
					android:id="@+id/relativelayout99"
					android:layout_width="match_parent"
					android:layout_height="wrap_content">
					<TextView
						android:id="@+id/textview5"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/app_suggest_idea_title"
						android:textSize="12sp"
						android:textAppearance="?attr/textAppearanceTitleMedium"
						android:maxLines="1"
						android:ellipsize="end"
						android:focusable="false"
						android:layout_alignParentTop="true"
						android:layout_alignParentStart="true" />
					<TextView
						android:id="@+id/textview6"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:text="@string/common_word_unavailable"
						android:textSize="12sp"
						android:textAppearance="?attr/textAppearanceBodyMedium"
						android:maxLines="2"
						android:ellipsize="end"
						android:focusable="false"
						android:layout_below="@id/textview5"
						android:layout_alignParentStart="true" />
				</RelativeLayout>
			</com.google.android.material.card.MaterialCardView>
			<View
				android:id="@+id/divider1"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:layout_marginTop="12dp"
				android:layout_marginBottom="12dp"
				android:background="?attr/colorOutlineVariant"
				android:layout_below="@id/cardview2" />
			<TextView
				android:id="@+id/communityHeader"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="8dp"
				android:text="@string/community_title"
				android:textSize="12sp"
				android:layout_marginStart="4dp"
				android:textAppearance="?attr/textAppearanceTitleMedium"
				android:focusable="false"
				android:layout_below="@id/divider1" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview3"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="8dp"
				app:contentPadding="20dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
				style="@style/Widget.Material3.CardView.Filled"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeWidth="0dp"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground"
				android:layout_below="@id/communityHeader">
				<RelativeLayout
					android:id="@+id/relativelayout100"
					android:layout_width="match_parent"
					android:layout_height="wrap_content">
					<TextView
						android:id="@+id/textview7"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Telegram"
						android:textSize="12sp"
						android:textAppearance="?attr/textAppearanceTitleMedium"
						android:maxLines="1"
						android:ellipsize="end"
						android:focusable="false"
						android:layout_alignParentTop="true"
						android:layout_alignParentStart="true" />
					<TextView
						android:id="@+id/textview8"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:text="@string/developer_telegram_url"
						android:textSize="12sp"
						android:textAppearance="?attr/textAppearanceBodyMedium"
						android:autoLink="web"
						android:linksClickable="true"
						android:maxLines="1"
						android:ellipsize="end"
						android:focusable="false"
						android:layout_below="@id/textview7"
						android:layout_alignParentStart="true" />
				</RelativeLayout>
			</com.google.android.material.card.MaterialCardView>
			<View
				android:id="@+id/divider2"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:layout_marginTop="12dp"
				android:layout_marginBottom="12dp"
				android:background="?attr/colorOutlineVariant"
				android:layout_below="@id/cardview3" />
			<TextView
				android:id="@+id/legalHeader"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="8dp"
				android:text="@string/legal_title"
				android:textSize="12sp"
				android:layout_marginStart="4dp"
				android:textAppearance="?attr/textAppearanceTitleMedium"
				android:focusable="false"
				android:layout_below="@id/divider2" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview4"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="8dp"
				app:contentPadding="20dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
				style="@style/Widget.Material3.CardView.Filled"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeWidth="0dp"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground"
				android:layout_below="@id/legalHeader">
				<RelativeLayout
					android:id="@+id/relativelayout101"
					android:layout_width="match_parent"
					android:layout_height="wrap_content">
					<TextView
						android:id="@+id/textview9"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/open_source_licenses_title"
						android:textSize="12sp"
						android:textAppearance="?attr/textAppearanceTitleMedium"
						android:maxLines="1"
						android:ellipsize="end"
						android:focusable="false"
						android:layout_alignParentTop="true"
						android:layout_alignParentStart="true" />
				</RelativeLayout>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cardview5"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="8dp"
				app:contentPadding="20dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
				style="@style/Widget.Material3.CardView.Filled"
				app:cardCornerRadius="20dp"
				app:cardElevation="0dp"
				app:strokeWidth="0dp"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground"
				android:layout_below="@id/cardview4">
				<RelativeLayout
					android:id="@+id/relativelayout102"
					android:layout_width="match_parent"
					android:layout_height="wrap_content">
					<TextView
						android:id="@+id/textview10"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/app_system_information_title"
						android:textSize="12sp"
						android:textAppearance="?attr/textAppearanceTitleMedium"
						android:maxLines="1"
						android:ellipsize="end"
						android:focusable="false"
						android:layout_alignParentTop="true"
						android:layout_alignParentStart="true" />
				</RelativeLayout>
			</com.google.android.material.card.MaterialCardView>
			<TextView
				android:id="@+id/footerText"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="24dp"
				android:layout_marginBottom="16dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="@string/app_version_footer"
				android:textSize="12sp"
				android:textAppearance="?attr/textAppearanceBodySmall"
				android:focusable="false"
				android:layout_below="@id/cardview5" />
		</RelativeLayout>
	</ScrollView>
</RelativeLayout>
