<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:fitsSystemWindows="true"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<LinearLayout
		android:id="@+id/lin_main"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:paddingTop="16dp"
		android:paddingBottom="16dp"
		android:orientation="vertical"
		android:paddingStart="16dp"
		android:paddingEnd="16dp">
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/card_hex_input"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:contentPadding="12dp"
			app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
			style="@style/Widget.Material3.CardView.Filled"
			app:cardCornerRadius="16dp"
			app:cardElevation="0dp"
			app:strokeWidth="0dp">
			<LinearLayout
				android:id="@+id/linear4"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/tv_hash"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="#"
					android:textSize="12sp"
					android:paddingStart="4dp"
					android:paddingEnd="4dp"
					android:textAppearance="?attr/textAppearanceTitleLarge"
					android:focusable="false" />
				<EditText
					android:id="@+id/edit"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:textSize="12sp"
					android:hint="Custom Hex Color"
					android:layout_weight="1"
					android:inputType="textNoSuggestions|textCapCharacters"
					android:paddingStart="4dp"
					android:paddingEnd="4dp"
					android:textAppearance="?attr/textAppearanceBodyLarge"
					android:maxLength="8"
					android:maxLines="1"
					android:focusable="true"
					android:focusableInTouchMode="true" />
				<View
					android:id="@+id/lin_preview"
					android:layout_width="40dp"
					android:layout_height="40dp"
					android:background="@drawable/bg_color_preview"
					android:layout_marginStart="8dp"
					android:layout_marginEnd="8dp"
					android:contentDescription="Colorpreview" />
				<com.google.android.material.button.MaterialButton
					android:id="@+id/btn_pick"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Pick"
					android:textSize="12sp"
					android:layout_marginEnd="6dp"
					style="@style/Widget.Material3.Button.TonalButton"
					app:cornerRadius="20dp"
					android:minWidth="64dp" />
				<com.google.android.material.button.MaterialButton
					android:id="@+id/btn_add"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Add"
					android:textSize="12sp"
					style="@style/Widget.Material3.Button"
					app:cornerRadius="20dp"
					android:minWidth="64dp" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/card_color_lists"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_marginTop="12dp"
			app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
			android:layout_weight="1"
			style="@style/Widget.Material3.CardView.Filled"
			app:cardCornerRadius="16dp"
			app:cardElevation="0dp"
			app:strokeWidth="0dp">
			<LinearLayout
				android:id="@+id/linear3"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:paddingTop="8dp"
				android:paddingBottom="8dp"
				android:orientation="horizontal">
				<ListView
					android:id="@+id/lv_primary_colors"
					android:layout_width="88dp"
					android:layout_height="match_parent"
					android:choiceMode="none"
					android:divider="@null"
					android:scrollbars="none"
					android:paddingStart="8dp"
					android:paddingEnd="4dp"
					android:clipToPadding="false" />
				<View
					android:id="@+id/view7"
					android:layout_width="1dp"
					android:layout_height="match_parent"
					android:layout_marginTop="8dp"
					android:layout_marginBottom="8dp"
					android:background="?attr/colorOutlineVariant" />
				<ListView
					android:id="@+id/lv_sub_colors"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:choiceMode="none"
					android:layout_weight="1"
					android:divider="@null"
					android:scrollbars="none"
					android:paddingStart="4dp"
					android:paddingEnd="8dp"
					android:clipToPadding="false" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>
	</LinearLayout>
</LinearLayout>
