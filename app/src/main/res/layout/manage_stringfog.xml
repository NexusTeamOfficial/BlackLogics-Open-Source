<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:fitsSystemWindows="true"
	android:orientation="vertical"
	android:layout_width="fill_parent"
	android:layout_height="fill_parent"
	android:background="?attr/colorSurface">
	<LinearLayout
		android:id="@+id/linear5"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical">
		<include layout="@layout/toolbar_improved" />
		<ScrollView
			android:id="@+id/vscroll2"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:paddingBottom="96dp"
			android:fillViewport="true"
			android:scrollbars="none"
			android:clipToPadding="false">
			<LinearLayout
				android:id="@+id/linear7"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="16dp"
				android:paddingBottom="16dp"
				android:orientation="vertical"
				android:paddingStart="20dp"
				android:paddingEnd="20dp">
				<TextView
					android:id="@+id/textview16"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginBottom="12dp"
					android:text="String Obfuscation"
					android:textSize="12sp"
					android:textAppearance="?attr/textAppearanceTitleLarge"
					android:focusable="false" />
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/card_sf_enabled"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
					style="@style/Widget.Material3.CardView.Filled"
					app:cardCornerRadius="20dp"
					app:cardElevation="0dp"
					app:strokeWidth="0dp">
					<LinearLayout
						android:id="@+id/linear6"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="20dp"
						android:orientation="vertical">
						<Switch
							android:id="@+id/sw_pg_enabled"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="left|center_vertical"
							android:text="Guard My Strings"
							android:textColor="#E53935"
							android:checked="true"
							android:paddingTop="8.0dip"
							android:paddingBottom="8.0dip"
							android:layout_marginBottom="12.0dip"
							android:textSize="16.0sp"
							android:focusable="false"
							android:textAppearance="?attr/textAppearanceTitleMedium" />
						<LinearLayout
							android:id="@+id/linear8"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="12dp"
							android:gravity="top"
							android:orientation="horizontal">
							<ImageView
								android:id="@+id/imageview2"
								android:src="@drawable/connected_96"
								android:scaleType="fitCenter"
								android:layout_width="24.0dip"
								android:layout_height="24.0dip"
								android:focusable="false"
								android:layout_marginEnd="12.0dip"
								app:tint="?attr/colorOnSurfaceVariant"
								android:contentDescription="@null" />
							<TextView
								android:id="@+id/textview2"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:gravity="left"
								android:text="Every hardcoded text inside your build gets scrambled at compile time. Anyone digging into the APK will only see gibberish instead of your original strings."
								android:textSize="12sp"
								android:layout_weight="1"
								android:focusable="false"
								android:textAppearance="?attr/textAppearanceBodyMedium"
								android:lineSpacingExtra="2dp" />
						</LinearLayout>
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>
				<TextView
					android:id="@+id/textview5"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:paddingTop="12dp"
					android:paddingBottom="12dp"
					android:background="?attr/colorErrorContainer"
					android:gravity="center_vertical"
					android:text="Careful! Encryption can break code that relies on reflection or hardcoded keys. Always test a release build before shipping."
					android:textSize="12sp"
					android:paddingStart="16dp"
					android:paddingEnd="16dp"
					android:textAppearance="?attr/textAppearanceBodyMedium"
					android:drawableStart="@android:drawable/ic_dialog_alert"
					android:drawablePadding="12dp"
					android:drawableTint="?attr/colorOnErrorContainer"
					android:lineSpacingExtra="2dp"
					android:focusable="false" />
				<TextView
					android:id="@+id/textview17"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="20dp"
					android:layout_marginBottom="4dp"
					android:text="Advanced Options"
					android:textSize="12sp"
					android:textAppearance="?attr/textAppearanceTitleLarge"
					android:focusable="false" />
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/card_sf_advanced"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
					style="@style/Widget.Material3.CardView.Filled"
					app:cardCornerRadius="20dp"
					app:cardElevation="0dp"
					app:strokeWidth="0dp"
					android:focusable="true"
					android:foreground="?attr/selectableItemBackground">
					<LinearLayout
						android:id="@+id/linear9"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:paddingTop="12dp"
						android:paddingBottom="12dp"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:minHeight="64dp"
						android:paddingStart="20dp"
						android:paddingEnd="12dp">
						<LinearLayout
							android:id="@+id/linear10"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_weight="1">
							<TextView
								android:id="@+id/textview6"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Custom Encryption Rules"
								android:textSize="12sp"
								android:textAppearance="?attr/textAppearanceTitleMedium"
								android:maxLines="1"
								android:ellipsize="end"
								android:focusable="false" />
							<TextView
								android:id="@+id/textview7"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginTop="4dp"
								android:text="Pick which classes or fields should be skipped during encryption. Handy when some strings need to stay readable for reflection, native hooks or serialized models."
								android:textSize="12sp"
								android:textAppearance="?attr/textAppearanceBodySmall"
								android:lineSpacingExtra="2dp"
								android:focusable="false" />
						</LinearLayout>
						<ImageView
							android:id="@+id/imageview3"
							android:layout_width="48dp"
							android:layout_height="48dp"
							android:padding="12dp"
							android:background="?attr/selectableItemBackgroundBorderless"
							android:src="@drawable/ic_edit_white_48dp"
							android:scaleType="fitCenter"
							app:tint="?attr/colorPrimary"
							android:contentDescription="@null"
							android:focusable="false" />
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>
				<TextView
					android:id="@+id/textview18"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="Tip: keep this off while debugging so logs stay readable. Turn it back on right before generating the final release APK."
					android:textSize="12sp"
					android:textAppearance="?attr/textAppearanceBodySmall"
					android:lineSpacingExtra="2dp"
					android:focusable="false" />
			</LinearLayout>
		</ScrollView>
	</LinearLayout>
</LinearLayout>
