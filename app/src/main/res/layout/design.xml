<androidx.drawerlayout.widget.DrawerLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_drawer"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	tools:openDrawer="start">
	<androidx.coordinatorlayout.widget.CoordinatorLayout
		android:id="@+id/_coordinator"
		android:layout_width="match_parent"
		android:layout_height="match_parent">
		<com.google.android.material.appbar.AppBarLayout
			android:id="@+id/_app_bar"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:theme="@style/AppTheme.AppBarOverlay"
			android:visibility="gone">
			<androidx.appcompat.widget.Toolbar
				android:id="@+id/_toolbar"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:background="?attr/colorPrimary"
				app:popupTheme="@style/AppTheme.PopupOverlay"
				android:visibility="gone"
				android:paddingTop="0dp" />
		</com.google.android.material.appbar.AppBarLayout>
		<RelativeLayout
			android:fitsSystemWindows="true"
			android:id="@+id/main_container"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="?attr/colorSurface"
			tools:context=".DesignActivity"
			app:layout_behavior="@string/appbar_scrolling_view_behavior">
			<com.google.android.material.appbar.MaterialToolbar
				android:id="@+id/designToolbar"
				android:layout_width="match_parent"
				android:background="?attr/colorSurface"
				android:layout_height="?attr/actionBarSize"
				android:elevation="0dp"
				app:navigationIcon="@drawable/tb_ic_back"
				app:navigationIconTint="?attr/colorOnSurface"
				app:navigationContentDescription="@string/back_button_description"
				app:titleTextAppearance="?attr/textAppearanceTitleMedium"
				app:subtitleTextAppearance="?attr/textAppearanceBodySmall"
				app:titleTextColor="?attr/colorOnSurface"
				app:subtitleTextColor="?attr/colorOnSurfaceVariant"
				app:menu="@menu/design_toolbar_actions"
				android:layout_alignParentTop="true" />
			<androidx.appcompat.widget.LinearLayoutCompat
				android:id="@+id/toolbar_improved"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:visibility="gone" />
			<com.google.android.material.tabs.TabLayout
				android:id="@+id/tab_layout"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="?attr/colorSurface"
				style="@style/Widget.Material3.TabLayout"
				app:tabGravity="fill"
				app:tabMode="fixed"
				app:tabIndicatorFullWidth="false"
				android:layout_below="@id/designToolbar" />
			<androidx.viewpager.widget.ViewPager
				android:id="@+id/customViewPager"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:background="?attr/colorSurface"
				android:layout_above="@id/controlPanelCard"
				android:layout_below="@id/tab_layout" />
			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/ah"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:padding="8dp"
				android:visibility="gone"
				android:layout_alignBottom="@id/ll_properties" />
			<androidx.appcompat.widget.LinearLayoutCompat
				android:id="@+id/anchor"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:orientation="horizontal"
				android:layout_above="@id/controlPanelCard" />
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/controlPanelCard"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
				style="@style/Widget.Material3.CardView.Filled"
				app:cardElevation="0dp"
				app:cardCornerRadius="0dp"
				app:strokeWidth="0dp"
				android:layout_alignParentBottom="true">
				<androidx.appcompat.widget.LinearLayoutCompat
					android:id="@+id/control_panel"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:padding="@dimen/control_panel_padding">
					<com.nexusteam.internal.editor.view.ProjectFileSelector
						android:id="@+id/file_selector"
						android:layout_width="0dp"
						android:layout_height="48dp"
						android:background="@drawable/bg_file_selector_m3"
						android:layout_weight="1"
						android:layout_marginEnd="12dp"
						android:paddingStart="8dp"
						android:paddingEnd="8dp" />
					<ImageView
						android:id="@+id/project_detail"
						android:layout_width="48dp"
						android:layout_height="48dp"
						android:padding="10dp"
						android:background="?attr/selectableItemBackgroundBorderless"
						android:src="@drawable/ic_detail_setting_48dp"
						android:scaleType="fitCenter"
						android:layout_marginEnd="8dp"
						android:contentDescription="@string/project_detail_description"
						android:tooltipText="@string/project_detail_description"
						android:tint="?attr/colorOnSurface"
						android:focusable="true" />
					<com.google.android.material.button.MaterialButton
						android:id="@+id/execute_button"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/run_button_text"
						android:textSize="12sp"
						style="@style/Widget.Material3.Button"
						android:layout_marginEnd="@dimen/button_margin_end" />
				</androidx.appcompat.widget.LinearLayoutCompat>
			</com.google.android.material.card.MaterialCardView>
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/propertiesCard"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:contentPadding="20dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
				android:visibility="gone"
				style="@style/Widget.Material3.CardView.Filled"
				app:cardElevation="0dp"
				app:cardCornerRadius="28dp"
				app:strokeWidth="0dp"
				android:layout_alignParentBottom="true"
				android:layout_toEndOf="@id/controlPanelCard">
				<androidx.appcompat.widget.LinearLayoutCompat
					android:id="@+id/ll_properties"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical" />
			</com.google.android.material.card.MaterialCardView>
			<de.hdodenhof.circleimageview.CircleImageView
				android:id="@+id/circleimageview1"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:src="@drawable/default_image"
				android:layout_marginEnd="16dp"
				app:civ_border_color="?attr/colorPrimary"
				app:civ_border_overlay="true"
				app:civ_border_width="2dp"
				app:civ_circle_background_color="?attr/colorSurface"
				android:layout_alignTop="@id/designToolbar"
				android:layout_alignBottom="@id/designToolbar"
				android:layout_alignParentEnd="true"
				android:layout_centerVertical="true" />
			<LinearLayout
				android:id="@+id/linear18"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:padding="8dp"
				android:orientation="horizontal"
				android:visibility="gone" />
		</RelativeLayout>
	</androidx.coordinatorlayout.widget.CoordinatorLayout>
	<LinearLayout
		android:id="@+id/_nav_view"
		android:layout_width="320dp"
		android:layout_height="match_parent"
		android:layout_gravity="start"
		android:background="?attr/colorSurface">
		<include layout="@layout/_drawer_design" android:id="@+id/drawer" />
	</LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
