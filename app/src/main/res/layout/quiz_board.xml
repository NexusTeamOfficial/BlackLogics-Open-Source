<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:fitsSystemWindows="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Bottom sheet container -->
    <LinearLayout
        android:id="@+id/bottom_sheet"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerHigh"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="200dp"
        app:behavior_hideable="false"
        app:behavior_fitToContents="true"
        app:behavior_halfExpandedRatio="0.5">

        <!-- ============ HEADER ROW: Title + Timer ============ -->
        <LinearLayout
            android:id="@+id/linear_header"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_waiting_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="While you wait…"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:focusable="false" />

            <TextView
                android:id="@+id/tv_remaining_time"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:background="@drawable/circle_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnPrimary"
                android:animateLayoutChanges="true"
                android:focusable="false" />
        </LinearLayout>

        <!-- ============ QUESTION ROW ============ -->
        <LinearLayout
            android:id="@+id/linear_question"
            android:gravity="top"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <ImageView
                android:id="@+id/iv_question_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/qa_q"
                android:scaleType="fitCenter"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null"
                android:focusable="false" />

            <TextView
                android:id="@+id/tv_question"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface"
                android:lineSpacingExtra="2dp"
                android:focusable="false" />
        </LinearLayout>

        <!-- ============ TIMEOUT PROGRESS BAR ============ -->
        <LinearLayout
            android:id="@+id/timeout_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            tools:visibility="visible" />

        <!-- ============ ANSWER AREA ============ -->
        <FrameLayout
            android:id="@+id/frame_answers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <!-- ============ O / X Answers ============ -->
            <RelativeLayout
                android:id="@+id/layout_answer_ox"
                android:padding="8dp"
                android:gravity="center"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/img_answer_o"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_centerInParent="true"
                    android:padding="12dp"
                    android:background="@drawable/bg_outline"
                    android:src="@drawable/answer_o"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Answer O" />

                <ImageView
                    android:id="@+id/img_answer_x"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_centerInParent="true"
                    android:padding="12dp"
                    android:background="@drawable/bg_outline"
                    android:src="@drawable/answer_x"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Answer X" />
            </RelativeLayout>

            <!-- ============ A / B Answers ============ -->
            <LinearLayout
                android:id="@+id/layout_answer_ab"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Answer A -->
                <LinearLayout
                    android:id="@+id/view_answer_a"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:minHeight="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_answer_a"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:focusable="false" />

                    <ImageView
                        android:id="@+id/img_answer_a"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:padding="4dp"
                        android:src="@drawable/ok_48"
                        android:scaleType="fitCenter"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="@null"
                        android:focusable="false" />
                </LinearLayout>

                <!-- Answer B -->
                <LinearLayout
                    android:id="@+id/view_answer_b"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:minHeight="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_answer_b"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:focusable="false" />

                    <ImageView
                        android:id="@+id/img_answer_b"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:padding="4dp"
                        android:src="@drawable/ok_48"
                        android:scaleType="fitCenter"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="@null"
                        android:focusable="false" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>