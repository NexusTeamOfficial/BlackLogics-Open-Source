<androidx.core.widget.NestedScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:fitsSystemWindows="true"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:fillViewport="true"
	android:clipToPadding="false"
	android:background="?attr/colorSurface">
	<LinearLayout
		android:id="@+id/linear3"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="24dp"
		android:paddingBottom="96dp"
		android:background="?attr/colorSurface"
		android:orientation="vertical"
		android:paddingStart="20dp"
		android:paddingEnd="20dp">
		<TextView
			android:id="@+id/title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="4dp"
			android:text="@string/app_create_new_project_title"
			android:textSize="12sp"
			android:textAppearance="?attr/textAppearanceHeadlineSmall"
			android:focusable="false" />
		<TextView
			android:id="@+id/textview5"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="20dp"
			android:text="@string/project_setup_subtitle"
			android:textSize="12sp"
			android:textAppearance="?attr/textAppearanceBodyMedium"
			android:focusable="false" />
		<LinearLayout
			android:id="@+id/linear12"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="20dp"
			android:gravity="top"
			android:orientation="horizontal">
			<LinearLayout
				android:id="@+id/linear36"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:orientation="vertical"
				android:layout_marginEnd="16dp">
				<FrameLayout
					android:id="@+id/frame_layout4"
					android:layout_width="72dp"
					android:layout_height="72dp">
					<de.hdodenhof.circleimageview.CircleImageView
						android:id="@+id/app_icon"
						android:layout_width="72dp"
						android:layout_height="72dp"
						android:src="@drawable/android_robot"
						android:contentDescription="@string/word_type_to_change_icon"
						app:civ_border_width="2dp"
						app:civ_border_color="?attr/colorPrimary"
						app:civ_circle_background_color="?attr/colorPrimaryContainer" />
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/cardview3"
						android:layout_width="28dp"
						android:layout_height="28dp"
						app:cardBackgroundColor="?attr/colorPrimary"
						android:layout_gravity="bottom|end"
						style="@style/Widget.Material3.CardView.Filled"
						app:cardCornerRadius="14dp"
						app:cardElevation="0dp"
						app:strokeWidth="0dp">
						<ImageView
							android:id="@+id/imageview6"
							android:layout_width="16dp"
							android:layout_height="16dp"
							android:src="@drawable/icon_settings_round_blue"
							android:scaleType="center"
							app:tint="?attr/colorOnPrimary"
							android:contentDescription="@null"
							android:focusable="false" />
					</com.google.android.material.card.MaterialCardView>
				</FrameLayout>
				<TextView
					android:id="@+id/textview12"
					android:layout_width="80dp"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="@string/word_type_to_change_icon"
					android:textSize="12sp"
					android:textAppearance="?attr/textAppearanceLabelSmall"
					android:focusable="false" />
			</LinearLayout>
			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/textinputlayout1"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
				app:startIconDrawable="@drawable/abc_96"
				app:startIconTint="?attr/colorOnSurfaceVariant">
				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/app_name"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:textSize="12sp"
					android:inputType="textCapWords"
					android:textAppearance="?attr/textAppearanceBodyLarge"
					android:maxLines="1"
					android:focusable="true"
					android:focusableInTouchMode="true" />
			</com.google.android.material.textfield.TextInputLayout>
		</LinearLayout>
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/cardview4"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="16dp"
			app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
			style="@style/Widget.Material3.CardView.Filled"
			app:cardCornerRadius="20dp"
			app:cardElevation="0dp"
			app:strokeWidth="0dp">
			<LinearLayout
				android:id="@+id/linear13"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="16dp"
				android:paddingBottom="16dp"
				android:background="?attr/selectableItemBackground"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:minHeight="64dp"
				android:paddingStart="20dp"
				android:paddingEnd="20dp"
				android:focusable="true"
				android:onClick="toggleAdvancedSettings">
				<ImageView
					android:id="@+id/imageview7"
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/icon_settings_round_blue"
					android:scaleType="center"
					android:layout_marginEnd="12dp"
					app:tint="?attr/colorPrimary"
					android:focusable="false"
					android:contentDescription="@null" />
				<TextView
					android:id="@+id/advanced_settings"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:text="@string/app_advance_settings_word"
					android:textSize="12sp"
					android:layout_weight="1"
					android:textAppearance="?attr/textAppearanceTitleMedium"
					android:maxLines="1"
					android:ellipsize="end"
					android:focusable="false" />
				<ImageView
					android:id="@+id/advanced_icon"
					android:layout_width="24dp"
					android:layout_height="24dp"
					android:src="@drawable/ic_expand_more"
					android:scaleType="fitCenter"
					android:focusable="false"
					app:tint="?attr/colorOnSurfaceVariant"
					android:contentDescription="@null" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>
		<HorizontalScrollView
			android:id="@+id/hscroll1"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:clipToPadding="false"
			android:scrollbars="none">
			<LinearLayout
				android:id="@+id/linear14"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:visibility="gone"
				tools:visibility="visible">
				<LinearLayout
					android:id="@+id/linear15"
					android:layout_width="76dp"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal"
					android:orientation="vertical"
					android:layout_marginEnd="12dp">
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/view16"
						android:layout_width="44dp"
						android:layout_height="44dp"
						android:layout_marginBottom="6dp"
						app:cardBackgroundColor="?attr/colorSecondaryContainer"
						style="@style/Widget.Material3.CardView.Filled"
						app:cardCornerRadius="14dp"
						app:cardElevation="0dp"
						app:strokeWidth="0dp"
						android:focusable="true" />
					<TextView
						android:id="@+id/textview6"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:text="@string/word_color_accent"
						android:textSize="12sp"
						android:textAppearance="?attr/textAppearanceLabelSmall"
						android:maxLines="1"
						android:ellipsize="end"
						android:focusable="false" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear17"
					android:layout_width="76dp"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal"
					android:orientation="vertical"
					android:layout_marginEnd="12dp">
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/view18"
						android:layout_width="44dp"
						android:layout_height="44dp"
						android:layout_marginBottom="6dp"
						app:cardBackgroundColor="?attr/colorPrimaryContainer"
						style="@style/Widget.Material3.CardView.Filled"
						app:cardCornerRadius="14dp"
						app:cardElevation="0dp"
						app:strokeWidth="0dp"
						android:focusable="true" />
					<TextView
						android:id="@+id/textview7"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:text="@string/word_color_primary"
						android:textSize="12sp"
						android:textAppearance="?attr/textAppearanceLabelSmall"
						android:maxLines="1"
						android:ellipsize="end"
						android:focusable="false" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear19"
					android:layout_width="76dp"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal"
					android:orientation="vertical"
					android:layout_marginEnd="12dp">
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/view20"
						android:layout_width="44dp"
						android:layout_height="44dp"
						android:layout_marginBottom="6dp"
						app:cardBackgroundColor="?attr/colorOnPrimaryContainer"
						style="@style/Widget.Material3.CardView.Filled"
						app:cardCornerRadius="14dp"
						app:cardElevation="0dp"
						app:strokeWidth="0dp"
						android:focusable="true" />
					<TextView
						android:id="@+id/textview8"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:text="@string/word_color_primary_dark"
						android:textSize="12sp"
						android:textAppearance="?attr/textAppearanceLabelSmall"
						android:maxLines="1"
						android:ellipsize="end"
						android:focusable="false" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear23"
					android:layout_width="76dp"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal"
					android:orientation="vertical"
					android:layout_marginEnd="12dp">
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/view24"
						android:layout_width="44dp"
						android:layout_height="44dp"
						android:layout_marginBottom="6dp"
						app:cardBackgroundColor="?attr/colorPrimary"
						style="@style/Widget.Material3.CardView.Filled"
						app:cardCornerRadius="14dp"
						app:cardElevation="0dp"
						app:strokeWidth="0dp"
						android:focusable="true" />
					<TextView
						android:id="@+id/textview10"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:text="@string/word_color_primary_highlight"
						android:textSize="12sp"
						android:textAppearance="?attr/textAppearanceLabelSmall"
						android:maxLines="1"
						android:ellipsize="end"
						android:focusable="false" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear25"
					android:layout_width="76dp"
					android:layout_height="wrap_content"
					android:gravity="center_horizontal"
					android:orientation="vertical">
					<com.google.android.material.card.MaterialCardView
						android:id="@+id/view26"
						android:layout_width="44dp"
						android:layout_height="44dp"
						android:layout_marginBottom="6dp"
						app:cardBackgroundColor="?attr/colorOnSecondaryContainer"
						style="@style/Widget.Material3.CardView.Filled"
						app:cardCornerRadius="14dp"
						app:cardElevation="0dp"
						app:strokeWidth="0dp"
						android:focusable="true" />
					<TextView
						android:id="@+id/textview11"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:gravity="center_horizontal|center_vertical"
						android:text="@string/word_color_primary_normal"
						android:textSize="12sp"
						android:textAppearance="?attr/textAppearanceLabelSmall"
						android:maxLines="1"
						android:ellipsize="end"
						android:focusable="false" />
				</LinearLayout>
			</LinearLayout>
		</HorizontalScrollView>
		<LinearLayout
			android:id="@+id/linear26"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:visibility="gone"
			tools:visibility="visible">
			<LinearLayout
				android:id="@+id/linear27"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="14dp"
				android:gravity="top"
				android:orientation="horizontal">
				<LinearLayout
					android:id="@+id/linear30"
					android:layout_width="40dp"
					android:layout_height="40dp"
					android:layout_marginTop="4dp"
					android:background="@drawable/bg_field_icon_circle"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal"
					android:layout_marginEnd="12dp">
					<ImageView
						android:id="@+id/imageview1"
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:src="@drawable/default_image"
						android:scaleType="fitCenter"
						android:focusable="false"
						app:tint="?attr/colorPrimary"
						android:contentDescription="@null" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear29"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:layout_weight="1">
					<TextView
						android:id="@+id/textview9"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginBottom="4dp"
						android:text="@string/project_template_package_name_title"
						android:textSize="12sp"
						android:textAppearance="?attr/textAppearanceLabelMedium"
						android:focusable="false" />
					<com.google.android.material.textfield.TextInputLayout
						android:id="@+id/textinputlayout2"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">
						<com.google.android.material.textfield.TextInputEditText
							android:id="@+id/package_name"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:textSize="12sp"
							android:inputType="textNoSuggestions"
							android:textAppearance="?attr/textAppearanceBodyMedium"
							android:maxLines="1"
							android:focusable="true"
							android:focusableInTouchMode="true" />
					</com.google.android.material.textfield.TextInputLayout>
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear31"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="14dp"
				android:gravity="top"
				android:orientation="horizontal">
				<LinearLayout
					android:id="@+id/linear32"
					android:layout_width="40dp"
					android:layout_height="40dp"
					android:layout_marginTop="4dp"
					android:background="@drawable/bg_field_icon_circle"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal"
					android:layout_marginEnd="12dp">
					<ImageView
						android:id="@+id/imageview2"
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:src="@drawable/abc_96"
						android:scaleType="fitCenter"
						android:focusable="false"
						app:tint="?attr/colorPrimary"
						android:contentDescription="@null" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear33"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:layout_weight="1">
					<TextView
						android:id="@+id/textview2"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginBottom="4dp"
						android:text="@string/project_name_label"
						android:textSize="12sp"
						android:textAppearance="?attr/textAppearanceLabelMedium"
						android:focusable="false" />
					<com.google.android.material.textfield.TextInputLayout
						android:id="@+id/textinputlayout3"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">
						<com.google.android.material.textfield.TextInputEditText
							android:id="@+id/project_name"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:textSize="12sp"
							android:textAppearance="?attr/textAppearanceBodyMedium"
							android:maxLines="1"
							android:focusable="true"
							android:focusableInTouchMode="true" />
					</com.google.android.material.textfield.TextInputLayout>
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear21"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="20dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<LinearLayout
					android:id="@+id/linear35"
					android:layout_width="40dp"
					android:layout_height="40dp"
					android:background="@drawable/bg_field_icon_circle"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="horizontal"
					android:layout_marginEnd="12dp">
					<ImageView
						android:id="@+id/imageview3"
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:src="@drawable/code_96"
						android:scaleType="fitCenter"
						android:focusable="false"
						app:tint="?attr/colorPrimary"
						android:contentDescription="@null" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear34"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:orientation="horizontal"
					android:layout_weight="1">
					<LinearLayout
						android:id="@+id/linear38"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal">
						<LinearLayout
							android:id="@+id/linear40"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:background="?attr/selectableItemBackground"
							android:orientation="vertical"
							android:layout_weight="1"
							android:layout_marginEnd="8dp"
							android:focusable="true">
							<TextView
								android:id="@+id/textview13"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginBottom="4dp"
								android:text="@string/word_version_code_label"
								android:textSize="12sp"
								android:textAppearance="?attr/textAppearanceLabelSmall"
								android:focusable="false" />
							<TextView
								android:id="@+id/version_code"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:paddingTop="10dp"
								android:paddingBottom="10dp"
								android:gravity="center_horizontal|center_vertical"
								android:text="@string/version_code_default"
								android:textSize="12sp"
								android:paddingStart="12dp"
								android:paddingEnd="12dp"
								android:backgroundTint="?attr/colorSecondaryContainer"
								android:textAppearance="?attr/textAppearanceLabelLarge"
								android:maxLines="1"
								android:ellipsize="end"
								android:focusable="false" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/linear39"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:background="?attr/selectableItemBackground"
							android:orientation="vertical"
							android:layout_weight="1"
							android:focusable="true">
							<TextView
								android:id="@+id/textview14"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginBottom="4dp"
								android:text="@string/word_version_name_label"
								android:textSize="12sp"
								android:textAppearance="?attr/textAppearanceLabelSmall"
								android:focusable="false" />
							<TextView
								android:id="@+id/version_name"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:paddingTop="10dp"
								android:paddingBottom="10dp"
								android:gravity="center_horizontal|center_vertical"
								android:text="@string/version_name_default"
								android:textSize="12sp"
								android:paddingStart="12dp"
								android:paddingEnd="12dp"
								android:backgroundTint="?attr/colorPrimaryContainer"
								android:textAppearance="?attr/textAppearanceLabelLarge"
								android:maxLines="1"
								android:ellipsize="end"
								android:focusable="false" />
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear22"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:layout_marginBottom="8dp"
			android:orientation="horizontal"
			android:gravity="end">
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_cancel"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/cancel"
				android:textSize="12sp"
				style="@style/Widget.Material3.Button.TextButton" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_create"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/create_app_word"
				android:textSize="12sp"
				android:layout_marginStart="8dp"
				style="@style/Widget.Material3.Button"
				app:cornerRadius="20dp" />
		</LinearLayout>
	</LinearLayout>
</androidx.core.widget.NestedScrollView>
