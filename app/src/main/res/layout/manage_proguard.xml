<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:fitsSystemWindows="true"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface">
	<LinearLayout
		android:id="@+id/linear7"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical">
		<include layout="@layout/toolbar_improved" />
		<ScrollView
			android:id="@+id/vscroll2"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:paddingBottom="96dp"
			android:fillViewport="true"
			android:scrollbars="none"
			android:clipToPadding="false">
			<LinearLayout
				android:id="@+id/linear9"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="16dp"
				android:paddingBottom="16dp"
				android:orientation="vertical"
				android:paddingStart="20dp"
				android:paddingEnd="20dp">
				<TextView
					android:id="@+id/textview6"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginBottom="12dp"
					android:text="Code Shrinking &amp; Obfuscation"
					android:textSize="12sp"
					android:textAppearance="?attr/textAppearanceTitleLarge"
					android:focusable="false" />
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/card_pg_enabled"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
					style="@style/Widget.Material3.CardView.Filled"
					app:cardCornerRadius="20dp"
					app:cardElevation="0dp"
					app:strokeWidth="0dp">
					<LinearLayout
						android:id="@+id/linear19"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="20dp"
						android:orientation="vertical">
						<com.google.android.material.materialswitch.MaterialSwitch
							android:id="@+id/sw_pg_enabled"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="Turn On Protection"
							android:textSize="12sp"
							android:focusable="false"
							android:minHeight="48dp"
							android:textAppearance="?attr/textAppearanceTitleMedium" />
						<LinearLayout
							android:id="@+id/linear10"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="12dp"
							android:gravity="top"
							android:orientation="horizontal">
							<ImageView
								android:id="@+id/imageview6"
								android:layout_width="24dp"
								android:layout_height="24dp"
								android:src="@drawable/connected_96"
								android:scaleType="fitCenter"
								android:layout_marginEnd="12dp"
								app:tint="?attr/colorOnSurfaceVariant"
								android:contentDescription="@null"
								android:focusable="false" />
							<TextView
								android:id="@+id/textview7"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:text="Once enabled, your classes and methods get renamed during the build, making the APK smaller and harder for anyone to read your source logic."
								android:textSize="12sp"
								android:layout_weight="1"
								android:textAppearance="?attr/textAppearanceBodyMedium"
								android:lineSpacingExtra="2dp"
								android:focusable="false" />
						</LinearLayout>
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>
				<TextView
					android:id="@+id/textview8"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:paddingTop="12dp"
					android:paddingBottom="12dp"
					android:background="?attr/colorErrorContainer"
					android:gravity="center_vertical"
					android:text="Heads up! Things can go wrong if rules aren't set correctly. Keep a proper config file ready and always test a release build before shipping."
					android:textSize="12sp"
					android:paddingStart="16dp"
					android:paddingEnd="16dp"
					android:textAppearance="?attr/textAppearanceBodyMedium"
					android:drawableStart="@android:drawable/ic_dialog_alert"
					android:drawablePadding="12dp"
					android:drawableTint="?attr/colorOnErrorContainer"
					android:focusable="false" />
				<TextView
					android:id="@+id/textview9"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="20dp"
					android:layout_marginBottom="4dp"
					android:text="Fine Tune Your Build"
					android:textSize="12sp"
					android:textAppearance="?attr/textAppearanceTitleLarge"
					android:focusable="false" />
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/card_pg_rules"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
					style="@style/Widget.Material3.CardView.Filled"
					app:cardCornerRadius="20dp"
					app:cardElevation="0dp"
					app:strokeWidth="0dp"
					android:focusable="true"
					android:foreground="?attr/selectableItemBackground">
					<LinearLayout
						android:id="@+id/ln_pg_rules"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:paddingTop="12dp"
						android:paddingBottom="12dp"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:minHeight="64dp"
						android:paddingStart="20dp"
						android:paddingEnd="12dp">
						<LinearLayout
							android:id="@+id/linear20"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_weight="1">
							<TextView
								android:id="@+id/textview10"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Custom Keep Rules"
								android:textSize="12sp"
								android:textAppearance="?attr/textAppearanceTitleMedium"
								android:maxLines="1"
								android:ellipsize="end"
								android:focusable="false" />
							<TextView
								android:id="@+id/textview3"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginTop="4dp"
								android:text="Open the rules file and tell the shrinker what to leave alone. Reflection, native hooks and serialized models usually need explicit keep entries, otherwise the build can crash at runtime."
								android:textSize="12sp"
								android:textAppearance="?attr/textAppearanceBodySmall"
								android:lineSpacingExtra="2dp"
								android:focusable="false" />
						</LinearLayout>
						<ImageView
							android:id="@+id/imageview7"
							android:layout_width="48dp"
							android:layout_height="48dp"
							android:padding="12dp"
							android:background="?attr/selectableItemBackgroundBorderless"
							android:src="@drawable/ic_edit_white_48dp"
							android:scaleType="fitCenter"
							app:tint="?attr/colorPrimary"
							android:contentDescription="@null"
							android:focusable="false" />
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/card_pg_fm"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
					style="@style/Widget.Material3.CardView.Filled"
					app:cardCornerRadius="20dp"
					app:cardElevation="0dp"
					app:strokeWidth="0dp"
					android:focusable="true"
					android:foreground="?attr/selectableItemBackground">
					<LinearLayout
						android:id="@+id/ln_pg_fm"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:paddingTop="12dp"
						android:paddingBottom="12dp"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:minHeight="64dp"
						android:paddingStart="20dp"
						android:paddingEnd="12dp">
						<LinearLayout
							android:id="@+id/linear21"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:layout_weight="1">
							<TextView
								android:id="@+id/textview11"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Deep Library Mode"
								android:textSize="12sp"
								android:textAppearance="?attr/textAppearanceTitleMedium"
								android:maxLines="1"
								android:ellipsize="end"
								android:focusable="false" />
							<TextView
								android:id="@+id/textview4"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginTop="4dp"
								android:text="Pick individual local libraries you want pulled into the shrinking pipeline. Their prebuilt DEX files get skipped and everything is recompiled from source, which gives better optimization but makes the build noticeably longer."
								android:textSize="12sp"
								android:textAppearance="?attr/textAppearanceBodySmall"
								android:lineSpacingExtra="2dp"
								android:focusable="false" />
						</LinearLayout>
						<ImageView
							android:id="@+id/imageview9"
							android:layout_width="48dp"
							android:layout_height="48dp"
							android:padding="12dp"
							android:background="?attr/selectableItemBackgroundBorderless"
							android:src="@drawable/ic_edit_white_48dp"
							android:scaleType="fitCenter"
							app:tint="?attr/colorPrimary"
							android:contentDescription="@null"
							android:focusable="false" />
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>
				<com.google.android.material.materialswitch.MaterialSwitch
					android:id="@+id/sw_pg_debug"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="20dp"
					android:layout_marginBottom="8dp"
					android:text="Keep mapping files for debugging"
					android:textSize="12sp"
					android:focusable="false"
					android:minHeight="48dp"
					android:textAppearance="?attr/textAppearanceBodyLarge" />
				<TextView
					android:id="@+id/textview12"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:text="Only keep mapping files when you're chasing a crash. For a public release it's safer to leave them off so nobody can reverse your renamed code."
					android:textSize="12sp"
					android:textAppearance="?attr/textAppearanceBodySmall"
					android:lineSpacingExtra="2dp"
					android:focusable="false" />
			</LinearLayout>
		</ScrollView>
	</LinearLayout>
</LinearLayout>
