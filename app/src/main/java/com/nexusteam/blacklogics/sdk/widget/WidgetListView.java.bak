package com.shapun.layouteditor.widgets;

import android.content.Context;
import android.util.AttributeSet;
import android.view.View;
import android.view.ViewGroup;
import android.widget.LinearLayout;
import android.widget.TextView;
import androidx.annotation.Nullable;
import java.util.ArrayList;
import java.util.List;

public class WidgetListView extends LinearLayout {
    
    private List<String> items = new ArrayList<>();
    private OnItemClickListener itemClickListener;
    private int selectedItemPosition = -1;
    
    public WidgetListView(Context context) {
        super(context);
        init(context);
    }
    
    public WidgetListView(Context context, @Nullable AttributeSet attrs) {
        super(context, attrs);
        init(context);
    }
    
    public WidgetListView(Context context, @Nullable AttributeSet attrs, int defStyleAttr) {
        super(context, attrs, defStyleAttr);
        init(context);
    }
    
    private void init(Context context) {
        setOrientation(VERTICAL);
        
        // Default padding
        int padding = (int) (8 * context.getResources().getDisplayMetrics().density);
        setPadding(padding, padding, padding, padding);
        
        // Stroke background (optional - for visual feedback)
        setBackground(createStrokeBackground());
        
        // Default items add karo
        setupDefaultItems();
    }
    
    private void setupDefaultItems() {
        // Sample items
        String[] sampleItems = {"Item 1", "Item 2", "Item 3", "Item 4"};
        setItems(sampleItems);
    }
    
    public void setItems(String[] newItems) {
        items.clear();
        removeAllViews();
        
        for (int i = 0; i < newItems.length; i++) {
            final int position = i;
            final String item = newItems[i];
            
            // Item row banayo
            LinearLayout itemRow = new LinearLayout(getContext());
            itemRow.setOrientation(HORIZONTAL);
            itemRow.setPadding(16, 16, 16, 16);
            
            // Divider (optional)
            if (i > 0) {
                View divider = new View(getContext());
                divider.setLayoutParams(new LayoutParams(
                    LayoutParams.MATCH_PARENT, 1));
                divider.setBackgroundColor(0xFFE0E0E0);
                addView(divider);
            }
            
            // Item text
            TextView textView = new TextView(getContext());
            textView.setText(item);
            textView.setLayoutParams(new LayoutParams(
                0, LayoutParams.WRAP_CONTENT, 1f));
            textView.setTextSize(16);
            
            // Optional icon (right side)
            TextView arrowIcon = new TextView(getContext());
            arrowIcon.setText("→");
            arrowIcon.setTextSize(18);
            arrowIcon.setTextColor(0xFF757575);
            
            itemRow.addView(textView);
            itemRow.addView(arrowIcon);
            
            // 🔥 ITEM CLICK HANDLER - YEH KAM KAREGA
            itemRow.setOnClickListener(new OnClickListener() {
                @Override
                public void onClick(View v) {
                    if (itemClickListener != null) {
                        itemClickListener.onItemClick(WidgetListView.this, 
                            v, position, item);
                    }
                    
                    // Visual feedback - selected item highlight
                //    highlightSelectedItem(position);
                }
            });
            
            // Long click for drag-drop
            itemRow.setOnLongClickListener(new OnLongClickListener() {
                @Override
                public boolean onLongClick(View v) {
                    // Drag drop start kar sakte ho
                    v.setBackgroundColor(0xFFE0E0E0);
                    return false; // Parent drag listener ko mauka do
                }
            });
            
            addView(itemRow);
            items.add(item);
        }
    }
    
    private void highlightSelectedItem(int position) {
        // Purana selection reset karo
        if (selectedItemPosition != -1 && selectedItemPosition < getChildCount()) {
            View oldRow = getChildAt(selectedItemPosition * 2); // *2 because of dividers
            if (oldRow != null) {
                oldRow.setBackgroundColor(0x00000000); // transparent
            }
        }
        
        // Naya selection highlight karo
        selectedItemPosition = position;
        View newRow = getChildAt(position * 2);
        if (newRow != null) {
            newRow.setBackgroundColor(0x1F2196F3); // light blue
        }
    }
    
    public void setOnItemClickListener(OnItemClickListener listener) {
        this.itemClickListener = listener;
    }
    
    public interface OnItemClickListener {
        void onItemClick(WidgetListView parent, View view, int position, String item);
    }
    
    private android.graphics.drawable.Drawable createStrokeBackground() {
        android.graphics.drawable.GradientDrawable drawable = 
            new android.graphics.drawable.GradientDrawable();
        drawable.setColor(0x00000000); // transparent
        drawable.setStroke(2, 0xFF2196F3); // blue border
        drawable.setCornerRadius(8);
        return drawable;
    }
}