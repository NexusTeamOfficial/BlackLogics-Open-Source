	// ✅ FIX: ma.a().k() se jo raw list aati hai usse safe ComponentBean list mein convert karo
	// LinkedTreeMap → HashMap cast error yahin hota tha
	private ArrayList<ComponentBean> getSafeComponentList(String projectId, String activityName) {
		ArrayList<ComponentBean> safeList = new ArrayList<>();
		try {
			// Raw list lo — isme LinkedTreeMap ho sakta hai andar
			ArrayList<ComponentBean> rawList = ma.a(projectId).k(activityName);
			if (rawList == null) return safeList;
			
			for (ComponentBean raw : rawList) {
				// Gson se round-trip karo — isse LinkedTreeMap problem door ho jaati hai
				String json = gson.toJson(raw);
				ComponentBean safe = gson.fromJson(json, ComponentBean.class);
				if (safe != null) {
					safeList.add(safe);
				}
			}
		} catch (Throwable t) {
			t.printStackTrace();
		}
		return safeList;
	}
	
	private boolean validateAndAddComponent() {
		
		int componentType = this.c.get(this.b.selectedPosition).type;
		String componentName = this.q.getText().toString().trim();
		
		Toast.makeText(this,
		"START → pos=" + this.b.selectedPosition +
		", type=" + componentType +
		", name=" + componentName,
		Toast.LENGTH_SHORT).show();
		
		// Validate component name
		if (!this.A.a()) {
			Toast.makeText(this, "Validation Failed", Toast.LENGTH_SHORT).show();
			return false;
		}
		
		String projectId = this.m;
		String actName = this.activityName;
		String extraData = null;
		
		try {
			
			if (componentType == ComponentBean.COMPONENT_TYPE_SHAREDPREF) {
				
				if (!this.B.a()) return false;
				extraData = this.r.getText().toString();
				
				ma.a(projectId).a(actName, componentType, componentName, extraData);
				Toast.makeText(this, "Saved SharedPref (MA)", Toast.LENGTH_SHORT).show();
				
				ProjectLogicRepository.saveComponentLogic(actName,
				ComponentBean.getComponentTypeName(componentType),
				componentName,
				extraData);
				
			} else if (componentType == ComponentBean.COMPONENT_TYPE_FIREBASE ||
			componentType == ComponentBean.COMPONENT_TYPE_FIREBASE_STORAGE) {
				
				if (!this.C.a()) return false;
				
				if (ma.d(projectId).c().useYn.equals(ProjectLibraryBean.LIB_USE_N)) {
					Toast.makeText(this, "Firebase not enabled", Toast.LENGTH_SHORT).show();
					return false;
				}
				
				extraData = this.s.getText().toString();
				
				ma.a(projectId).a(actName, componentType, componentName, extraData);
				Toast.makeText(this, "Saved Firebase (MA)", Toast.LENGTH_SHORT).show();
				
				ProjectLogicRepository.saveComponentLogic(actName,
				ComponentBean.getComponentTypeName(componentType),
				componentName,
				extraData);
				
			} else if (componentType == ComponentBean.COMPONENT_TYPE_FIREBASE_AUTH) {
				
				if (ma.d(projectId).c().useYn.equals(ProjectLibraryBean.LIB_USE_N)) {
					Toast.makeText(this, "Firebase Auth not enabled", Toast.LENGTH_SHORT).show();
					return false;
				}
				
				extraData = this.s.getText().toString();
				
				ma.a(projectId).a(actName, componentType, componentName, extraData);
				Toast.makeText(this, "Saved Firebase Auth", Toast.LENGTH_SHORT).show();
				
				ProjectLogicRepository.saveComponentLogic(actName,
				ComponentBean.getComponentTypeName(componentType),
				componentName,
				extraData);
				
			} else if (componentType == ComponentBean.COMPONENT_TYPE_INTERSTITIAL_AD) {
				
				ma.a(projectId).c(actName, componentType, componentName);
				Toast.makeText(this, "Saved AdMob", Toast.LENGTH_SHORT).show();
				
				ProjectLogicRepository.saveComponentLogic(actName,
				ComponentBean.getComponentTypeName(componentType),
				componentName,
				"");
				
			} else if (componentType == ComponentBean.COMPONENT_TYPE_FILE_PICKER) {
				
				if (this.t.getText().toString().trim().isEmpty() || !this.D.a()) {
					Toast.makeText(this, "File picker validation failed", Toast.LENGTH_SHORT).show();
					return false;
				}
				
				extraData = this.t.getText().toString();
				
				ma.a(projectId).a(actName, componentType, componentName, extraData);
				Toast.makeText(this, "Saved FilePicker", Toast.LENGTH_SHORT).show();
				
				ProjectLogicRepository.saveComponentLogic(actName,
				ComponentBean.getComponentTypeName(componentType),
				componentName,
				extraData);
				
			} else if (componentType > 21) {
				
				ComponentBean selectedBean = this.c.get(this.b.selectedPosition);
				String customTypeName = (selectedBean.typeName != null && !selectedBean.typeName.isEmpty())
				? selectedBean.typeName
				: "CustomComponent";
				
				ma.a(projectId).c(actName, componentType, componentName);
				Toast.makeText(this, "Saved Custom Component", Toast.LENGTH_SHORT).show();
				
				ProjectLogicRepository.saveComponentLogic(actName,
				customTypeName,
				componentName,
				"");
				
			} else {
				
				ma.a(projectId).c(actName, componentType, componentName);
				Toast.makeText(this, "Saved Normal Component", Toast.LENGTH_SHORT).show();
				
				ProjectLogicRepository.saveComponentLogic(actName,
				ComponentBean.getComponentTypeName(componentType),
				componentName,
				"");
			}
			
			// Commit
			ma.a(projectId).c();
			Toast.makeText(this, "MA Commit Done", Toast.LENGTH_SHORT).show();
			
			// ✅ FIX: getSafeComponentList() use karo — seedha k() nahi
			// ma.a().k() LinkedTreeMap deta tha jo HashMap mein cast nahi hota
			ArrayList<ComponentBean> allComponents = getSafeComponentList(projectId, actName);
			
			Toast.makeText(this,
			"MA SIZE = " + allComponents.size(),
			Toast.LENGTH_LONG).show();
			
			// BlockStorage refresh
			BlockStorage.clearComponents(actName);
			
			for (ComponentBean comp : allComponents) {
				ComponentData data = new ComponentData(
				comp.type,
				comp.componentId != null ? comp.componentId : String.valueOf(System.currentTimeMillis()),
				comp.param1 != null ? comp.param1 : ""
				);
				BlockStorage.addComponent(actName, data);
			}
			
			Toast.makeText(this, "BlockStorage Updated", Toast.LENGTH_SHORT).show();
			Toast.makeText(this, "DONE ✅", Toast.LENGTH_SHORT).show();
			
			return true;
			
		} catch (Throwable t) {
			t.printStackTrace();
			
			// ✅ Full error with package and line number
			StackTraceElement element = t.getStackTrace()[0];
			String errorMsg = "ERROR: " + t.toString() +
			"\nAt: " + element.getClassName() +
			"." + element.getMethodName() +
			" (" + element.getFileName() + ":" + element.getLineNumber() + ")";
			
			// Copy to clipboard
			ClipboardManager clipboard = (ClipboardManager) getSystemService(Context.CLIPBOARD_SERVICE);
			ClipData clip = ClipData.newPlainText("Error Log", errorMsg);
			clipboard.setPrimaryClip(clip);
			
			// Show toast
			Toast.makeText(this, errorMsg, Toast.LENGTH_LONG).show();
			
			return false;
		}
	}
	
	private void openDocumentation() {
		ComponentBean component = this.c.get(this.b.selectedPosition);
		String docUrl;
		
		if (component.type <= 21) {
			docUrl = ComponentBean.getComponentDocsUrlByTypeName(component.type);
		} else {
			docUrl = component.url != null ? component.url : "";
		}
		
		if (docUrl == null || docUrl.trim().isEmpty()) {
			ke.a(getApplicationContext(), 
			(CharSequence) StringResourceManager.a().a(getApplicationContext(), 
			R.string.component_add_message_docs_updated_soon), 
			0).show();
			return;
		}
		
		try {
			Intent intent = new Intent(Intent.ACTION_VIEW);
			intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
			intent.setData(Uri.parse("googlechrome://navigate?url=" + docUrl));
			intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
			intent.addFlags(Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
			intent.addFlags(Intent.FLAG_ACTIVITY_NO_HISTORY);
			startActivity(intent);
		} catch (Exception e) {
			showChromeDialog();
		}
	}
	
	private void showChromeDialog() {
		final CustomAlertDialog dialog = new CustomAlertDialog(this);
		dialog.a(R.drawable.chrome_96);
		dialog.a(StringResourceManager.a().a(getApplicationContext(), R.string.title_compatible_chrome_browser));
		dialog.b(StringResourceManager.a().a(getApplicationContext(), R.string.message_compatible_chrome_brower));
		dialog.a(StringResourceManager.a().a(getApplicationContext(), R.string.common_word_ok), new View.OnClickListener() {
			@Override
			public void onClick(View view) {
				if (!ki.a()) {
					Intent intent = new Intent(Intent.ACTION_VIEW);
					intent.setData(Uri.parse("market://details?id=com.android.chrome"));
					ComponentAddActivity.this.startActivity(intent);
					dialog.dismiss();
				}
			}
		});
		dialog.b(StringResourceManager.a().a(getApplicationContext(), R.string.common_word_cancel), new View.OnClickListener() {
			@Override
			public void onClick(View view) {
				dialog.dismiss();
			}
		});
		dialog.show();
	}
	
	// Adapter class
	class a extends RecyclerView.Adapter<a.C0039a> {
		public int selectedPosition = -1;
		RecyclerView recyclerView;
		
		public a() {
		}
		
		@Override
		public long getItemId(int position) {
			return (long) position;
		}
		
		@Override
		public void onAttachedToRecyclerView(RecyclerView recyclerView) {
			super.onAttachedToRecyclerView(recyclerView);
			this.recyclerView = recyclerView;
		}
		
		@Override
		@NonNull
		public C0039a onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {
			View itemView = ViewHelper.a(parent.getContext(), R.layout.component_add_item);
			int size = (int) ViewHelper.a(parent.getContext(), 76.0f);
			itemView.setLayoutParams(new FlexboxLayoutManager.LayoutParams(size, size));
			return new C0039a(itemView);
		}
		
		@Override
		public void onBindViewHolder(@NonNull final C0039a holder, final int position) {
			final ComponentBean component = ComponentAddActivity.this.c.get(position);
			
			// Get component name
			final String componentName;
			if (component.type <= 21) {
				componentName = ComponentBean.getComponentName(
				ComponentAddActivity.this.getApplicationContext(), 
				component.type
				);
			} else {
				componentName = component.name != null ? component.name : "Custom";
			}
			
			// Reset animations
			holder.itemView.setAlpha(1.0f);
			holder.itemView.setTranslationX(0.0f);
			holder.itemView.setTranslationY(0.0f);
			holder.nameText.setAlpha(1.0f);
			holder.nameText.setText(componentName);
			
			// Set icon
			if (component.type <= 21) {
				int iconRes = ComponentBean.getIconResource(component.type);
				holder.iconImage.setImageResource(iconRes);
			} else {
				try {
					if (component.icon != null && !component.icon.isEmpty()) {
						int iconRes = ComponentAddActivity.this.getResources()
						.getIdentifier(component.icon, "drawable", 
						ComponentAddActivity.this.getPackageName());
						
						if (iconRes != 0) {
							holder.iconImage.setImageResource(iconRes);
						} else {
							holder.iconImage.setImageResource(R.drawable.widget_module);
						}
					} else {
						holder.iconImage.setImageResource(R.drawable.widget_module);
					}
				} catch (Exception e) {
					holder.iconImage.setImageResource(R.drawable.widget_module);
				}
			}
			
			// Handle selection animation
			if (ComponentAddActivity.this.e) {
				if (position == this.selectedPosition) {
					Pair<Integer, Integer> pair = ComponentAddActivity.this.d.get(Integer.valueOf(position));
					if (pair != null) {
						holder.nameText.animate().setDuration(100).alpha(0.0f).start();
						
						holder.itemView.animate()
						.setStartDelay(300)
						.translationX((float) (-pair.first.intValue()))
						.translationY((float) (-pair.second.intValue()))
						.setDuration(300)
						.setListener(new Animator.AnimatorListener() {
							@Override
							public void onAnimationStart(Animator animator) {}
							@Override
							public void onAnimationCancel(Animator animator) {}
							@Override
							public void onAnimationRepeat(Animator animator) {}
							
							@Override
							public void onAnimationEnd(Animator animator) {
								ComponentAddActivity.this.i.setText(componentName);
								ComponentAddActivity.this.showComponentDetails();
								ComponentAddActivity.this.f = false;
							}
						}).start();
					}
				} else {
					holder.itemView.animate().alpha(0.0f).start();
				}
			}
		}
		
		@Override
