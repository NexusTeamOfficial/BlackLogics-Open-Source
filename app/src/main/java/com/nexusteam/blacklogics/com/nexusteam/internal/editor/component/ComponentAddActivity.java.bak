		// ViewHolder class
		class C0039a extends RecyclerView.ViewHolder {
			ImageView iconImage;
			TextView nameText;
			
			public C0039a(View itemView) {
				super(itemView);
				this.iconImage = (ImageView) itemView.findViewById(R.id.icon);
				this.nameText = (TextView) itemView.findViewById(R.id.name);
				
				itemView.setOnClickListener(new View.OnClickListener() {
					@Override
					public void onClick(View view) {
						if (!ComponentAddActivity.this.f) {
							ComponentAddActivity.this.f = true;
							selectedPosition = C0039a.this.getLayoutPosition();
							ComponentAddActivity.this.e = true;
							
							// Calculate animation position
							int[] itemLocation = new int[2];
							view.getLocationInWindow(itemLocation);
							
							int[] recyclerLocation = new int[2];
							recyclerView.getLocationInWindow(recyclerLocation);
							
							int offsetX = itemLocation[0] - recyclerLocation[0];
							int offsetY = (int) ((float) (itemLocation[1] - recyclerLocation[1]) - 
							ViewHelper.a(ComponentAddActivity.this.getApplicationContext(), 16.0f));
							
							ComponentAddActivity.this.d.put(
							Integer.valueOf(selectedPosition), 
							new Pair<Integer, Integer>(Integer.valueOf(offsetX), Integer.valueOf(offsetY))
							);
							
							notifyDataSetChanged();
						}
					}
				});
			}
		}
	}
	
	private void showComponentDetails() {
		this.j.setVisibility(View.VISIBLE);
		this.G.setVisibility(View.VISIBLE);
		this.E.setVisibility(View.VISIBLE);
		this.F.setVisibility(View.VISIBLE);
		this.h.setVisibility(View.VISIBLE);
		this.k.setVisibility(View.VISIBLE);
		this.f1092a.setVisibility(View.GONE);
		this.F.setTranslationX(0.0f);
		this.F.setTranslationY(0.0f);
		
		ComponentBean componentBean = this.c.get(this.b.selectedPosition);
		
		// Hide all input fields initially
		this.p.setVisibility(View.GONE);
		this.v.setVisibility(View.GONE);
		this.y.setVisibility(View.GONE);
		this.z.setVisibility(View.GONE);
		this.w.setVisibility(View.GONE);
		this.o.setVisibility(View.GONE);
		
		// Show relevant input fields based on component type
		int type = componentBean.type;
		if (type == ComponentBean.COMPONENT_TYPE_SHAREDPREF) {
			this.v.setVisibility(View.VISIBLE);
		} else if (type == ComponentBean.COMPONENT_TYPE_FIREBASE || 
		type == ComponentBean.COMPONENT_TYPE_FIREBASE_STORAGE) {
			this.y.setVisibility(View.VISIBLE);
			this.w.setVisibility(View.VISIBLE);
		} else if (type == ComponentBean.COMPONENT_TYPE_GYROSCOPE) {
			if (!ky.b(this, 4)) {
				this.p.setVisibility(View.VISIBLE);
				this.p.setText(StringResourceManager.a().a((Context) this, R.string.message_device_not_support));
			}
		} else if (type == ComponentBean.COMPONENT_TYPE_FILE_PICKER) {
			this.z.setVisibility(View.VISIBLE);
			this.o.setVisibility(View.VISIBLE);
		}
		
		// Set icon
		if (componentBean.type <= 21) {
			this.j.setImageResource(ComponentBean.getIconResource(componentBean.type));
		} else {
			try {
				if (componentBean.icon != null && !componentBean.icon.isEmpty()) {
					int iconRes = getResources().getIdentifier(
					componentBean.icon, "drawable", getPackageName());
					
					if (iconRes != 0) {
						this.j.setImageResource(iconRes);
					} else {
						this.j.setImageResource(R.drawable.widget_module);
					}
				} else {
					this.j.setImageResource(R.drawable.widget_module);
				}
			} catch (Exception e) {
				this.j.setImageResource(R.drawable.widget_module);
			}
		}
		
		// Set title
		String title;
		if (componentBean.type <= 21) {
			title = ComponentBean.getComponentName(getApplicationContext(), componentBean.type);
		} else {
			title = componentBean.name != null ? componentBean.name : "Custom Component";
		}
		this.g.setText(title);
		
		// Set description
		String description;
		if (componentBean.type <= 21) {
			description = StringResourceManager.a().a(getApplicationContext(), 
			ComponentBean.getDescStrResource(componentBean.type));
		} else {
			description = componentBean.description != null ? componentBean.description : "";
		}
		this.h.setText(description);
		
		// Start animations
		this.h.setAlpha(0.0f);
		this.E.setAlpha(0.0f);
		this.H.setAlpha(0.0f);
		this.I.setAlpha(0.0f);
		this.E.setTranslationY(300.0f);
		
		this.h.animate().alpha(1.0f).start();
		this.k.animate().alpha(1.0f).start();
		this.E.animate().alpha(1.0f).translationY(0.0f).start();
		this.H.animate().setStartDelay(150).alpha(1.0f).start();
		this.I.animate().setStartDelay(150).alpha(1.0f).start();
	}
	
	private void animateBack() {
		if (!this.f) {
			// Hide keyboard
			View currentFocus = getCurrentFocus();
			if (currentFocus != null) {
				((InputMethodManager) getSystemService(Context.INPUT_METHOD_SERVICE))
				.hideSoftInputFromWindow(currentFocus.getWindowToken(), 0);
			}
			
			this.f = true;
			
			// Fade out
			this.h.animate().alpha(0.0f).start();
			this.E.animate().alpha(0.0f).start();
			this.H.animate().alpha(0.0f).start();
			this.I.animate().alpha(0.0f).start();
			
			// Animate icon back
			final Pair<Integer, Integer> pair = this.d.get(Integer.valueOf(this.b.selectedPosition));
			if (pair != null) {
				this.F.animate()
				.translationX((float) pair.first.intValue())
				.translationY((float) pair.second.intValue())
				.setDuration(300)
				.setListener(new Animator.AnimatorListener() {
					@Override
					public void onAnimationStart(Animator animator) {}
					@Override
					public void onAnimationCancel(Animator animator) {}
					@Override
					public void onAnimationRepeat(Animator animator) {}
					
					@Override
					public void onAnimationEnd(Animator animator) {
						ComponentAddActivity.this.f = false;
						ComponentAddActivity.this.e = false;
						ComponentAddActivity.this.G.setVisibility(View.GONE);
						ComponentAddActivity.this.h.setVisibility(View.GONE);
						ComponentAddActivity.this.k.setVisibility(View.GONE);
						ComponentAddActivity.this.F.setVisibility(View.GONE);
						ComponentAddActivity.this.f1092a.setVisibility(View.VISIBLE);
						ComponentAddActivity.this.g.setText(
						StringResourceManager.a().a(ComponentAddActivity.this.getApplicationContext(), 
						R.string.component_title_add_component)
						);
						ComponentAddActivity.this.b.notifyDataSetChanged();
					}
				}).start();
			}
		}
	}
