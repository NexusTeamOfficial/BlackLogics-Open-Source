package com.nexusteam.internal.os.layouteditor;

import android.content.Context;
import android.graphics.PorterDuff;
import android.os.Vibrator;
import android.util.Log;
import android.view.DragEvent;
import android.view.Gravity;
import android.view.View;
import android.view.ViewGroup;
import android.widget.FrameLayout;
import android.widget.HorizontalScrollView;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.ImageView;

import com.shapun.layouteditor.ViewEditor;

/**
 * EditorDragController — ViewEditor ke liye stable drag-and-drop controller.
 *
 * <h3>Root Cause of Old Crashes (fixed here)</h3>
 * <ol>
 *   <li><b>NPE in dispatchDragEvent</b>: Pehle ACTION_DRAG_STARTED mein view remove ho jaata tha.
 *       Android ka system usi waqt hierarchy traverse karta hai → {@code mPrivateFlags2} null crash.<br>
 *       <b>Fix</b>: DRAG_STARTED mein sirf {@code alpha=0} (visually hide). Actual removal
 *       ACTION_DROP ke entry point pe, jab system ka traversal complete ho chuka hota hai.</li>
 *   <li><b>ScrollView multiple children</b>: {@link #canAcceptChild(ViewGroup, View)} check se
 *       ScrollView/HorizontalScrollView mein ek se zyada child drop block ho jaata hai.</li>
 *   <li><b>Double removeView</b>: handleDropExistingWidget mein dobara remove nahi hota — view
 *       ACTION_DROP entry mein already remove ho chuka hai.</li>
 * </ol>
 *
 * <h3>Usage</h3>
 * <pre>
 *   EditorDragController drag = new EditorDragController(context, editorLayout, placeHolder);
 *   drag.setViewEditor(this);
 *   editorLayout.setOnDragListener(drag.getDragListener());
 * </pre>
 *
 * @author NexusTeam & SmartIndiaGaming
 * @version 3.0.0
 */
public class EditorDragController {

    private static final String TAG = "EditorDragController";

    // ============================================================
    // Callback Interface (ViewEditor ko inform karne ke liye)
    // ============================================================

    public interface DragCallback {
        /** Naya widget palette se drop hua. */
        void onNewWidgetDropped(Object widgetData, ViewGroup destination, DragEvent event);

        /** Existing canvas widget move hua. */
        void onExistingWidgetMoved(View draggedView, ViewGroup newParent, int insertIndex);

        /** Widget delete zone pe drop hua. */
        void onWidgetDeleted(View draggedView);

        /** Drag shuru hua — UI update ke liye (delete button show etc). */
        void onDragStarted(View draggedView);

        /** Drag khatam hua (drop ya cancel dono). */
        void onDragEnded(boolean dropSuccessful, View draggedView);
    }

    // ============================================================
    // Fields
    // ============================================================

    private final Context context;
    private final ViewGroup editorLayout;
    private final View placeHolder;
    private DragCallback callback;
    private View deleteTarget;   // woh ImageView jis pe drop = delete
    private final Vibrator vibrator;

    // ============================================================
    // Constructor
    // ============================================================

    public EditorDragController(Context context, ViewGroup editorLayout, View placeHolder) {
        this.context      = context;
        this.editorLayout = editorLayout;
        this.placeHolder  = placeHolder;
        this.vibrator     = (Vibrator) context.getSystemService(Context.VIBRATOR_SERVICE);
    }

    public void setCallback(DragCallback callback) {
        this.callback = callback;
    }

    /**
     * Delete zone set karo (usually floating ImageView at bottom-left).
     * Drag is view ke upar end hoga toh widget delete ho jaayega.
     */
    public void setDeleteTarget(View deleteTarget) {
        this.deleteTarget = deleteTarget;
    }

    // ============================================================
    // DragListener Factory
    // ============================================================

    /**
     * Returns a {@link View.OnDragListener} that is safe to attach to any
     * {@link ViewGroup} on the editor canvas.
     *
     * <p>This single listener handles both new-widget drops (palette drag)
     * and existing-widget rearrangements (canvas drag).
     */
    public View.OnDragListener getDragListener() {
        return new SafeDragListener();
    }

    // ============================================================
    // Core Listener Implementation
    // ============================================================

    private class SafeDragListener implements View.OnDragListener {

        @Override
        public boolean onDrag(View destinationView, DragEvent event) {
            // LocalState: View = existing canvas widget being moved
            //             HashMap = new widget from palette
            //             null = nothing meaningful
            final Object localState = event.getLocalState();
            final View draggedView  = (localState instanceof View) ? (View) localState : null;

            try {
                switch (event.getAction()) {

                    // ──────────────────────────────────────────────────────────────
                    // DRAG_STARTED
                    // ──────────────────────────────────────────────────────────────
                    case DragEvent.ACTION_DRAG_STARTED:
                        // ⚠️ CRITICAL FIX: View ko ABHI remove NAHI karo.
                        // Android system abhi is event ke baad poori hierarchy ke sabhi
                        // ViewGroups ko notifyChildOfDragStart() se notify karta hai.
                        // Agar view already remove ho to mPrivateFlags2 null → NPE crash.
                        // Solution: sirf alpha=0 se hide karo. Removal ACTION_DROP mein.
                        if (draggedView != null) {
                            draggedView.setAlpha(0f);
                        }
                        if (callback != null) callback.onDragStarted(draggedView);
                        return true;

                    // ──────────────────────────────────────────────────────────────
                    // DRAG_ENTERED / DRAG_LOCATION — placeholder position update
                    // ──────────────────────────────────────────────────────────────
                    case DragEvent.ACTION_DRAG_ENTERED:
                    case DragEvent.ACTION_DRAG_LOCATION:
                        if (isOverDeleteTarget(event)) {
                            // Delete zone pe hover — placeholder hide
                            safeRemoveView(placeHolder);
                            highlightDeleteTarget(true);
                        } else {
                            highlightDeleteTarget(false);
                            // Placeholder dikhao destination mein
                            if (destinationView instanceof ViewGroup
                                    && canAcceptChild((ViewGroup) destinationView, placeHolder)) {
                                insertPlaceholder((ViewGroup) destinationView, event);
                            }
                        }
                        return true;

                    // ──────────────────────────────────────────────────────────────
                    // DRAG_EXITED
                    // ──────────────────────────────────────────────────────────────
                    case DragEvent.ACTION_DRAG_EXITED:
                        safeRemoveView(placeHolder);
                        highlightDeleteTarget(false);
                        return true;

                    // ──────────────────────────────────────────────────────────────
                    // ACTION_DROP — ab safe hai view remove karna
                    // ──────────────────────────────────────────────────────────────
                    case DragEvent.ACTION_DROP:
                        safeRemoveView(placeHolder);

                        // Step 1: Existing view ko ab safely remove karo
                        // (system ke saare callbacks complete ho chuke hain)
                        if (draggedView != null) {
                            draggedView.setAlpha(1f);
                            safeRemoveView(draggedView);
                        }

                        // Step 2: Delete zone check
                        if (isOverDeleteTarget(event) && draggedView != null) {
                            if (callback != null) callback.onWidgetDeleted(draggedView);
                            return true;
                        }

                        // Step 3: destinationView ViewGroup hona chahiye
                        if (!(destinationView instanceof ViewGroup)) return false;
                        ViewGroup dest = (ViewGroup) destinationView;

                        // Step 4: Drop type decide karo
                        if (draggedView != null) {
                            // Existing canvas widget move
                            if (!canAcceptChild(dest, draggedView)) return false;
                            int insertIdx = getInsertIndex(dest, event);
                            addViewSafe(draggedView, dest, insertIdx);
                            if (callback != null) {
                                callback.onExistingWidgetMoved(draggedView, dest, insertIdx);
                            }
                        } else if (localState instanceof java.util.HashMap) {
                            // New widget from palette
                            if (callback != null) {
                                callback.onNewWidgetDropped(localState, dest, event);
                            }
                        }
                        return true;

                    // ──────────────────────────────────────────────────────────────
                    // DRAG_ENDED
                    // ──────────────────────────────────────────────────────────────
                    case DragEvent.ACTION_DRAG_ENDED:
                        safeRemoveView(placeHolder);
                        highlightDeleteTarget(false);

                        boolean success = event.getResult();

                        if (!success && draggedView != null) {
                            // Drop fail/cancel — view wapas visible karo
                            draggedView.setAlpha(1f);
                            // Agar view kisi parent mein nahi to cleanup
                            if (draggedView.getParent() == null) {
                                Log.w(TAG, "Drag cancelled, view lost parent: "
                                    + draggedView.getClass().getSimpleName());
                            }
                        }

                        if (success && vibrator != null) {
                            vibrator.vibrate(60);
                        }

                        if (callback != null) callback.onDragEnded(success, draggedView);
                        return true;

                    default:
                        break;
                }
            } catch (Exception e) {
                // Drag callback mein koi bhi exception crash nahi karega
                Log.e(TAG, "DragListener error: " + e.getMessage(), e);
                // Cleanup
                safeRemoveView(placeHolder);
                if (draggedView != null) draggedView.setAlpha(1f);
            }
            return true;
        }
    }

    // ============================================================
    // Child Acceptance Guard
    // ============================================================

    /**
     * Returns true if {@code destination} can legally accept {@code child} as a new child.
     *
     * <p>Rules:
     * <ul>
     *   <li>{@link ScrollView} aur {@link HorizontalScrollView} — sirf 1 real child (placeholder
     *       count nahi hota)</li>
     *   <li>Koi bhi view apna ancestor nahi ban sakta (circular hierarchy guard)</li>
     *   <li>View apna hi parent nahi ban sakta</li>
     * </ul>
     *
     * @param destination target ViewGroup
     * @param child       view jo add karna hai
     * @return true if addition is safe
     */
    public boolean canAcceptChild(ViewGroup destination, View child) {
        if (destination == null || child == null) return false;

        // Circular hierarchy check — child apna ancestor nahi ban sakta
        View parent = destination;
        while (parent != null) {
            if (parent == child) return false;
            parent = (View) (parent.getParent() instanceof View ? parent.getParent() : null);
        }

        // ScrollView / HorizontalScrollView — single child restriction
        if (destination instanceof ScrollView || destination instanceof HorizontalScrollView) {
            int realChildCount = 0;
            for (int i = 0; i < destination.getChildCount(); i++) {
                if (destination.getChildAt(i) != placeHolder) {
                    realChildCount++;
                }
            }
            if (realChildCount >= 1 && child != placeHolder) {
                showSingleChildWarning(destination);
                return false;
            }
        }

        return true;
    }

    private void showSingleChildWarning(ViewGroup destination) {
        String name = destination instanceof HorizontalScrollView
            ? "HorizontalScrollView"
            : "ScrollView";
        android.widget.Toast.makeText(
            context,
            name + " mein sirf ek child ho sakta hai",
            android.widget.Toast.LENGTH_SHORT
        ).show();
    }

    // ============================================================
    // Insert Index Calculation
    // ============================================================

    /**
     * Computes the correct insertion index inside {@code parent} based on drag coordinates.
     *
     * <p>For {@link LinearLayout}, uses midpoint of each child along the main axis.
     * For all other ViewGroups, appends at the end.
     */
    public int getInsertIndex(ViewGroup parent, DragEvent event) {
        if (!(parent instanceof LinearLayout)) {
            return parent.getChildCount();
        }

        LinearLayout ll          = (LinearLayout) parent;
        boolean      isVertical  = ll.getOrientation() == LinearLayout.VERTICAL;
        int          insertIndex = 0;

        for (int i = 0; i < ll.getChildCount(); i++) {
            View child = ll.getChildAt(i);
            if (child == placeHolder) continue;

            int center = isVertical
                ? child.getTop()  + child.getHeight() / 2
                : child.getLeft() + child.getWidth()  / 2;

            float pos = isVertical ? event.getY() : event.getX();
            if (center < (int) pos) insertIndex++;
            else break;
        }

        return Math.min(insertIndex, parent.getChildCount());
    }

    // ============================================================
    // Placeholder Management
    // ============================================================

    private void insertPlaceholder(ViewGroup destination, DragEvent event) {
        safeRemoveView(placeHolder);
        if (!canAcceptChild(destination, placeHolder)) return;
        int idx = getInsertIndex(destination, event);
        addViewSafe(placeHolder, destination, idx);
    }

    // ============================================================
    // Delete Target
    // ============================================================

    private boolean isOverDeleteTarget(DragEvent event) {
        if (deleteTarget == null
                || deleteTarget.getVisibility() != View.VISIBLE) return false;

        int[] deleteLoc = new int[2];
        deleteTarget.getLocationOnScreen(deleteLoc);

        View rootView = editorLayout.getRootView();
        int[] rootLoc = new int[2];
        rootView.getLocationOnScreen(rootLoc);

        float screenX = event.getX() + rootLoc[0];
        float screenY = event.getY() + rootLoc[1];

        return screenX >= deleteLoc[0]
            && screenX <= deleteLoc[0] + deleteTarget.getWidth()
            && screenY >= deleteLoc[1]
            && screenY <= deleteLoc[1] + deleteTarget.getHeight();
    }
private void highlightDeleteTarget(boolean highlight) {
    if (deleteTarget == null) return;

    ImageView img = (ImageView) deleteTarget;

    if (highlight) {
        img.setColorFilter(0xFFFF4444, PorterDuff.Mode.SRC_ATOP);
        img.setScaleX(1.2f);
        img.setScaleY(1.2f);
    } else {
        img.setColorFilter(0xFF757575, PorterDuff.Mode.SRC_ATOP);
        img.setScaleX(1f);
        img.setScaleY(1f);
    }
}
    // ============================================================
    // Safe ViewGroup Helpers
    // ============================================================

    /** Crash-safe removeView — parent null ya view detached ho toh kuch nahi karta. */
    public static void safeRemoveView(View view) {
        if (view == null) return;
        ViewGroup parent = (ViewGroup) (view.getParent() instanceof ViewGroup
            ? view.getParent() : null);
        if (parent != null) {
            parent.removeView(view);
        }
    }

    /** Crash-safe addView with index clamping. */
    public static void addViewSafe(View view, ViewGroup parent, int index) {
        if (view == null || parent == null) return;
        // Agar view already is parent mein hai to pehle remove karo
        if (view.getParent() == parent) {
            parent.removeView(view);
        }
        int safeIndex = Math.min(Math.max(0, index), parent.getChildCount());
        try {
            parent.addView(view, safeIndex);
        } catch (Exception e) {
            Log.e(TAG, "addViewSafe failed: " + e.getMessage(), e);
        }
    }

    /** Crash-safe addView (append). */
    public static void addViewSafe(View view, ViewGroup parent) {
        if (view == null || parent == null) return;
        if (view.getParent() == parent) parent.removeView(view);
        try {
            parent.addView(view);
        } catch (Exception e) {
            Log.e(TAG, "addViewSafe (append) failed: " + e.getMessage(), e);
        }
    }

    // ============================================================
    // FrameLayout Gravity Helper
    // ============================================================

    /** Drag position se FrameLayout gravity determine karta hai. */
    public static int gravityForFrameLayout(FrameLayout frame, DragEvent event) {
        int gravity = 0;
        int posX    = (int) event.getX();
        int posY    = (int) event.getY();
        int w       = frame.getWidth();
        int h       = frame.getHeight();

        if      (posX < w / 3)     gravity |= Gravity.LEFT;
        else if (posX > 2 * w / 3) gravity |= Gravity.RIGHT;
        else                        gravity |= Gravity.CENTER_HORIZONTAL;

        if      (posY < h / 3)     gravity |= Gravity.TOP;
        else if (posY > 2 * h / 3) gravity |= Gravity.BOTTOM;
        else                        gravity |= Gravity.CENTER_VERTICAL;

        return gravity;
    }
}
