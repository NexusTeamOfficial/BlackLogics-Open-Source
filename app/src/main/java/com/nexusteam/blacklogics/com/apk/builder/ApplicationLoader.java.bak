package com.apk.builder;

import android.app.Activity;
import android.app.Application;
import android.app.Application.ActivityLifecycleCallbacks;
import android.os.Bundle;
import android.app.Application;
import android.app.PendingIntent;
import android.app.AlarmManager;
import android.content.SharedPreferences;
import androidx.appcompat.app.AppCompatDelegate;
import android.content.Context;
import android.content.Intent;
import android.os.Handler;
import android.os.SystemClock;

import androidx.multidex.MultiDex;

import java.io.PrintWriter;
import java.io.StringWriter;
import java.io.Writer;

import com.besome.blacklogics.development.Complex;

public class ApplicationLoader extends Application {
	
	private Thread.UncaughtExceptionHandler uncaughtExceptionHandler;
	
	public static Context applicationContext;
	public static volatile Handler applicationHandler;
	
	public static Complex complex = new Complex();
	
	private static final String CRASH_PREF = "crash_guard";
	private static final String LAST_CRASH = "last_crash_time";
	
	@Override
protected void attachBaseContext(android.content.Context base) {

    android.content.SharedPreferences sp =
            base.getSharedPreferences(
                    "LANG",
                    android.content.Context.MODE_PRIVATE
            );

    String lang = sp.getString("lang", "en");

    android.content.Context localeContext =
            com.nexusteam.blacklogics.utils.LocaleHelper
                    .setLocale(base, lang);

    super.attachBaseContext(localeContext);

    androidx.multidex.MultiDex.install(localeContext);
}
	@Override
public void onCreate() {
    super.onCreate();

    com.apk.builder.ApplicationLoader.applicationContext = this;
    com.apk.builder.ApplicationLoader.applicationHandler =
            new android.os.Handler(getMainLooper());

    com.apk.builder.ApplicationLoader.complex
            .setC(getApplicationContext());

    registerActivityLifecycleCallbacks(
        new android.app.Application.ActivityLifecycleCallbacks() {

            @Override
            public void onActivityCreated(
                    final android.app.Activity activity,
                    android.os.Bundle savedInstanceState) {

                // ✅ Edge-to-edge ONLY Android 11+
                if (android.os.Build.VERSION.SDK_INT >= 30) {
                    activity.getWindow()
                            .setDecorFitsSystemWindows(false);
                }

                final android.view.View rootView =
                        activity.findViewById(android.R.id.content);

                if (rootView != null &&
                    android.os.Build.VERSION.SDK_INT >= 30) {

                    rootView.setOnApplyWindowInsetsListener(
                        new android.view.View.OnApplyWindowInsetsListener() {
                            @Override
                            public android.view.WindowInsets onApplyWindowInsets(
                                    android.view.View v,
                                    android.view.WindowInsets insets) {

                                android.graphics.Insets bars =
                                        insets.getInsets(
                                                android.view.WindowInsets
                                                        .Type.systemBars());

                                v.setPadding(
                                        bars.left,
                                        bars.top,
                                        bars.right,
                                        bars.bottom
                                );
                                return insets;
                            }
                        }
                    );
                }
            }

            @Override
            public void onActivityStarted(android.app.Activity activity) {
                com.nexusteam.internal.AppLifecycleTracker
                        .setCurrentActivity(activity);
            }

            @Override
            public void onActivityResumed(android.app.Activity activity) {
                com.nexusteam.internal.AppLifecycleTracker
                        .setCurrentActivity(activity);
            }

            @Override public void onActivityPaused(android.app.Activity activity) {}
            @Override public void onActivityStopped(android.app.Activity activity) {}
            @Override public void onActivitySaveInstanceState(
                    android.app.Activity activity,
                    android.os.Bundle outState) {}
            @Override public void onActivityDestroyed(android.app.Activity activity) {}
        }
    );

    // ✅ SINGLE crash handler (Android 8–16)
    uncaughtExceptionHandler =
            Thread.getDefaultUncaughtExceptionHandler();

    Thread.setDefaultUncaughtExceptionHandler(
        new Thread.UncaughtExceptionHandler() {
            @Override
            public void uncaughtException(Thread thread, Throwable ex) {
                try {
                    if (isCrashLoop()) {
                        uncaughtExceptionHandler
                                .uncaughtException(thread, ex);
                        return;
                    }

                    Throwable root = getRootCause(ex);
                    String report = buildCrashReport(ex, root);

                    android.content.Intent intent =
                            new android.content.Intent(
                                    getApplicationContext(),
                                    com.nexusteam.blacklogics.DebugActivity.class
                            );
                    intent.setFlags(
                            android.content.Intent.FLAG_ACTIVITY_NEW_TASK |
                            android.content.Intent.FLAG_ACTIVITY_CLEAR_TASK
                    );
                    intent.putExtra("error", report);

                    int piFlags =
                            android.app.PendingIntent.FLAG_ONE_SHOT;
                    if (android.os.Build.VERSION.SDK_INT >= 23) {
                        piFlags |= android.app.PendingIntent.FLAG_IMMUTABLE;
                    }

                    android.app.PendingIntent pendingIntent =
                            android.app.PendingIntent.getActivity(
                                    getApplicationContext(),
                                    11111,
                                    intent,
                                    piFlags
                            );

                    android.app.AlarmManager am =
                            (android.app.AlarmManager)
                                    getSystemService(
                                            android.content.Context.ALARM_SERVICE
                                    );

                    if (am != null) {
                        am.setExact(
                                android.app.AlarmManager
                                        .ELAPSED_REALTIME_WAKEUP,
                                android.os.SystemClock
                                        .elapsedRealtime() + 800,
                                pendingIntent
                        );
                    }

                } catch (Throwable ignored) {}

                android.os.Process.killProcess(
                        android.os.Process.myPid());
                System.exit(2);
            }
        }
    );

    applyTheme();
}
	
	
	private String buildCrashReport(Throwable ex, Throwable root) {
		StringBuilder sb = new StringBuilder();
		
		sb.append("🔥 APP CRASHED\n\n");
		
		
		if (ex instanceof StackOverflowError) {
			sb.append("TYPE: StackOverflowError\n");
			sb.append("REASON: Infinite recursion / loop\n\n");
		} else if (ex instanceof VerifyError ||
		ex instanceof NoClassDefFoundError ||
		ex instanceof IncompatibleClassChangeError) {
			sb.append("TYPE: Dex / Bytecode / Obfuscation Error\n\n");
		} else {
			sb.append("TYPE: ").append(ex.getClass().getName()).append("\n\n");
		}
		
		
		sb.append("📌 ROOT CAUSE\n");
		sb.append(root.getClass().getName()).append("\n");
		sb.append(root.getMessage()).append("\n\n");
		
		
		StackTraceElement line = findUsefulLine(root.getStackTrace());
		if (line != null) {
			sb.append("📍 LOCATION\n");
			sb.append(line.getClassName())
			.append(".")
			.append(line.getMethodName())
			.append(" (")
			.append(line.getFileName())
			.append(":")
			.append(line.getLineNumber())
			.append(")\n\n");
		}
		
		sb.append("🧵 FULL STACKTRACE\n");
		sb.append(getStackTrace(ex));
		
		return sb.toString();
	}
	
	private StackTraceElement findUsefulLine(StackTraceElement[] stack) {
		for (StackTraceElement e : stack) {
			if (e.getClassName().startsWith("com.")) {
				return e;
			}
		}
		return stack.length > 0 ? stack[0] : null;
	}
	
	private Throwable getRootCause(Throwable th) {
		Throwable cause = th;
		while (cause.getCause() != null && cause.getCause() != cause) {
			cause = cause.getCause();
		}
		return cause;
	}
	
	private String getStackTrace(Throwable th) {
		Writer result = new StringWriter();
		PrintWriter pw = new PrintWriter(result);
		th.printStackTrace(pw);
		pw.close();
		return result.toString();
	}
	
	
	
	private boolean isCrashLoop() {
		SharedPreferences sp = getSharedPreferences(CRASH_PREF, MODE_PRIVATE);
		long last = sp.getLong(LAST_CRASH, 0);
		long now = System.currentTimeMillis();
		
		sp.edit().putLong(LAST_CRASH, now).apply();
		return (now - last) < 4000; // 4 sec
	}
	
	
	
	private void applyTheme() {
		SharedPreferences prefs =
		getSharedPreferences("AppSettings", MODE_PRIVATE);
		
		int themeMode = prefs.getInt("theme_mode", 0); // default = follow system
		
		switch (themeMode) {
			case 1:
			AppCompatDelegate.setDefaultNightMode(
			AppCompatDelegate.MODE_NIGHT_NO
			);
			break;
			
			case 2:
			AppCompatDelegate.setDefaultNightMode(
			AppCompatDelegate.MODE_NIGHT_YES
			);
			break;
			
			default:
			AppCompatDelegate.setDefaultNightMode(
			AppCompatDelegate.MODE_NIGHT_FOLLOW_SYSTEM
			);
			break;
		}
	}
	
	
	
	public static Context getContext() {
		return applicationContext;
	}
}
