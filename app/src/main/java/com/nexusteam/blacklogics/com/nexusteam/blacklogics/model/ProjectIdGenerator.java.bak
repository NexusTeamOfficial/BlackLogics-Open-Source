
package com.nexusteam.blacklogics.model;

import android.os.Environment;

import java.io.File;

/**
 * BLACKLOGICS – NEW PROJECT ID GENERATOR
 * Generates unique sc_id starting from 601 onwards
 * Only counts numeric project folders >= 600 (e.g., 600, 601, 700, 1000)
 * Ignores: <600, non-numeric, files, hidden folders
 *
 * Copyright (c) 2025 NexusTeam & SmartIndiaGaming
 * All rights reserved.
 * This code is part of BlackLogics
 * Unauthorized distribution or modification is strictly prohibited.
 */
public class ProjectIdGenerator {
    
    /**
     * Returns next available project ID as String (e.g., "603")
     * Ensures ID >= 601 and avoids duplicates
     */
    public static String getNewScId() {
        int nextNum = getNextProjectNumber();
        int projectId = 601 + nextNum;
        return String.valueOf(projectId);
    }
    
    /**
     * Counts only valid project folders with numeric names >= 600
     *
     * @return Count of valid projects (0 if none)
     */
    private static int getNextProjectNumber() {
        File projectsDir = new File("/storage/emulated/0", ".blacklogics/data/");
        
        if (!projectsDir.exists() || !projectsDir.isDirectory()) {
            return 0;
        }
        
        File[] files = projectsDir.listFiles();
        if (files == null) return 0;
        
        int count = 0;
        for (File file : files) {
            if (file.isDirectory()) {
                String name = file.getName().trim();
                if (name.matches("\\d+")) {
                    try {
                        int id = Integer.parseInt(name);
                        if (id >= 600) {
                            count++;
                        }
                    } catch (NumberFormatException ignored) {
                    }
                }
            }
        }
        return count;
    }
}