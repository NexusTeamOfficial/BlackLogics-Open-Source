	// ============================================================
	// Custom Attributes Dialog (reflection)
	// ============================================================
	
	public void showCustomAttributesDialog(final View view) {
		final AlertDialog dialog = new AlertDialog.Builder(getContext()).create();
		View inflated = LayoutInflater.from(getContext()).inflate(R.layout.custom_methods, null);
		dialog.setView(inflated);
		
		final EditText etMemberName    = inflated.findViewById(R.id.et_function_name);
		final EditText etMemberValue   = inflated.findViewById(R.id.et_function_value);
		final Spinner  spinnerType     = inflated.findViewById(R.id.spinner);
		final Button   btnApply        = inflated.findViewById(R.id.apply);
		final CheckBox cbField         = inflated.findViewById(R.id.cb_field);
		final CheckBox cbLayoutParams  = inflated.findViewById(R.id.cb_layout_params);
		
		ArrayList<String> typesList = new ArrayList<>(Arrays.asList(
		"boolean", "int", "float", "CharSequence", "String", "color"));
		
		etMemberName.setFocusableInTouchMode(true);
		etMemberValue.setFocusableInTouchMode(true);
		spinnerType.setAdapter(new ArrayAdapter<String>(
		getContext(), android.R.layout.simple_spinner_dropdown_item, typesList));
		
		btnApply.setOnClickListener(new View.OnClickListener() {
			@Override
			public void onClick(View v) {
				String memberName = etMemberName.getText().toString();
				String rawValue   = etMemberValue.getText().toString();
				Class<?> argClass = null;
				Object   argValue = null;
				
				try {
					switch (spinnerType.getSelectedItemPosition()) {
						case 0: argClass = boolean.class;     argValue = rawValue.equals("true"); break;
						case 1: argClass = int.class;         argValue = Integer.parseInt(rawValue); break;
						case 2: argClass = float.class;       argValue = Float.parseFloat(rawValue); break;
						case 3: argClass = CharSequence.class; argValue = rawValue; break;
						case 4: argClass = String.class;      argValue = rawValue; break;
						case 5: argClass = int.class;         argValue = Color.parseColor(rawValue); break;
					}
					
					Object target = cbLayoutParams.isChecked() ? view.getLayoutParams() : view;
					if (cbField.isChecked()) {
						ReflectionUtils.setField(target, memberName, argValue);
						view.requestLayout();
					} else {
						ReflectionUtils.invokeMethod(target, memberName, argValue);
					}
				} catch (Exception e) {
					showMessage(e.toString());
				}
			}
		});
		
		dialog.show();
	}
	
	// ============================================================
	// Listeners (Events Tab)
	// ============================================================
	
	/** Builds the events list appropriate for the given widget type. */
	private ArrayList<HashMap<String, Object>> buildListenersForView(View view) {
		ArrayList<HashMap<String, Object>> list = new ArrayList<>();
		String type = view.getClass().getSimpleName().toLowerCase();
		
		list.add(createListenerEntry("onClick",    "View.OnClickListener"));
		list.add(createListenerEntry("onLongPress","View.OnLongPressListener"));
		list.add(createListenerEntry("onTouch",    "View.OnTouchListener"));
		
		if (type.contains("edittext") || type.contains("textview")) {
			list.add(createListenerEntry("onTextChanged",    "TextWatcher"));
			list.add(createListenerEntry("afterTextChanged", "TextWatcher"));
		}
		if (type.contains("button") || type.contains("imagebutton")) {
			list.add(createListenerEntry("onLongClick", "View.OnLongClickListener"));
		}
		if (type.contains("seekbar")) {
			list.add(createListenerEntry("onProgressChanged",    "SeekBar.OnSeekBarChangeListener"));
			list.add(createListenerEntry("onStartTrackingTouch", "SeekBar.OnSeekBarChangeListener"));
			list.add(createListenerEntry("onStopTrackingTouch",  "SeekBar.OnSeekBarChangeListener"));
		}
		if (type.contains("checkbox") || type.contains("switch") || type.contains("togglebutton")) {
			list.add(createListenerEntry("onCheckedChanged", "CompoundButton.OnCheckedChangeListener"));
		}
		if (type.contains("listview") || type.contains("recyclerview")) {
			list.add(createListenerEntry("onItemClick",     "AdapterView.OnItemClickListener"));
			list.add(createListenerEntry("onItemLongClick", "AdapterView.OnItemLongClickListener"));
		}
		if (type.contains("spinner")) {
			list.add(createListenerEntry("onItemSelected",  "AdapterView.OnItemSelectedListener"));
			list.add(createListenerEntry("onNothingSelected","AdapterView.OnItemSelectedListener"));
		}
		if (type.contains("viewpager")) {
			list.add(createListenerEntry("onPageSelected",          "ViewPager.OnPageChangeListener"));
			list.add(createListenerEntry("onPageScrolled",          "ViewPager.OnPageChangeListener"));
			list.add(createListenerEntry("onPageScrollStateChanged","ViewPager.OnPageChangeListener"));
		}
		if (type.contains("scrollview")) {
			list.add(createListenerEntry("onScrollChanged", "ViewTreeObserver.OnScrollChangedListener"));
		}
		if (type.contains("ratingbar")) {
			list.add(createListenerEntry("onRatingChanged", "RatingBar.OnRatingBarChangeListener"));
		}
		if (type.contains("textinput")) {
			list.add(createListenerEntry("onTextChanged", "TextWatcher"));
		}
		if (type.contains("webview")) {
			list.add(createListenerEntry("onPageStarted",              "WebViewClient"));
			list.add(createListenerEntry("onPageFinished",             "WebViewClient"));
			list.add(createListenerEntry("shouldOverrideUrlLoading",   "WebViewClient"));
		}
		return list;
	}
	
	private HashMap<String, Object> createListenerEntry(String name, String type) {
		HashMap<String, Object> entry = new HashMap<>();
		entry.put("name", name);
		entry.put("type", type);
		return entry;
	}
	
	/** Opens Logic Editor for the selected listener. */
	private void openLogicEditorForListener(View view, HashMap<String, Object> listener) {
		DesignActivity da = (DesignActivity) getContext();
		saveLayout(ProjectDataHelper.getActivityName(getContext()));
		
		String listenerName = listener.get("name").toString();
		String listenerType = listener.get("type").toString();
		
		// Persist widget→listener mapping
		String baseDataPath = FileUtil.getExternalStorageDir()
		.concat("/.blacklogics/data/").concat(SC_ID).concat("/basedata");
		
		if (FileUtil.isExistFile(baseDataPath)) {
			list_widget_map = new Gson().fromJson(
			FileUtil.readFile(baseDataPath),
			new TypeToken<ArrayList<HashMap<String, Object>>>() {}.getType());
		} else {
			list_widget_map = new ArrayList<>();
		}
		
		widget_add_map = new HashMap<>();
		widget_add_map.put("widget_id",           idManager.getId(view));
		widget_add_map.put("widget_type",          getWidgetTypeName(view));
		widget_add_map.put("widget_listener_name", listenerName);
		widget_add_map.put("activityName",         ProjectDataHelper.getActivityName(getContext()));
		
		boolean alreadyExists = false;
		for (HashMap<String, Object> item : list_widget_map) {
			if (item.get("widget_id").equals(widget_add_map.get("widget_id"))
			&& item.get("widget_listener_name").equals(widget_add_map.get("widget_listener_name"))
			&& item.get("activityName").equals(widget_add_map.get("activityName"))) {
				alreadyExists = true;
				break;
			}
		}
		if (!alreadyExists) {
			list_widget_map.add(widget_add_map);
			FileUtil.writeFile(baseDataPath, new Gson().toJson(list_widget_map));
		}
		
		String viewId       = idManager.getId(view);
		String activityName = ProjectDataHelper.getActivityName(getContext());
		
		intent.putExtra("id",           viewId);
		intent.putExtra("event",        listenerName);
		intent.putExtra("event_text",   viewId);
		intent.putExtra("filename",     viewId + activityName + listenerName);
		intent.putExtra("sc_id",        ProjectDataHelper.getScId(getContext()));
		intent.putExtra("activityName", activityName);
		intent.putExtra("widgetid",     viewId);
		intent.putExtra("type",         "");
		intent.putExtra("project_file", (android.os.Parcelable) getFileBean());
		intent.setClass(getContext(), com.nexusteam.internal.editor.LogicEditorActivity.class);
		getContext().startActivity(intent);
	}
	private com.nexusteam.internal.beans.ProjectFileBean getFileBean() {
		if (getContext() instanceof com.besome.blacklogics.lib.base.BaseActivity) {
			return ((com.besome.blacklogics.lib.base.BaseActivity) getContext()).fileBean;
		}
		return null;
	}
	// ============================================================
	// Listener Adapter
	// ============================================================
	
	public class ListenerRecyclerAdapter
	extends RecyclerView.Adapter<ListenerRecyclerAdapter.ViewHolder> {
		
		private final ArrayList<HashMap<String, Object>> data;
		private final Context context;
		private AttributeRecyclerAdapter.OnItemClickListener listener;
		
		public ListenerRecyclerAdapter(Context context,
		ArrayList<HashMap<String, Object>> data) {
			this.context = context;
			this.data    = data;
		}
		
		public void setOnItemClickListener(AttributeRecyclerAdapter.OnItemClickListener l) {
			this.listener = l;
		}
		
		@NonNull
		@Override
		public ViewHolder onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {
			View view = LayoutInflater.from(context)
			.inflate(R.layout.attribute_view, parent, false);
			return new ViewHolder(view);
		}
		
		@Override
		public void onBindViewHolder(@NonNull final ViewHolder holder, final int position) {
			holder.tvName.setText(data.get(position).get("name").toString());
			holder.ivIcon.setVisibility(View.GONE);
			holder.itemView.setOnClickListener(new View.OnClickListener() {
				@Override
				public void onClick(View v) {
					if (listener != null) listener.onItemClick(position);
				}
			});
		}
		
		@Override
		public int getItemCount() { return data.size(); }
		
		public class ViewHolder extends RecyclerView.ViewHolder {
			final TextView  tvName;
			final ImageView ivIcon;
			public ViewHolder(@NonNull View itemView) {
				super(itemView);
				tvName = itemView.findViewById(R.id.tv_name);
				ivIcon = itemView.findViewById(R.id.iv_icon);
			}
		}
	}
	
	// ============================================================
	// Widget Palette Adapter
	// ============================================================
	
	public class WidgetPaletteAdapter
	extends RecyclerView.Adapter<WidgetPaletteAdapter.ViewHolder> {
		
		private final Context context;
		private final ArrayList<HashMap<String, Object>> data;
		
		public WidgetPaletteAdapter(Context context,
		ArrayList<HashMap<String, Object>> data) {
			this.context = context;
			this.data    = data;
		}
		
		@NonNull
		@Override
		public ViewHolder onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {
			View v = LayoutInflater.from(context)
			.inflate(R.layout.list_widget, parent, false);
			return new ViewHolder(v);
		}
		
		@Override
		public void onBindViewHolder(@NonNull final ViewHolder holder, final int position) {
			HashMap<String, Object> item = data.get(position);
			
			int padding   = TheBlockLogicsUtil.getDip(context, 2);
			int iconPad   = TheBlockLogicsUtil.getDip(context, 2);
			
			GradientDrawable bg = TheBlockLogicsUtil.getGradient(
			context, 1, Color.parseColor("#DDDDDD"), -1);
			bg.setCornerRadius(0f);
			
			holder.linMain.setElevation(2f);
			holder.linMain.setGravity(Gravity.CENTER_VERTICAL);
			holder.linMain.setPadding(padding, padding, padding, padding);
			holder.ivIcon.setPadding(iconPad, iconPad, iconPad, iconPad);
			
			if (item.containsKey("icon")) {
				String iconName = item.get("icon").toString();
				int resId = context.getResources().getIdentifier(
				iconName, "drawable", context.getPackageName());
				if (resId != 0) {
					holder.ivIcon.setImageResource(resId);
					holder.ivIcon.setVisibility(View.VISIBLE);
				} else {
					holder.ivIcon.setVisibility(View.GONE);
				}
			} else {
				holder.ivIcon.setVisibility(View.GONE);
			}
			
			String name = item.containsKey("name")
			? item.get("name").toString() : "LinearLayout";
			holder.tvName.setText(name);
			holder.tvName.setTextColor(Color.parseColor("#555555"));
			holder.tvName.setTextSize(TypedValue.COMPLEX_UNIT_SP, 10);
			holder.tvName.setSingleLine();
			
			holder.linMain.setOnLongClickListener(new View.OnLongClickListener() {
				@Override
				public boolean onLongClick(View v) {
					unselectSelectedWidget();
					DragAndDropUtils.startDragAndDrop(
					v, null,
					new View.DragShadowBuilder(holder.linMain),
					data.get(position), 1);
					unselectSelectedWidget();
					return true;
				}
			});
		}
		
		@Override
		public int getItemCount() { return data.size(); }
		
		public class ViewHolder extends RecyclerView.ViewHolder {
			final LinearLayout linMain;
			final TextView     tvName;
			final ImageView    ivIcon;
			
			public ViewHolder(@NonNull View itemView) {
				super(itemView);
				linMain = itemView.findViewById(R.id.lin_main);
				tvName  = itemView.findViewById(R.id.title);
				ivIcon  = itemView.findViewById(R.id.icon);
			}
		}
	}
	
	// ============================================================
	// Attribute Reloading
	// ============================================================
	
	private void reloadAttributesForView(View view,
	RecyclerView rvAttributes,
	ArrayList<HashMap<String, Object>> attributesList) {
		attributesList.clear();
		Class<?> cls  = view.getClass();
		Class<?> stop = View.class.getSuperclass();
		
		while (cls != stop) {
			ArrayList<HashMap<String, Object>> temp = attributesMap.get(cls.getName());
			if (temp != null) attributesList.addAll(0, temp);
			cls = cls.getSuperclass();
		}
		
		if (view.getParent() instanceof ViewGroup) {
			cls = view.getParent().getClass();
			while (cls != stop) {
				ArrayList<HashMap<String, Object>> temp = parentAttributesMap.get(cls.getName());
				if (temp != null) attributesList.addAll(temp);
				cls = cls.getSuperclass();
			}
		}
		
		rvAttributes.getAdapter().notifyDataSetChanged();
	}
	
	// ============================================================
	// Selection Highlight
	// ============================================================
	
	private void highlightWidget(View view) {
		if (selectedView != null && selectedView != view) {
			Drawable original = originalBackgrounds.get(selectedView);
			selectedView.setBackground(original != null ? original : null);
		}
		
		selectedView = view;
		
		if (!originalBackgrounds.containsKey(view)) {
			Drawable bg = view.getBackground();
			originalBackgrounds.put(view,
			(bg != null && bg.getConstantState() != null)
			? bg.getConstantState().newDrawable().mutate()
			: bg);
		}
		
		applyHighlightDrawable(view);
		
		ObjectAnimator animator = ObjectAnimator.ofFloat(view, "alpha", 0.85f, 1f);
		animator.setDuration(180);
		animator.start();
	}
	
	private void applyHighlightDrawable(View view) {
		GradientDrawable highlight = new GradientDrawable();
		highlight.setColor(Color.parseColor("#77BBCCDD"));
		highlight.setCornerRadius(8f);
		view.setBackground(highlight);
	}
	
	// ============================================================
	// Properties Panel
	// ============================================================
	
	/**
* Animates the attributes panel into view using a vertical slide-in.
*/	
	public void showProperties() {
		LinearLayoutCompat panel = attributesContainer;
		panel.setVisibility(View.VISIBLE);
		slideAnimator.setTarget(panel);
		slideAnimator.setProperty(View.TRANSLATION_Y);
		slideAnimator.setFloatValues(0f);
		slideAnimator.setInterpolator(new DecelerateInterpolator());
		slideAnimator.start();
	}
	
	/**
* Animates the attributes panel out of view and clears the current widget selection.
*/	
	public void hideProperties() {
		unselectSelectedWidget();
		LinearLayoutCompat panel = attributesContainer;
		slideAnimator.setTarget(panel);
		slideAnimator.setProperty(View.TRANSLATION_Y);
		slideAnimator.setFloatValues((float) panel.getHeight());
		slideAnimator.setInterpolator(new DecelerateInterpolator());
		slideAnimator.start();
	}
	
	/**
* Restores the previously selected widget's original background and clears
* the internal selection reference.
*/	
	public void unselectSelectedWidget() {
		if (selectedView != null) {
			AttributeSet set = attributesValueMap.get(selectedView);
			if (set != null) {
				Attribute bgAttr = set.getAttribute("android:background");
				if (bgAttr != null) {
					try {
						selectedView.setBackgroundColor(Color.parseColor(bgAttr.getValue()));
					} catch (Exception ignored) {}
				} else {
					Drawable original = originalBackgrounds.get(selectedView);
					selectedView.setBackground(original);
				}
			}
			selectedView = null;
		}
	}
	
	public boolean isHiddenProperties() {
		return attributesContainer.getTranslationY() == (float) attributesContainer.getHeight();
	}
	
	// ============================================================
	// Undo / Redo
	// ============================================================
	
	// ============================================================
	// Undo / Redo  (StableUndoManager powered)
	// ============================================================
	
	/**
* Reverts the most recent editor action for the current activity.
*
* @return {@code true} if an undo action was available and performed
*/	
	public boolean undo() {
		isUndoRedoInProgress = true;
		try {
			return stableUndoManager.undo(getCurrentActivityName());
		} finally {
			isUndoRedoInProgress = false;
		}
	}
	
	/**
* Re-applies the most recently undone editor action.
*
* @return {@code true} if a redo action was available and performed
*/	
	public boolean redo() {
		isUndoRedoInProgress = true;
		try {
			return stableUndoManager.redo(getCurrentActivityName());
		} finally {
			isUndoRedoInProgress = false;
		}
	}
	
	/** @return true if undo is available */
	public boolean canUndo() {
		return stableUndoManager.canUndo(getCurrentActivityName());
	}
	
	/** @return true if redo is available */
	public boolean canRedo() {
		return stableUndoManager.canRedo(getCurrentActivityName());
	}
	
	/**
* Captures the current editor canvas state as an undo snapshot.
* Legacy method — internally delegates to StableUndoManager snapshot command.
*
* @param actionType a descriptive label for the action
*/	
	public void saveStateForUndo(String actionType) {
		if (isUndoRedoInProgress) return;
		// Legacy UndoManager bhi update karo (backward compat)
		ViewAction action = new ViewAction.Builder()
		.setType(ActionType.UPDATE_ATTRIBUTE)
		.setEditor(this)
		.setActivityName(getCurrentActivityName())
		.setOldAttributes(null)
		.setNewAttributes(null)
		.build();
		undoManager.pushAction(action);
	}
	
	// ============================================================
	// View Mutation with Undo
	// ============================================================
	
	/**
* Removes a view from the editor canvas and records a command to support undo.
*
* @param view the view to remove
*/	
	public void removeViewWithUndo(View view) {
		if (isUndoRedoInProgress) return;
		
		ViewGroup parent  = (ViewGroup) view.getParent();
		if (parent == null) return;
		int       index   = parent.indexOfChild(view);
		
		// ✅ StableUndoManager command push
		stableUndoManager.push(getCurrentActivityName(),
		new StableUndoManager.RemoveViewCommand(view, parent, index));
		
		parent.removeView(view);
		idManager.remove(view);
		attributesValueMap.remove(view);
	}
	
	/**
* Adds a view to a parent container at the specified index and records a command for undo.
*
* @param view   the view to add
* @param parent the destination container
* @param index  the insertion index within the parent
*/	
	public void addViewWithUndo(View view, ViewGroup parent, int index) {
		if (isUndoRedoInProgress) return;
		
		// ✅ StableUndoManager command push
		stableUndoManager.push(getCurrentActivityName(),
		new StableUndoManager.AddViewCommand(view, parent, index));
	}
	
	// ============================================================
	// Save / Load
	// ============================================================
	
	/**
* Serializes the current editor canvas to XML and persists it using
* {@link LayoutStorage} with AES encryption.
*
* @param layoutName the activity/layout name to save under
*/	
	public void saveLayout(String layoutName) {
		if (layoutName == null || layoutName.trim().isEmpty()) return;
		if (editorLayout.getChildCount() == 0) return;
		
		try {
			String xml = generateLayoutXml();
			xml = cleanXML(xml);
			if (!validateXML(xml)) return;

			// ✅ Crash Recovery Backup: main save se pehle backup banao
			saveBackup(layoutName, xml);

			LayoutStorage.save(new File(SAVE_PATH), layoutName, xml, ENC_PASSWORD);
		} catch (Exception e) {
			Log.e("ViewEditor", "saveLayout failed", e);
		}
	}

	// ============================================================
	// Crash Recovery Backup System
	// ============================================================

	/**
	 * Backup save karta hai plain XML as:
	 * /storage/emulated/0/.blacklogics/bak/{SC_ID}/{layoutName}.xml
	 * Yeh backup crash ke case mein auto-restore ke liye use hoga.
	 */
	private void saveBackup(String layoutName, String xml) {
		try {
			String backupDir = "/storage/emulated/0/.blacklogics/bak/" + SC_ID + "/";
			File dir = new File(backupDir);
			if (!dir.exists()) dir.mkdirs();
			File backupFile = new File(dir, layoutName + ".xml");
			java.io.FileOutputStream fos = new java.io.FileOutputStream(backupFile);
			fos.write(xml.getBytes("UTF-8"));
			fos.close();
			Log.d("ViewEditor", "Backup saved: " + backupFile.getAbsolutePath());
		} catch (Exception e) {
			Log.w("ViewEditor", "saveBackup failed (non-critical): " + e.getMessage());
		}
	}

	/**
	 * Checks if a crash-recovery backup exists for the given layout.
	 * Call this from DesignActivity / app start pe:
	 *   viewEditor.checkAndRestoreBackup(activityName);
	 *
	 * Agar backup milti hai toh dialog dikhata hai:
	 * "Pichli baar crash hua. Restore karo?"
	 *
	 * @param layoutName the activity/layout name to check backup for
	 */
	public void checkAndRestoreBackup(final String layoutName) {
		if (layoutName == null || layoutName.trim().isEmpty()) return;

		final String backupPath = "/storage/emulated/0/.blacklogics/bak/" + SC_ID + "/" + layoutName + ".xml";
		final File backupFile = new File(backupPath);
		if (!backupFile.exists()) return;

		// Main layout file ka last-modified se compare karo
		File mainFile = new File(SAVE_PATH);
		boolean backupIsNewer = backupFile.lastModified() > mainFile.lastModified() + 2000;

		if (!backupIsNewer) {
			// Backup outdated — silently delete karo
			backupFile.delete();
			return;
		}

		// Crash ke signs hain — user se pucho
		try {
			new MaterialAlertDialogBuilder(getContext(),
					com.google.android.material.R.style.ThemeOverlay_Material3_MaterialAlertDialog_Centered)
				.setTitle("Crash Recovery")
				.setMessage("App pichli baar band hone se pehle \"" + layoutName + "\" ka ek backup mila hai.\n\nKya aap is backup se restore karna chahte hain?")
				.setCancelable(false)
				.setPositiveButton("Restore Karo", new DialogInterface.OnClickListener() {
					@Override
					public void onClick(DialogInterface dialog, int which) {
						restoreFromBackup(layoutName, backupFile);
					}
				})
				.setNegativeButton("Ignore Karo", new DialogInterface.OnClickListener() {
					@Override
					public void onClick(DialogInterface dialog, int which) {
						backupFile.delete();
					}
				})
				.show();
		} catch (Exception e) {
			Log.e("ViewEditor", "checkAndRestoreBackup dialog failed", e);
		}
	}

	/**
	 * Backup XML se canvas restore karta hai aur main layout file bhi update karta hai.
	 */
	private void restoreFromBackup(String layoutName, File backupFile) {
		try {
			byte[] bytes = new byte[(int) backupFile.length()];
			java.io.FileInputStream fis = new java.io.FileInputStream(backupFile);
			fis.read(bytes);
			fis.close();
			String xml = new String(bytes, "UTF-8");

			if (xml.trim().isEmpty() || !validateXML(xml)) {
				SketchwareUtil.showMessage(getContext(), "Backup corrupt hai, restore nahi hua.");
				backupFile.delete();
				return;
			}

			// Canvas reload karo backup se
			loadFromXmlString(xml);

			// Main layout storage bhi update karo
			LayoutStorage.save(new File(SAVE_PATH), layoutName, xml, ENC_PASSWORD);

			backupFile.delete(); // Successfully restored
			SketchwareUtil.showMessage(getContext(), "Backup se restore ho gaya!");
			Log.d("ViewEditor", "Restored from backup: " + layoutName);
		} catch (Exception e) {
			SketchwareUtil.showMessage(getContext(), "Restore failed: " + e.getMessage());
			Log.e("ViewEditor", "restoreFromBackup failed", e);
		}
	}
	
	/**
* Clears the current canvas and loads the specified layout from encrypted
* storage, rebuilding the view hierarchy from XML.
*
* @param layoutName the activity/layout name to load
*/	
	public void loadLayout(String layoutName) {
		editorLayout.removeAllViews();
		if (layoutName == null || layoutName.trim().isEmpty()) return;
		
		// ✅ Layout load hone pe history clear karo (fresh start)
		stableUndoManager.clearHistory(getCurrentActivityName());
		
		try {
			LayoutData data = LayoutStorage.load(
			new File(SAVE_PATH), layoutName, ENC_PASSWORD);
			if (data == null) return;
			
			oldIdManager          = idManager;
			oldAttributesValueMap = new HashMap<>(attributesValueMap);
			idManager             = new IdManager();
			attributesValueMap.clear();
			
			loadFromXml(data.xml);
		} catch (Exception e) {
			restorePreviousStateOnFailure();
			Log.e("ViewEditor", "loadLayout failed", e);
		}
	}
	
	private String readEncryptedJson(File file) throws Exception {
		long modified = file.lastModified();
		if (cachedLayoutJson != null && cacheLastModified == modified) {
			return cachedLayoutJson;
		}
		byte[] decrypted = pq.decryptFromFile(file, ENC_PASSWORD);
		String json = new String(decrypted, "UTF-8");
		cachedLayoutJson    = json;
		cacheLastModified   = modified;
		return json;
	}
	
	// ============================================================
	// XML Generation
	// ============================================================
	
	private String generateLayoutXml() {
		if (editorLayout.getChildCount() == 0) return "";
		
		// editorLayout sirf canvas container hai — XML mein include NAHI hota.
		// Direct children serialize karo. xmlns sirf root element pe aata hai.
		StringBuilder sb = new StringBuilder();
		sb.append("<?xml version=\"1.0\" encoding=\"utf-8\"?>\n");
		
		boolean firstReal = true;
		for (int i = 0; i < editorLayout.getChildCount(); i++) {
			View child = editorLayout.getChildAt(i);
			if (child == placeHolder) continue;
			String code = generateCode(child);
			if (code.trim().isEmpty()) continue;
			if (firstReal) {
				// xmlns:android aur xmlns:app sirf pehle root element pe
				if (!code.contains("xmlns:android")) {
					code = code.replaceFirst(
					"(<[A-Za-z][A-Za-z0-9_.:]*)",
					"$1\n    xmlns:android=\"http://schemas.android.com/apk/res/android\""
					);
				}
				firstReal = false;
			}
			sb.append(code).append("\n");
		}
		return sb.toString().trim();
	}
	
	/**
* Generates a complete Android layout XML document representing the
* current editor canvas state.
*
* @return a well-formed XML layout string
*/	
	public String getXMLCode() {
		StringBuilder sb = new StringBuilder();
		sb.append("<?xml version=\"1.0\" encoding=\"utf-8\"?>\n");
		sb.append("<LinearLayout\n")
		.append("    xmlns:android=\"http://schemas.android.com/apk/res/android\"\n")
		.append("    android:layout_width=\"match_parent\"\n")
		.append("    android:layout_height=\"match_parent\"\n")
		.append("    android:orientation=\"vertical\"\n")
		.append("    android:background=\"#FFFFFF\">\n");
		
		for (int i = 0; i < editorLayout.getChildCount(); i++) {
			View child = editorLayout.getChildAt(i);
			sb.append(indent(generateCode(child), 4)).append("\n");
		}
		
		sb.append("</LinearLayout>");
		return sb.toString();
	}
	
	/**
* Recursively serializes a single view (and its subtree) to an XML snippet.
* Skips {@link #placeHolder} views and the editor dummy root container.
*
* @param view the view to serialize
* @return an XML string fragment for this view
*/	
	public String generateCode(View view) {
		if ("EDITOR_DUMMY_ROOT".equals(view.getTag())) {
			StringBuilder rootBuilder = new StringBuilder();
			ViewGroup vg = (ViewGroup) view;
			for (int i = 0; i < vg.getChildCount(); i++) {
				View child = vg.getChildAt(i);
				if (child == placeHolder) continue;
				rootBuilder.append(generateCode(child)).append("\n");
			}
			return rootBuilder.toString();
		}
		
		StringBuilder sb = new StringBuilder();
		AttributeSet attributeSet = attributesValueMap.get(view);
		
		// ── Tag name ──────────────────────────────────────────────────────
		// Original drag-time class name = XML tag (clean, standard)
		// app:convertedWidget = internal bridge (XML mein nahi aayega)
		String tagName;
		if (view instanceof PlaceholderWidget) {
			String orig = ((PlaceholderWidget) view).getWidgetTag();
			tagName = (orig != null && !orig.isEmpty()) ? orig : "View";
		} else if (view instanceof PlaceholderWebView) {
			tagName = "WebView";
		} else {
			String pkg = view.getClass().getPackage() != null
			? view.getClass().getPackage().getName() : "";
			tagName = (pkg.equals("android.widget") || pkg.equals("android.view"))
			? view.getClass().getSimpleName()
			: view.getClass().getName();
		}
		
		// xmlns:app chahiye agar tag non-android namespace hai
		boolean needsAppNs = tagName.contains(".")
		&& !tagName.startsWith("android.")
		&& !tagName.startsWith("java.");
		
		sb.append("<").append(tagName);
		
		if (attributeSet != null) {
			for (Attribute a : attributeSet.getAttributes()) {
				String name = a.getName();
				// ── Yeh attributes XML output mein NAHI aayenge ──
				if ("xmlns:android".equals(name)
				|| "xmlns:app".equals(name)
				|| "app:convertedWidget".equals(name)) {  // internal bridge — hidden
					continue;
				}
				HashMap<String, Object> attrMap = findAttributeMap(name, view);
				String value = formatAttributeValue(a, attrMap);
				sb.append("\n    ").append(name).append("=\"").append(value).append("\"");
			}
		} else {
			sb.append("\n    android:layout_width=\"wrap_content\"");
			sb.append("\n    android:layout_height=\"wrap_content\"");
		}
		
		// xmlns:app sirf agar zaroorat ho aur abhi tak nahi hai
		if (needsAppNs) {
			sb.append("\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"");
		}
		
		if (view instanceof ViewGroup) {
			sb.append(">\n");
			ViewGroup group = (ViewGroup) view;
			for (int i = 0; i < group.getChildCount(); i++) {
				View child = group.getChildAt(i);
				if (child == placeHolder) continue;
				sb.append(indent(generateCode(child), 4)).append("\n");
			}
			sb.append("</").append(tagName).append(">");
		} else {
			sb.append(" />");
		}
		
		return sb.toString();
	}
	
	private String indent(String xml, int spaces) {
		String pad = new String(new char[spaces]).replace('\0', ' ');
		return pad + xml.replace("\n", "\n" + pad);
	}
	
	// ============================================================
	// XML Load
	// ============================================================
	
	private void loadFromXml(String xml) throws Exception {
		XmlPullParserFactory factory = XmlPullParserFactory.newInstance();
		XmlPullParser parser = factory.newPullParser();
		parser.setInput(new StringReader(xml));
		
		// groupStack: current parent ViewGroup
		// tagStack:   us ViewGroup ka XML tag naam (pop ke liye match)
		// editorLayout = depth-0 implicit root (kabhi pop nahi hoga)
		Stack<ViewGroup> groupStack = new Stack<>();
		Stack<String>    tagStack   = new Stack<>();
		groupStack.push(editorLayout);
		tagStack.push("__root__");
		
		int type;
		while ((type = parser.next()) != XmlPullParser.END_DOCUMENT) {
			
			if (type == XmlPullParser.START_TAG) {
				String tag            = parser.getName();
				String convertedClass = null;
				String viewId         = null;
				
				for (int i = 0; i < parser.getAttributeCount(); i++) {
					String n = parser.getAttributeName(i);
					String v = parser.getAttributeValue(i);
					if ("android:id".equals(n))            viewId         = AttributeUtils.getName(v);
					else if ("app:convertedWidget".equals(n)) convertedClass = v;
				}
				
				// ── View resolution: convertedWidget bridge ──────────────
				// 1. convertedClass (custom/third-party) → tryCreate
				// 2. original tag → createPlaceholderOrStandardView
				// 3. PlaceholderWidget fallback
				View view = null;
				if (convertedClass != null && !convertedClass.trim().isEmpty()) {
					view = tryCreate(convertedClass);
				}
				if (view == null) {
					view = createPlaceholderOrStandardView(tag);
				}
				if (view == null) continue;
				
				if (viewId != null && !viewId.isEmpty()) {
					idManager.addNewId(view, viewId);
				}
				
				// Attributes store karo (convertedWidget bhi — internal metadata)
				AttributeSet set = new AttributeSet();
				for (int i = 0; i < parser.getAttributeCount(); i++) {
					String n = parser.getAttributeName(i);
					String v = parser.getAttributeValue(i);
					Attribute a = (convertedClass != null)
					? new Attribute(n, v, tag, convertedClass)
					: new Attribute(n, v);
					set.add(a);
				}
				attributesValueMap.put(view, set);
				
				// Parent = stack ka top
				groupStack.peek().addView(view);
				
				// ── Editor setup — sirf real canvas views pe ────────────
				// PlaceholderWidget pe bhi click/drag lagao taaki
				// user usse select/delete kar sake
				attachEditorClickListener(view);
				attachDragAndClickListener(view);
				
				if (view instanceof ViewGroup) {
					ViewGroup vg = (ViewGroup) view;
					vg.setOnDragListener(dragController.getDragListener());
					applyContainerStroke(vg);          // stroke sirf ViewGroups pe
					vg.setMinimumHeight((int) SketchwareUtil.getDip(getContext(), 30));
					groupStack.push(vg);
					tagStack.push(tag);                // matching tag store karo
				}
				
			} else if (type == XmlPullParser.END_TAG) {
				// Sirf tab pop karo jab closing tag stack top se match kare
				// (leaf views — Button, TextView — ke end tag pe pop nahi)
				if (tagStack.size() > 1
				&& parser.getName().equals(tagStack.peek())) {
					groupStack.pop();
					tagStack.pop();
				}
			}
		}
		
		// Attributes apply karo poora tree ban jaane ke baad
		for (View v : attributesValueMap.keySet()) {
			AttributeSet set = attributesValueMap.get(v);
			if (set == null) continue;
			for (Attribute a : set.getAttributes()) {
				applyAttribute(v, a);
			}
		}

		// ✅ FIX: Load ke baad margin/padding explicitly re-apply karo.
		// applyAttribute() ka general path margin/padding ke liye
		// layout_params flag ke saath kaam karta hai, lekin kaafi baar
		// LayoutParams abhi set nahi hoti jab attributes apply ho rahe hote hain.
		// Isliye ek second pass specifically margin/padding ke liye.
		for (View v : attributesValueMap.keySet()) {
			AttributeSet set = attributesValueMap.get(v);
			if (set == null) continue;
			float density = getContext().getResources().getDisplayMetrics().density;
			for (Attribute a : set.getAttributes()) {
				String name = a.getName();
				String val  = a.getValue();
				if (val == null || val.isEmpty()) continue;
				try {
					// ── Padding re-apply ──────────────────────────────
					if (name.startsWith("android:padding")) {
						int px = (int) DimensionUtils.getValueInPx(getContext(), val);
						int l = v.getPaddingLeft(), t = v.getPaddingTop(),
							r = v.getPaddingRight(), b = v.getPaddingBottom();
						switch (name) {
							case "android:padding":          l = t = r = b = px; break;
							case "android:paddingLeft":      l = px; break;
							case "android:paddingTop":       t = px; break;
							case "android:paddingRight":     r = px; break;
							case "android:paddingBottom":    b = px; break;
							case "android:paddingStart":     l = px; break;
							case "android:paddingEnd":       r = px; break;
							case "android:paddingHorizontal": l = r = px; break;
							case "android:paddingVertical":   t = b = px; break;
						}
						v.setPadding(l, t, r, b);
						v.requestLayout();
					}
					// ── Margin re-apply ───────────────────────────────
					else if (name.startsWith("android:layout_margin")) {
						ViewGroup.LayoutParams lp = v.getLayoutParams();
						if (!(lp instanceof ViewGroup.MarginLayoutParams)) continue;
						ViewGroup.MarginLayoutParams mp = (ViewGroup.MarginLayoutParams) lp;
						int px = (int) DimensionUtils.getValueInPx(getContext(), val);
						switch (name) {
							case "android:layout_margin":            mp.leftMargin = mp.topMargin = mp.rightMargin = mp.bottomMargin = px; break;
							case "android:layout_marginLeft":        mp.leftMargin   = px; break;
							case "android:layout_marginTop":         mp.topMargin    = px; break;
							case "android:layout_marginRight":       mp.rightMargin  = px; break;
							case "android:layout_marginBottom":      mp.bottomMargin = px; break;
							case "android:layout_marginStart":       if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.JELLY_BEAN_MR1) mp.setMarginStart(px); break;
							case "android:layout_marginEnd":         if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.JELLY_BEAN_MR1) mp.setMarginEnd(px); break;
							case "android:layout_marginHorizontal":  mp.leftMargin = mp.rightMargin = px; break;
							case "android:layout_marginVertical":    mp.topMargin  = mp.bottomMargin = px; break;
						}
						v.setLayoutParams(mp);
						v.requestLayout();
					}
				} catch (Exception e) {
					Log.w("ViewEditor", "loadFromXml margin/padding re-apply failed for " + name, e);
				}
			}
		}
	}
	
	/**
* Attaches the standard editor click behaviour to a canvas widget:
* tapping selects it in {@link #viewItems} and, for non-{@link AdapterView}
* widgets, opens the attributes dialog directly.
*
* @param view the canvas widget to configure
*/	
	private void attachEditorClickListener(final View view) {
		view.setOnClickListener(new View.OnClickListener() {
			@Override
			public void onClick(View v) {
				String viewId = idManager.getId(v);
				if (viewId != null && viewItems != null) {
					viewItems.selectId(viewId);
				}
				if (v instanceof AdapterView) {
					((AdapterView<?>) v).setOnItemClickListener(
					new AdapterView.OnItemClickListener() {
						@Override
						public void onItemClick(AdapterView<?> parent,
						View itemView, int position, long id) {
							showAttributesDialog(itemView);
						}
					});
				} else {
					showAttributesDialog(v);
				}
			}
		});
	}
	
	// ============================================================
	// XML Helpers
	// ============================================================
	
	private String cleanXML(String xmlCode) {
		xmlCode = xmlCode.replaceAll(
		"(?m)^\\s*xmlns:android=\"http://schemas.android.com/apk/res/android\"\\s*$", "");
		if (!xmlCode.contains("xmlns:android")) {
			xmlCode = xmlCode.replaceFirst("<(\\w+)",
			"<$1 xmlns:android=\"http://schemas.android.com/apk/res/android\"");
		}
		xmlCode = xmlCode.replaceAll("android:id=\"@\\+id/\"", "");
		xmlCode = xmlCode.replaceAll("android:id=\"@\\+id/\\s*\"", "");
		xmlCode = xmlCode.replaceAll("\\s+\n", "\n").trim();
		return xmlCode;
	}
	
	/**
* Validates that the given string is a well-formed XML document by attempting
* to parse its first tag.
*
* @param xmlContent the XML string to validate
* @return {@code true} if the XML is structurally valid
*/	
	private boolean validateXML(String xmlContent) {
		try {
			XmlPullParserFactory factory = XmlPullParserFactory.newInstance();
			XmlPullParser parser = factory.newPullParser();
			parser.setFeature(XmlPullParser.FEATURE_PROCESS_NAMESPACES, false);
			parser.setInput(new StringReader(xmlContent));
			parser.nextTag();
			return true;
		} catch (XmlPullParserException | IOException e) {
			Log.e("ViewEditor", "XML validation failed: " + e.getMessage());
			return false;
		}
	}
	
	// ============================================================
	// Apply Attribute
	// ============================================================
	
	/**
* Looks up attribute metadata for the given view type and delegates to
* {@link #applyAttribute(View, Attribute, HashMap)}.
*
* @param view      the target view
* @param attribute the attribute to apply
*/	
	/**
	 * Public apply: attribute ko view pe apply karo + attributeMap mein store karo.
	 * ✅ FIX v3.1: saveStateForUndo() call HATAYA — ye load ke time infinite loop
	 * create karta tha aur undo stack ko garbage se bharta tha.
	 * Undo tracking sirf saveAndApplyAttribute() se hoti hai (user-initiated changes).
	 */
	public void applyAttribute(View view, Attribute attribute) {
		AttributeSet currentAttrSet = attributesValueMap.get(view);
		// ❌ REMOVED: saveStateForUndo("attribute_change_" + attribute.getName());
		// Reason: load ke time bhi call hota tha → stack pollution
		// User changes ka undo sirf saveAndApplyAttribute() se track hoga
		
		final ArrayList<HashMap<String, Object>> listMap = new ArrayList<>();
		Class cls           = view.getClass();
		Class viewRootClass = View.class.getSuperclass();
		while (cls != viewRootClass) {
			ArrayList<HashMap<String, Object>> temp = attributesMap.get(cls.getName());
			if (temp != null) listMap.addAll(0, temp);
			cls = cls.getSuperclass();
		}
		
		String attrName = attribute.getName();
		for (HashMap<String, Object> map : listMap) {
			if (map.get("attribute_name").toString().equals(attrName)) {
				applyAttributeInternal(view, attribute, map);
				break;
			}
		}
		
		if (currentAttrSet == null) {
			currentAttrSet = new AttributeSet();
			attributesValueMap.put(view, currentAttrSet);
		}
		currentAttrSet.add(attribute);
		
		generateCode((ViewGroup) editorLayout.getChildAt(0));
	}
	
	/**
	 * Internal apply method — saveAndApplyAttribute() aur AttributeChangeCommand
	 * dono yahan delegate karte hain. Public applyAttribute() se alag isliye ki
	 * undo applier ke paas map metadata available hona chahiye.
	 */
	private void applyAttributeInternal(View view, Attribute attribute, HashMap<String, Object> map) {
		applyAttribute(view, attribute, map);
	}
	
	/**
* Applies a single attribute to a view via reflection.
*
* <p>Handles special cases including margin, padding, layout dimensions,
* text size, color, drawable, size, enum, and flag attribute types.
*
* @param view      the target view
* @param attribute the attribute with its name and value
* @param map       the attribute metadata from {@code attributes.json}
*/	
	public void applyAttribute(View view, Attribute attribute, HashMap<String, Object> map) {
		final String argumentType   = map.get("argument_type").toString();
		String value                = attribute.getValue();
		final String attributeName  = attribute.getName();
		Object argumentValue        = null;
		String memberName           = map.get("member_name").toString();
		
		if ("app:convertedWidget".equals(attributeName)) {
			handleWidgetConversion(view, value);
			return;
		}
		
		// ---------- Margin ----------
		if (attributeName.startsWith("android:layout_margin")) {
			try {
				ViewGroup.LayoutParams params = view.getLayoutParams();
				if (params instanceof ViewGroup.MarginLayoutParams) {
					ViewGroup.MarginLayoutParams mp = (ViewGroup.MarginLayoutParams) params;
					int px = (int) DimensionUtils.getValueInPx(getContext(), value);
					
					switch (attributeName) {
						case "android:layout_margin":
						mp.leftMargin = mp.topMargin = mp.rightMargin = mp.bottomMargin = px;
						break;
						case "android:layout_marginLeft":   mp.leftMargin   = px; break;
						case "android:layout_marginTop":    mp.topMargin    = px; break;
						case "android:layout_marginRight":  mp.rightMargin  = px; break;
						case "android:layout_marginBottom": mp.bottomMargin = px; break;
						case "android:layout_marginStart":
						if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.JELLY_BEAN_MR1)
						mp.setMarginStart(px);
						break;
						case "android:layout_marginEnd":
						if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.JELLY_BEAN_MR1)
						mp.setMarginEnd(px);
						break;
						case "android:layout_marginHorizontal":
						mp.leftMargin = mp.rightMargin = px; break;
						case "android:layout_marginVertical":
						mp.topMargin = mp.bottomMargin = px; break;
					}
					view.setLayoutParams(mp);
					view.requestLayout();
				}
			} catch (Exception e) {
				Log.e("ViewEditor", "Error setting margin: " + e.getMessage(), e);
			}
			return;
		}
		
		// ---------- Padding ----------
		if (attributeName.startsWith("android:padding")) {
			try {
				int left   = view.getPaddingLeft();
				int top    = view.getPaddingTop();
				int right  = view.getPaddingRight();
				int bottom = view.getPaddingBottom();
				int px     = (int) DimensionUtils.getValueInPx(getContext(), value);
				
				switch (attributeName) {
					case "android:padding":         left = top = right = bottom = px; break;
					case "android:paddingLeft":     left   = px; break;
					case "android:paddingTop":      top    = px; break;
					case "android:paddingRight":    right  = px; break;
					case "android:paddingBottom":   bottom = px; break;
					case "android:paddingStart":
					if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.JELLY_BEAN_MR1) left = px;
					break;
					case "android:paddingEnd":
					if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.JELLY_BEAN_MR1) right = px;
					break;
					case "android:paddingHorizontal": left = right = px; break;
					case "android:paddingVertical":   top = bottom = px; break;
				}
				view.setPadding(left, top, right, bottom);
				view.requestLayout();
			} catch (Exception e) {
				Log.e("ViewEditor", "Error setting padding: " + e.getMessage(), e);
			}
			return;
		}
		
		// ---------- Width / Height ----------
		if ("android:layout_width".equals(attributeName)
		|| "android:layout_height".equals(attributeName)) {
			
			ViewGroup.LayoutParams params = view.getLayoutParams();
			if (params == null) {
				params = new LinearLayout.LayoutParams(
				ViewGroup.LayoutParams.WRAP_CONTENT,
				ViewGroup.LayoutParams.WRAP_CONTENT);
			}
			int px = parseDimension(value);
			if ("android:layout_width".equals(attributeName)) params.width  = px;
			else                                               params.height = px;
			view.setLayoutParams(params);
			view.requestLayout();
		}
		
		try {
			Object targetObj = view;
			if (map.containsKey("layout_params") && (boolean) map.get("layout_params")) {
				targetObj = view.getLayoutParams();
			}
			
			switch (argumentType) {
				case "boolean":
				argumentValue = value.equals("true");
				break;
				
				case "int":
				argumentValue = map.containsKey("dimension")
				? (int) DimensionUtils.getValueInPx(getContext(), value)
				: Integer.parseInt(value);
				break;
				
				case "float":
				if ("android:textSize".equals(attributeName) && value != null && !value.isEmpty()) {
					try {
						if (value.endsWith("sp")) {
							((TextView) view).setTextSize(TypedValue.COMPLEX_UNIT_SP,
							Float.parseFloat(value.replace("sp", "").trim()));
						} else if (value.endsWith("dp")) {
							((TextView) view).setTextSize(TypedValue.COMPLEX_UNIT_DIP,
							Float.parseFloat(value.replace("dp", "").trim()));
						} else {
							((TextView) view).setTextSize(Float.parseFloat(value));
						}
					} catch (Exception e) {
						SketchwareUtil.showMessage(getContext(), "Invalid textSize: " + value);
					}
					return;
				}
				try {
					argumentValue = map.containsKey("dimension")
					? (float) DimensionUtils.getValueInPx(getContext(), value)
					: Float.parseFloat(value);
				} catch (Exception e) {
					SketchwareUtil.showMessage(getContext(), "Invalid float value: " + value);
					return;
				}
				break;
				
				case "String":
				if ("android:text".equals(attributeName) && value.startsWith("@string/")) {
					String resourceName = value.substring("@string/".length());
					String resolved = getStringResourceValue(
					DesignActivity.getScId(), resourceName);
					argumentValue = (resolved != null) ? resolved : value;
				} else {
					argumentValue = value;
				}
				break;
				
				case "Size":
				if ("match_parent".equals(value))       argumentValue = ViewGroup.LayoutParams.MATCH_PARENT;
				else if ("wrap_content".equals(value))  argumentValue = ViewGroup.LayoutParams.WRAP_CONTENT;
				else                                    argumentValue = DimensionUtils.getValueInPx(getContext(), value);
				break;
				
				case "Color":
				argumentValue = Color.parseColor(value);
				break;
				
				case "Drawable": {
					String imgPath = FileUtil.getExternalStorageDir()
					+ "/.blacklogics/resources/images/"
					+ ProjectDataHelper.getScId(getContext()) + "/"
					+ AttributeUtils.getImageName(value) + ".png";
					Bitmap bmp = BitmapFactory.decodeFile(imgPath);
					argumentValue = new android.graphics.drawable.BitmapDrawable(
					getContext().getResources(), bmp);
					break;
				}
				
				case "View":
				if (value.startsWith("@")) {
					argumentValue = idManager.getId(AttributeUtils.getName(value));
				} else {
					ArrayList<String> xmlList  = (ArrayList<String>) map.get("xml_arguments");
					ArrayList<String> javaList = (ArrayList<String>) map.get("java_arguments");
					String path = javaList.get(xmlList.indexOf(value));
					try {
						argumentValue = createObject(Class.forName(path));
					} catch (ClassNotFoundException e) {
						argumentValue = ReflectionUtils.getStaticField(path).get(null);
					}
				}
				break;
				
				case "enum": {
					ArrayList<String> xmlArgs  = (ArrayList<String>) map.get("xml_arguments");
					ArrayList<String> javaArgs = (ArrayList<String>) map.get("java_arguments");
					String path = javaArgs.get(xmlArgs.indexOf(value));
					try {
						argumentValue = createObject(Class.forName(path));
					} catch (ClassNotFoundException e) {
						argumentValue = ReflectionUtils.getStaticField(path).get(null);
					}
					break;
				}
				
				case "flag": {
					List<String> selected  = Arrays.asList(value.split("\\|"));
					ArrayList<String> xmlA  = (ArrayList<String>) map.get("xml_arguments");
					ArrayList<String> javaA = (ArrayList<String>) map.get("java_arguments");
					try {
						argumentValue = 0;
						for (String s : selected) {
							String fieldPath = javaA.get(xmlA.indexOf(s));
							argumentValue = (int) argumentValue
							| (int) ReflectionUtils.getStaticFieldValue(fieldPath);
						}
					} catch (Exception e) {
						SketchwareUtil.showMessage(getContext(), e.toString());
					}
					break;
				}
				
				default:
				SketchwareUtil.showMessage(getContext(), "No such type found");
				break;
			}
			
			if (map.containsKey("member_type")) {
				if ("method".equals(map.get("member_type").toString())) {
					if (map.containsKey("constant")) {
						String constantPath = map.get("constant").toString();
						Object constant;
						try {
							Class<?> cls = Class.forName(constantPath);
							try { constant = createObject(cls); }
							catch (Exception e) {
								showMessage("couldn't initialise " + cls.toString());
								return;
							}
						} catch (ClassNotFoundException e) {
							constant = ReflectionUtils.getStaticFieldValue(constantPath);
						}
						ReflectionUtils.invokeMethod(targetObj, memberName, constant, argumentValue);
					} else {
						ReflectionUtils.invokeMethod(targetObj, memberName, argumentValue);
					}
				} else {
					ReflectionUtils.setField(targetObj, memberName, argumentValue);
					view.requestLayout();
				}
			}
			
		} catch (Exception e) {
			showMessage("error while applying attribute \"" + attributeName + "\"\n" + e);
		}
	}
	
	/**
	 * Persists an attribute value then applies it to the view.
	 *
	 * <p>✅ FIX v3.1: Old value pehle capture hota hai, phir AttributeChangeCommand
	 * StableUndoManager mein push hota hai. Pehle ye sirf set.add() karta tha
	 * bina kuch undo mein daale — isliye attribute change undo kabhi kaam nahi karta tha.</p>
	 */
	private void saveAndApplyAttribute(final View view, final String attrName, final String newValue,
	final HashMap<String, Object> attributeMeta) {
		AttributeSet set = attributesValueMap.get(view);
		if (set == null) {
			set = new AttributeSet();
			attributesValueMap.put(view, set);
		}
		final AttributeSet finalSet = set;
		
		// ✅ FIX: Old value PEHLE capture karo — undo restore ke liye zaroori
		Attribute existing = set.getAttribute(attrName);
		final String oldValue = (existing != null) ? existing.getValue() : null;
		
		// ✅ FIX: AttributeChangeCommand push karo — real undo/redo enable hota hai
		if (!isUndoRedoInProgress) {
			stableUndoManager.push(getCurrentActivityName(),
			new StableUndoManager.AttributeChangeCommand(
			view, attrName, oldValue, newValue,
			new StableUndoManager.AttributeChangeCommand.AttributeApplier() {
				@Override
				public void apply(View v, String name, String value) {
					Attribute a = new Attribute(name, value);
					finalSet.add(a);
					applyAttributeInternal(v, a, attributeMeta);
				}
			}));
		}
		
		Attribute a = new Attribute(attrName, newValue);
		set.add(a);
		applyAttributeInternal(view, a, attributeMeta);
	}
	
