	// ============================================================
	

	// ============================================================
	// Custom View Picker Dialog (Sketchware style)
	// ============================================================

	/**
	 * Sketchware style — Custom View picker dialog.
	 *
	 * ListView / RecyclerView / Spinner / GridView / ExpandableListView ke
	 * "Custom View" attribute click hone par yeh dialog khulta hai.
	 *
	 * Dialog mein project ke saare custom views radio buttons mein show hote hain.
	 * User ek select kare → value "app:customView" attribute mein save hoti hai.
	 * JavaCodeBuilder build time pe is value ko padh ke poora adapter
	 * inner class generate karta hai (ListView=BaseAdapter, Spinner=ArrayAdapter,
	 * RecyclerView=RecyclerView.Adapter).
	 */
	private void showCustomViewPickerDialog(final View view,
	final String attrName,
	final HashMap<String, Object> attributeMeta) {

		// ── Step 1: Project ke saare custom view names lo ─────────────────
		final List<String> customViews = getProjectCustomViewNames();

		if (customViews == null || customViews.isEmpty()) {
			Toast.makeText(getContext(),
				"Koi custom view nahi mila.\nPehle Design editor mein ek custom view banao.",
				Toast.LENGTH_LONG).show();
			return;
		}

		// ── Step 2: Currently saved value (pre-select ke liye) ────────────
		AttributeSet curSet = attributesValueMap.get(view);
		final String currentValue = (curSet != null && curSet.getAttribute(attrName) != null)
			? curSet.getAttribute(attrName).getValue()
			: "";

		// ── Step 3: RadioGroup build karo ─────────────────────────────────
		final int[] selectedIndex = { -1 };

		LinearLayout container = new LinearLayout(getContext());
		container.setOrientation(LinearLayout.VERTICAL);
		int pad = (int)(16 * getResources().getDisplayMetrics().density);
		container.setPadding(pad, pad / 2, pad, pad / 2);

		final RadioGroup radioGroup = new RadioGroup(getContext());
		radioGroup.setOrientation(RadioGroup.VERTICAL);

		for (int i = 0; i < customViews.size(); i++) {
			final String cvName = customViews.get(i);
			RadioButton rb = new RadioButton(getContext());
			rb.setId(i + 1);
			rb.setText(cvName);
			rb.setTextSize(15f);
			rb.setTextColor(0xFF212121);
			int rbPad = (int)(6 * getResources().getDisplayMetrics().density);
			rb.setPadding(rbPad, rbPad, rbPad, rbPad);
			if (cvName.equals(currentValue)) {
				rb.setChecked(true);
				selectedIndex[0] = i;
			}
			radioGroup.addView(rb);
		}

		radioGroup.setOnCheckedChangeListener(new RadioGroup.OnCheckedChangeListener() {
			@Override
			public void onCheckedChanged(RadioGroup group, int checkedId) {
				selectedIndex[0] = checkedId - 1; // id = index + 1
			}
		});

		container.addView(radioGroup);

		// "None / Clear" option at bottom
		final RadioButton noneRb = new RadioButton(getContext());
		noneRb.setId(customViews.size() + 1);
		noneRb.setText("None (clear selection)");
		noneRb.setTextSize(13f);
		noneRb.setTextColor(0xFF888888);
		if (currentValue.isEmpty()) noneRb.setChecked(true);
		noneRb.setOnCheckedChangeListener(new CompoundButton.OnCheckedChangeListener() {
			@Override
			public void onCheckedChanged(CompoundButton btn, boolean checked) {
				if (checked) {
					radioGroup.clearCheck();
					selectedIndex[0] = -1;
				}
			}
		});
		container.addView(noneRb);

		ScrollView scrollView = new ScrollView(getContext());
		scrollView.addView(container);

		// ── Step 4: Dialog show karo ──────────────────────────────────────
		new MaterialAlertDialogBuilder(getContext(),
			com.google.android.material.R.style.ThemeOverlay_Material3_MaterialAlertDialog_Centered)
			.setTitle("Select Custom View")
			.setView(scrollView)
			.setNeutralButton("Cancel", null)
			.setPositiveButton("Select", new DialogInterface.OnClickListener() {
				@Override
				public void onClick(DialogInterface dialog, int which) {
					if (selectedIndex[0] == -1) {
						// Clear the attribute
						AttributeSet s = attributesValueMap.get(view);
						if (s != null) s.remove(attrName);
						return;
					}
					String chosen = customViews.get(selectedIndex[0]);
					saveAndApplyAttribute(view, attrName, chosen, attributeMeta);
				}
			})
			.show();
	}

	/**
	 * DesignActivity ke complex object se project ke saare custom view names fetch karta hai.
	 * Agar complex available nahi hai toh empty list return karta hai.
	 */
	private List<String> getProjectCustomViewNames() {
		try {
			if (designActivity != null && designActivity.complex != null) {
				List<String> names = designActivity.complex.getCustomViewNames();
				if (names != null && !names.isEmpty()) return names;
			}
		} catch (Exception e) {
			Log.e("ViewEditor", "getProjectCustomViewNames failed", e);
		}
		return new ArrayList<String>();
	}

	private void showConvertWidgetDialog(final View view) {
		final EditText editText = new EditText(getContext());
		editText.setHint("android.widget.SearchView");
		editText.setSingleLine(true);
		
		attrSet = attributesValueMap.get(view);
		if (attrSet != null) {
			Attribute convertAttr = attrSet.getAttribute("app:convertedWidget");
			if (convertAttr != null) editText.setText(convertAttr.getValue());
		}
		
		TextView hint = new TextView(getContext());
		hint.setText("Enter custom widget class name:\nExamples: MaterialButton, CardView, SearchView");
		hint.setTextSize(12);
		hint.setTextColor(0xFF666666);
		hint.setPadding(0, 0, 0, 20);
		
		LinearLayout layout = new LinearLayout(getContext());
		layout.setOrientation(LinearLayout.VERTICAL);
		layout.setPadding(50, 30, 50, 30);
		layout.addView(hint);
		layout.addView(editText);
		
		new AlertDialog.Builder(getContext())
		.setTitle("Convert Widget")
		.setView(layout)
		.setPositiveButton("Convert", new DialogInterface.OnClickListener() {
			@Override
			public void onClick(DialogInterface dialog, int which) {
				String className = editText.getText().toString().trim();
				if (!className.isEmpty()) {
					if (attrSet == null) {
						attrSet = new AttributeSet();
						attributesValueMap.put(view, attrSet);
					}
					attrSet.add(new Attribute("app:convertedWidget", className));
					handleWidgetConversion(view, className);
				}
			}
		})
		.setNegativeButton("Cancel", null)
		.show();
	}
	
	private void handleWidgetConversion(View originalView, String customClassName) {
		try {
			if (customClassName == null || customClassName.trim().isEmpty()) return;
			
			String originalTag = originalView.getClass().getSimpleName();
			AttributeSet originalAttributes = attributesValueMap.get(originalView);
			AttributeSet newAttributeSet = new AttributeSet();
			
			if (originalAttributes != null) {
				for (Attribute a : originalAttributes.getAttributes()) {
					if ("app:convertedWidget".equals(a.getName())) continue;
					newAttributeSet.add(new Attribute(
					a.getName(), a.getValue(), originalTag, customClassName));
				}
			}
			
			newAttributeSet.add(new Attribute(
			"app:convertedWidget", customClassName, originalTag, customClassName));
			attributesValueMap.put(originalView, newAttributeSet);
			
			for (Attribute a : newAttributeSet.getAttributes()) {
				if (!"app:convertedWidget".equals(a.getName())) {
					applyAttribute(originalView, a);
				}
			}
			
			if (!isUndoRedoInProgress) saveStateForUndo("convert_widget");
			
			originalView.requestLayout();
			originalView.invalidate();
			
		} catch (Exception e) {
			Log.e("ViewEditor", "Conversion failed", e);
			SketchwareUtil.showMessage(getContext(), "Conversion error: " + e.getMessage());
		}
	}
	
	// ============================================================
	// Padding / Margin Dialogs
	// ============================================================
	
	private void showPaddingDialog(final View view) {
		new DimensionEditorDialog(
		getContext(), view, DimensionType.PADDING,
		new Runnable() {
			@Override
			public void run() {
				// ✅ FIX v3.1 (Padding Save Fix):
				// DimensionEditorDialog view pe directly setPadding karta hai
				// lekin attributesValueMap update NAHI karta — isliye save/load pe
				// padding lost ho jaata tha.
				// Ab yahan live padding values read karke attributesValueMap mein save karo.
				float density = getContext().getResources().getDisplayMetrics().density;
				int left   = view.getPaddingLeft();
				int top    = view.getPaddingTop();
				int right  = view.getPaddingRight();
				int bottom = view.getPaddingBottom();
				
				AttributeSet set = attributesValueMap.get(view);
				if (set == null) { set = new AttributeSet(); attributesValueMap.put(view, set); }
				
				// Pixel → dp convert karke store karo (XML save ke liye "Ndp" format chahiye)
				set.add(new Attribute("android:paddingLeft",   Math.round(left   / density) + "dp"));
				set.add(new Attribute("android:paddingTop",    Math.round(top    / density) + "dp"));
				set.add(new Attribute("android:paddingRight",  Math.round(right  / density) + "dp"));
				set.add(new Attribute("android:paddingBottom", Math.round(bottom / density) + "dp"));
				// android:padding ko null se override karo (individual values use ho rahe hain)
				// Note: AttributeSet.remove() nahi hai toh individual add hi override karega
			}
		}).show();
	}
	
	private void showMarginDialog(final View view) {
		new DimensionEditorDialog(
		getContext(), view, DimensionType.MARGIN,
		new Runnable() {
			@Override
			public void run() {
				// ✅ FIX v3.1 (Margin Save Fix):
				// DimensionEditorDialog setMargin karta hai lekin attributesValueMap update nahi karta.
				float density = getContext().getResources().getDisplayMetrics().density;
				ViewGroup.LayoutParams params = view.getLayoutParams();
				if (!(params instanceof ViewGroup.MarginLayoutParams)) return;
				ViewGroup.MarginLayoutParams mp = (ViewGroup.MarginLayoutParams) params;
				
				AttributeSet set = attributesValueMap.get(view);
				if (set == null) { set = new AttributeSet(); attributesValueMap.put(view, set); }
				
				set.add(new Attribute("android:layout_marginLeft",   Math.round(mp.leftMargin   / density) + "dp"));
				set.add(new Attribute("android:layout_marginTop",    Math.round(mp.topMargin    / density) + "dp"));
				set.add(new Attribute("android:layout_marginRight",  Math.round(mp.rightMargin  / density) + "dp"));
				set.add(new Attribute("android:layout_marginBottom", Math.round(mp.bottomMargin / density) + "dp"));
				// android:layout_margin ko individual values se override karo
			}
		}).show();
	}
	
