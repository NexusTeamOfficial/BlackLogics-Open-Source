	// ============================================================
	// Initialization
	// ============================================================
	
	/**
* Inflates the editor layout, binds all child views, initializes drag-and-drop,
* loads widget/attribute metadata from assets, and sets up the navigation bar.
*
* @param context the host {@link android.app.Activity} context
*/	
	private void initialize(Context context) {
		setOrientation(VERTICAL);
		LayoutInflater inflater = LayoutInflater.from(context);
		View view = inflater.inflate(R.layout.view_editor, this, true);
		
		undoManager = UndoManager.getInstance();
		// ✅ NEW: StableUndoManager init
		stableUndoManager = StableUndoManager.getInstance();
		
		lin_toolbar         = view.findViewById(R.id.lin_toolbar);
		collection_list     = view.findViewById(R.id.collection_list);
		img_views           = view.findViewById(R.id.img_views);
		editorLayout        = view.findViewById(R.id.editorLayout);
		img_add_view        = view.findViewById(R.id.img_add_view);
		listview_widgets    = view.findViewById(R.id.listview_widgets);
		tv_view_name        = view.findViewById(R.id.tv_view_name);
		phone_action_bar    = view.findViewById(R.id.phone_action_bar);
		customNav           = view.findViewById(R.id.customNav);
		widgetPalette       = view.findViewById(R.id.widgetPalette);
		collectionPalette   = view.findViewById(R.id.collectionPalette);
		
		vib = (Vibrator) context.getSystemService(Context.VIBRATOR_SERVICE);
		
		setupToolbarListeners();
		initializeEditorComponents(context);
		
		beanManager = ViewBeanManager.getInstance();
		
		MobileAds.initialize(context);
		List<String> testDeviceIds = Arrays.asList("D4516BAC0B080049F0FABC1AD69374C4");
		MobileAds.setRequestConfiguration(
		new RequestConfiguration.Builder().setTestDeviceIds(testDeviceIds).build()
		);
	}
	
	private void setupToolbarListeners() {
		img_views.setOnClickListener(new View.OnClickListener() {
			@Override
			public void onClick(View v) {
				ArrayList<String> idsList = idManager.getIds();
				final String[] ids = idsList.toArray(new String[0]);
				
				new AlertDialog.Builder(getContext())
				.setTitle("Select view")
				.setItems(ids, new DialogInterface.OnClickListener() {
					@Override
					public void onClick(DialogInterface dialog, int which) {
						idManager.getView(ids[which]);
					}
				})
				.create()
				.show();
			}
		});
		
		img_add_view.setOnClickListener(new View.OnClickListener() {
			@Override
			public void onClick(View v) {
				showMaterialWidgetDialog(getContext(), viewsList);
			}
		});
		
		editorLayout.setOnClickListener(new View.OnClickListener() {
			@Override
			public void onClick(View v) {
				hideProperties();
				unselectSelectedWidget();
			}
		});
	}
	
	private void initializeEditorComponents(Context context) {
		// Placeholder for drag-and-drop position indicator
		placeHolder = new View(context);
		placeHolder.setLayoutParams(new ViewGroup.LayoutParams(
		(int) SketchwareUtil.getDip(context, 70),
		(int) SketchwareUtil.getDip(context, 40)));
		placeHolder.setMinimumHeight((int) SketchwareUtil.getDip(context, 40));
		placeHolder.setMinimumWidth((int) SketchwareUtil.getDip(context, 70));
		placeHolder.setBackgroundColor(0xFF757575);
		
		viewEditorDrag = new ViewEditorDrag(context, placeHolder);
		
		// Light status/nav bar on API 23+
		if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
			int flags = getSystemUiVisibility();
			flags |= View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR | View.SYSTEM_UI_FLAG_LIGHT_NAVIGATION_BAR;
			setSystemUiVisibility(flags);
			((Activity) context).getWindow().setStatusBarColor(Color.WHITE);
			((Activity) context).getWindow().setNavigationBarColor(Color.WHITE);
		}
		
		// ✅ Floating delete target pehle banao — dragController ko pass karna hai
		deleteImg = new ImageView(context);
		deleteImg.setImageResource(R.drawable.ic_delete_white);
		deleteImg.setColorFilter(0xFF757575, PorterDuff.Mode.SRC_ATOP);
		deleteImg.setVisibility(View.GONE);
		
		// ✅ NEW: EditorDragController setup (NPE-proof, ScrollView guard included)
		dragController = new EditorDragController(context, editorLayout, placeHolder);
		dragController.setDeleteTarget(deleteImg);
		dragController.setCallback(new EditorDragController.DragCallback() {
			
			@Override
			public void onDragStarted(View draggedView) {
				showDeleteImage();
			}
			
			@Override
			public void onNewWidgetDropped(Object widgetData, ViewGroup destination, DragEvent event) {
				handleDropNewWidget(destination, widgetData, event);
			}
			
			@Override
			public void onExistingWidgetMoved(View draggedView, ViewGroup newParent, int insertIndex) {
				// ✅ FIX v3.1: dragController se pre-captured source use karo
				// DROP pe draggedView.getParent() == null hota hai — already removed
				// DRAG_STARTED pe capture kiya gaya oldParent use karo
				ViewGroup oldParent = dragController.getDragSourceParent();
				int oldIndex        = dragController.getDragSourceIndex();
				
				if (oldParent == null) return; // orphaned drag — ignore
				
				stableUndoManager.push(getCurrentActivityName(),
				new StableUndoManager.MoveViewCommand(
				draggedView, oldParent, oldIndex, newParent, insertIndex));
				// saveStateForUndo() call NAHI karo — MoveViewCommand already track kar raha hai
			}
			
			@Override
			public void onWidgetDeleted(View draggedView) {
				// ✅ FIX v3.1: dragController se pre-captured parent use karo
				// DELETE pe view already removed hota hai — getParent() null dega
				ViewGroup parent = dragController.getDragSourceParent();
				int idx = dragController.getDragSourceIndex();
				// Fallback: agar pre-capture nahi hua
				if (parent == null && draggedView.getParent() instanceof ViewGroup) {
					parent = (ViewGroup) draggedView.getParent();
					idx = parent.indexOfChild(draggedView);
				}
				if (parent != null) {
					// ✅ Push PEHLE karo — parent reference tab valid hai
					stableUndoManager.push(getCurrentActivityName(),
					new StableUndoManager.RemoveViewCommand(draggedView, parent, idx));
					parent.removeView(draggedView);
				}
				idManager.remove(draggedView);
				attributesValueMap.remove(draggedView);
				SketchwareUtil.showMessage(getContext(), "View deleted");
			}
			
			@Override
			public void onDragEnded(boolean success, View draggedView) {
				hideDeleteImage();
				if (success) {
					vib.vibrate(100);
				} else if (draggedView != null && draggedView.getParent() == null) {
					idManager.remove(draggedView);
					attributesValueMap.remove(draggedView);
				}
			}
		});
		
		// Legacy dragListener bhi set karo taaki loadFromXml mein existing references kaam karein
		dragListener = new DragListener();
		// Actual drag is dragController se handle hoga
		editorLayout.setOnDragListener(dragController.getDragListener());
		
		// Navigation bar tabs: Widgets | Collections
		customNav.addNavItem(R.drawable.ic_home, 101);
		customNav.addNavItem(R.drawable.ic_bookmark, 102);
		customNav.selectItem(101);
		
		customNav.setOnTabSelectedListener(new com.nexusteam.blacklogics.custom.NavBar.OnTabSelectedListener() {
			@Override
			public void onTabSelected(int id) {
				if (id == 101) {
					widgetPalette.setAlpha(0f);
					widgetPalette.setVisibility(View.VISIBLE);
					widgetPalette.animate().alpha(1f).setDuration(200);
					
					collectionPalette.animate().alpha(0f).setDuration(200)
					.withEndAction(new Runnable() {
						@Override
						public void run() {
							collectionPalette.setVisibility(View.GONE);
						}
					});
				} else if (id == 102) {
					collectionPalette.setAlpha(0f);
					collectionPalette.setVisibility(View.VISIBLE);
					collectionPalette.animate().alpha(1f).setDuration(200);
					
					widgetPalette.animate().alpha(0f).setDuration(200)
					.withEndAction(new Runnable() {
						@Override
						public void run() {
							widgetPalette.setVisibility(View.GONE);
						}
					});
				}
			}
		});
		
		FrameLayout.LayoutParams deleteParams = new FrameLayout.LayoutParams(
		(int) SketchwareUtil.getDip(context, 60),
		(int) SketchwareUtil.getDip(context, 60));
		deleteParams.gravity = Gravity.LEFT | Gravity.BOTTOM;
		deleteImg.setLayoutParams(deleteParams);
		((ViewGroup) ((Activity) context).getWindow().findViewById(Window.ID_ANDROID_CONTENT))
		.addView(deleteImg);
		
		// Ripple feedback on toolbar icons
		View imgCopy    = findViewById(R.id.img_copy);
		View imgImport  = findViewById(R.id.img_import);
		UiUtils.addRipple(img_add_view);
		UiUtils.addRipple(img_views);
		if (imgCopy   != null) UiUtils.addRipple(imgCopy);
		if (imgImport != null) UiUtils.addRipple(imgImport);
		
		// Load widget + attribute metadata from assets
		viewsList = new Gson().fromJson(
		Utils.readFromAsset(context, "views.json"),
		new TypeToken<ArrayList<HashMap<String, Object>>>() {}.getType());
		
		attributesMap = new Gson().fromJson(
		Utils.readFromAsset(context, "attributes.json"),
		new TypeToken<HashMap<String, ArrayList<HashMap<String, Object>>>>() {}.getType());
		
		parentAttributesMap = new Gson().fromJson(
		Utils.readFromAsset(context, "parent_dependent_attributes.json"),
		new TypeToken<HashMap<String, ArrayList<HashMap<String, Object>>>>() {}.getType());
		
		listview_widgets.setLayoutManager(new LinearLayoutManager(context));
		listview_widgets.setAdapter(new WidgetPaletteAdapter(context, viewsList));
		
		lin_toolbar.setElevation(5);
		
		View root = editorLayout.getChildAt(0);
		if (root instanceof ViewGroup) {
			applyContainerStroke(root);
		}
		
		setupCollectionList();
	}
	
	public void setupImportedView(View view) {
		view.setOnClickListener(new View.OnClickListener() {
			@Override
			public void onClick(View v) {
				String id = idManager.getId(v);
				if (id != null && viewItems != null) {
					viewItems.selectId(id);
				}
				showAttributesDialog(v);
			}
		});
		attachDragAndClickListener(view);
		
		if (view instanceof ViewGroup) {
			((ViewGroup) view).setOnDragListener(dragController.getDragListener());
			((ViewGroup) view).setMinimumHeight((int) SketchwareUtil.getDip(getContext(), 30));
		}
		
		view.setMinimumWidth((int) SketchwareUtil.getDip(getContext(), 50));
		view.setMinimumHeight((int) SketchwareUtil.getDip(getContext(), 30));
	}
	
	
	// ============================================================
	// Drag & Click Setup for Canvas Widgets
	// ============================================================
	
	/**
* Attaches long-press drag initiation and tap-to-edit behaviour to a canvas widget.
* Long press starts a drag; a short tap (delta ≤ 5px) opens the attributes dialog.
*
* @param targetView the widget to configure
*/	
	public void attachDragAndClickListener(final View targetView) {
		final GestureDetector gestureDetector = new GestureDetector(
		new GestureDetector.SimpleOnGestureListener() {
			@Override
			public void onLongPress(MotionEvent event) {
				DragAndDropUtils.startDragAndDrop(
				targetView, null,
				new View.DragShadowBuilder(targetView),
				targetView, 0);
			}
		});
		
		targetView.setOnTouchListener(new View.OnTouchListener() {
			private boolean isTap = true;
			private float startX, startY;
			
			@Override
			public boolean onTouch(View v, MotionEvent event) {
				switch (event.getAction()) {
					case MotionEvent.ACTION_DOWN:
					startX = event.getX();
					startY = event.getY();
					isTap = true;
					break;
					
					case MotionEvent.ACTION_UP:
					float deltaX = Math.abs(startX - event.getX());
					float deltaY = Math.abs(startY - event.getY());
					if (deltaX <= 5 && deltaY <= 5 && isTap) {
						showAttributesDialog(v);
					}
					isTap = true;
					break;
					
					default:
					break;
				}
				gestureDetector.onTouchEvent(event);
				return true;
			}
		});
	}
	
	// ============================================================
	// Attributes Dialog
	// ============================================================
	
	/**
* Presents the attribute editing bottom sheet for the given view.
*
* <p>Displays a tabbed dialog with an "Attributes" tab (type-specific editors)
* and an "Events" tab (listener bindings to Logic Editor). Highlights the
* selected view on the canvas during editing.
*
* @param view the target view whose properties should be edited
*/	
	public void showAttributesDialog(final View view) {
		// Build attribute list by walking the class hierarchy
		final ArrayList<HashMap<String, Object>> attributesList = new ArrayList<>();
		Class<?> cls = view.getClass();
		Class<?> viewRootClass = View.class.getSuperclass();
		
		while (cls != viewRootClass) {
			ArrayList<HashMap<String, Object>> tempList = attributesMap.get(cls.getName());
			if (tempList != null) attributesList.addAll(0, tempList);
			cls = cls.getSuperclass();
		}
		
		if (view.getParent() instanceof ViewGroup) {
			cls = view.getParent().getClass();
			while (cls != viewRootClass) {
				ArrayList<HashMap<String, Object>> tempList = parentAttributesMap.get(cls.getName());
				if (tempList != null) attributesList.addAll(tempList);
				cls = cls.getSuperclass();
			}
		}
		
		// Build listener list based on widget type
		final ArrayList<HashMap<String, Object>> listenersList = buildListenersForView(view);
		
		// Highlight selected widget
		highlightWidget(view);
		showProperties();
		
		// Create bottom sheet
		final BottomSheetDialog bottomSheetDialog = new BottomSheetDialog(getContext());
		bottomSheetDialog.setCancelable(true);
		bottomSheetDialog.setCanceledOnTouchOutside(true);
		
		View inflated = LayoutInflater.from(getContext()).inflate(R.layout.attributes_bottom_sheet, null);
		bottomSheetDialog.setContentView(inflated);
		
		if (bottomSheetDialog.getBehavior() != null) {
			bottomSheetDialog.getBehavior().setState(BottomSheetBehavior.STATE_EXPANDED);
		}
		
		inflated.setClipToOutline(true);
		
		// Bind views
		viewItems = inflated.findViewById(R.id.viewItems);
		final RecyclerView rvAttributes   = inflated.findViewById(R.id.rv_attributes);
		final RecyclerView rvListeners    = inflated.findViewById(R.id.listeners);
		final ImageView imgEditId         = inflated.findViewById(R.id.img_edit_id);
		final ImageView imgCollection     = inflated.findViewById(R.id.collection);
		final ImageView imgCommonAttrs    = inflated.findViewById(R.id.img_common_attributes);
		final ImageView imgCustomAttrs    = inflated.findViewById(R.id.img_custom);
		final com.google.android.material.tabs.TabLayout tabLayout =
		inflated.findViewById(R.id.attributesOrListener);
		final LinearLayout attributesTab  = inflated.findViewById(R.id.attributesTab);
		final LinearLayout eventTab       = inflated.findViewById(R.id.eventTab);
		
		viewItems.setIdManager(idManager);
		viewItems.forceRefresh();
		
		String currentViewId = idManager.getId(view);
		if (currentViewId != null) {
			viewItems.selectIdSilently(currentViewId);
		}
		
		viewItems.setOnViewChangeListener(new OnViewChangeListener() {
			@Override
			public void onViewChanged(View newView, String id) {
				if (selectedView == newView) return;
				
				if (selectedView != null) {
					selectedView.setBackground(originalBackgrounds.get(selectedView));
				}
				
				selectedView = newView;
				applyHighlightDrawable(selectedView);
				attributesList.clear();
				reloadAttributesForView(selectedView, rvAttributes, attributesList);
				
				String newId = idManager.getId(selectedView);
				if (newId != null) viewItems.selectIdSilently(newId);
			}
		});
		
		// Save to collection
		imgCollection.setOnClickListener(new View.OnClickListener() {
			@Override
			public void onClick(View v) {
				bottomSheetDialog.dismiss();
				AddToCollectionDialog.show(
				getContext(),
				view,
				attributesValueMap.get(view),
				new AddToCollectionDialog.Callback() {
					@Override
					public void onWidgetSaved(String blueprintId) {
						Toast.makeText(getContext(),
						"Widget saved to global repository!",
						Toast.LENGTH_SHORT).show();
					}
				});
			}
		});
		
		// Tab layout: Attributes | Events
		tabLayout.removeAllTabs();
		tabLayout.addTab(tabLayout.newTab().setText("attributes"));
		tabLayout.addTab(tabLayout.newTab().setText("events"));
		
		LinearLayoutManager attrLayoutManager =
		new LinearLayoutManager(getContext(), LinearLayoutManager.HORIZONTAL, false);
		rvAttributes.setLayoutManager(attrLayoutManager);
		AttributeRecyclerAdapter attrAdapter =
		new AttributeRecyclerAdapter(getContext(), attributesList);
		rvAttributes.setAdapter(attrAdapter);
		
		LinearLayoutManager listenerLayoutManager =
		new LinearLayoutManager(getContext(), LinearLayoutManager.HORIZONTAL, false);
		rvListeners.setLayoutManager(listenerLayoutManager);
		ListenerRecyclerAdapter listenerAdapter =
		new ListenerRecyclerAdapter(getContext(), listenersList);
		rvListeners.setAdapter(listenerAdapter);
		
		tabLayout.addOnTabSelectedListener(
		new com.google.android.material.tabs.TabLayout.OnTabSelectedListener() {
			@Override
			public void onTabSelected(com.google.android.material.tabs.TabLayout.Tab tab) {
				boolean isAttrTab = tab.getPosition() == 0;
				attributesTab.setVisibility(isAttrTab ? View.VISIBLE : View.GONE);
				eventTab.setVisibility(isAttrTab ? View.GONE : View.VISIBLE);
			}
			
			@Override
			public void onTabUnselected(com.google.android.material.tabs.TabLayout.Tab tab) {}
			
			@Override
			public void onTabReselected(com.google.android.material.tabs.TabLayout.Tab tab) {}
		});
		
		// Edit ID
		imgEditId.setOnClickListener(new View.OnClickListener() {
			@Override
			public void onClick(View v) {
				final EditText editText = new EditText(getContext());
				editText.setText(idManager.getId(view));
				
				new AlertDialog.Builder(getContext())
				.setTitle("Edit ID")
				.setView(editText)
				.setPositiveButton("Change", new DialogInterface.OnClickListener() {
					@Override
					public void onClick(DialogInterface dialog, int which) {
						idManager.updateId(view, editText.getText().toString());
						saveStateForUndo("change_id");
					}
				})
				.setNegativeButton("Cancel", null)
				.show();
			}
		});
		
		imgCommonAttrs.setOnClickListener(new View.OnClickListener() {
			@Override
			public void onClick(View v) {
				bottomSheetDialog.dismiss();
				showCommonAttributesDialog(view);
			}
		});
		
		imgCustomAttrs.setOnClickListener(new View.OnClickListener() {
			@Override
			public void onClick(View v) {
				bottomSheetDialog.dismiss();
				showCustomAttributesDialog(view);
			}
		});
		
		// Attribute item click → show type-specific input dialog
		attrAdapter.setOnItemClickListener(new AttributeRecyclerAdapter.OnItemClickListener() {
			@Override
			public void onItemClick(int position) {
				showAttributeInputDialog(view, attributesList.get(position));
			}
		});
		
		// Listener item click → open Logic Editor
		listenerAdapter.setOnItemClickListener(new AttributeRecyclerAdapter.OnItemClickListener() {
			@Override
			public void onItemClick(int position) {
				openLogicEditorForListener(view, listenersList.get(position));
			}
		});
		
		bottomSheetDialog.show();
		
		attachDragAndClickListener(view);
		if (view instanceof ViewGroup) {
			view.setOnDragListener(dragController.getDragListener());
			view.setMinimumHeight((int) SketchwareUtil.getDip(getContext(), 30));
		}
	}
	
	// ============================================================
	// Attribute Input Dialog
	// ============================================================
	
	/**
* Presents the type-appropriate input UI for a single attribute and saves the result.
*
* @param view      the target view
* @param attribute the attribute metadata map from {@code attributes.json}
*/	
	private void showAttributeInputDialog(final View view,
	final HashMap<String, Object> attribute) {
		final MaterialAlertDialogBuilder inputDialog =
		new MaterialAlertDialogBuilder(
		getContext(),
		com.google.android.material.R.style.ThemeOverlay_Material3_MaterialAlertDialog_Centered);
		
		inputDialog.setTitle(attribute.get("name").toString());
		inputDialog.setNeutralButton("Cancel", null);
		
		attrSet = attributesValueMap.get(view);
		final String attrName = attribute.get("attribute_name").toString();
		final String attrType = attribute.get("argument_type").toString();
		final String currentValue = (attrSet != null && attrSet.getAttribute(attrName) != null)
		? attrSet.getAttribute(attrName).getValue()
		: "";
		
		boolean shouldShowDialog = true;
		
		switch (attrType) {
			
			// ----- boolean -----
			case "boolean": {
				RadioGroup rg = buildBooleanRadioGroup(currentValue);
				final RadioGroup finalRg = rg;
				inputDialog.setPositiveButton("Save", new DialogInterface.OnClickListener() {
					@Override
					public void onClick(DialogInterface dialog, int which) {
						String value = getCheckedRadioText(finalRg);
						if (value != null) saveAndApplyAttribute(view, attrName, value, attribute);
					}
				});
				inputDialog.setView(rg);
				break;
			}
			
			// ----- int -----
			case "int": {
				final EditText editText = new EditText(getContext());
				editText.setInputType(InputType.TYPE_CLASS_NUMBER | InputType.TYPE_NUMBER_FLAG_SIGNED);
				if (!currentValue.isEmpty()) editText.setText(currentValue);
				inputDialog.setPositiveButton("Save", new DialogInterface.OnClickListener() {
					@Override
					public void onClick(DialogInterface dialog, int which) {
						saveAndApplyAttribute(view, attrName,
						editText.getText().toString(), attribute);
					}
				});
				inputDialog.setView(editText);
				break;
			}
			
			// ----- float -----
			case "float":
			shouldShowDialog = false;
			handleFloatAttributeDialog(view, attribute, attrName, currentValue);
			break;
			
			// ----- String -----
			case "String":
			if ("Convert Widget".equals(attrName)) {
				showConvertWidgetDialog(view);
				shouldShowDialog = false;
			} else {
				final EditText editText = new EditText(getContext());
				if (!currentValue.isEmpty()) editText.setText(currentValue);
				inputDialog.setPositiveButton("Save", new DialogInterface.OnClickListener() {
					@Override
					public void onClick(DialogInterface dialog, int which) {
						saveAndApplyAttribute(view, attrName,
						editText.getText().toString(), attribute);
					}
				});
				inputDialog.setView(editText);
			}
			break;
			
			// ----- Size (match_parent / wrap_content / custom dp) -----
			case "Size": {
				View sizeView = buildSizePickerView(currentValue);
				final RadioGroup rgSize    = (RadioGroup) sizeView.getTag(R.id.rg_width);
				final EditText etCustomDp  = (EditText)   sizeView.getTag(R.id.edittext_width);
				inputDialog.setPositiveButton("Save", new DialogInterface.OnClickListener() {
					@Override
					public void onClick(DialogInterface dialog, int which) {
						String value;
						int checkedId = rgSize.getCheckedRadioButtonId();
						if (checkedId == 1)      value = "match_parent";
						else if (checkedId == 2) value = "wrap_content";
						else                     value = etCustomDp.getText().toString() + "dp";
						saveAndApplyAttribute(view, attrName, value, attribute);
					}
				});
				inputDialog.setView(sizeView);
				break;
			}
			
			// ----- Color -----
			case "Color": {
				shouldShowDialog = false;
				int initialColor = currentValue.isEmpty() ? Color.WHITE : Color.parseColor(currentValue);
				final String finalAttrName  = attrName;
				final HashMap<String, Object> finalAttribute = attribute;
				final View finalView = view;
				
				BroadcastReceiver colorReceiver = new BroadcastReceiver() {
					@Override
					public void onReceive(Context context, Intent intent) {
						String selectedColor = intent.getStringExtra("color");
						if (selectedColor != null) {
							saveAndApplyAttribute(finalView, finalAttrName, selectedColor, finalAttribute);
							LocalBroadcastManager.getInstance(getContext()).unregisterReceiver(this);
						}
					}
				};
				LocalBroadcastManager.getInstance(getContext()).registerReceiver(
				colorReceiver, new IntentFilter("data"));
				
				Intent colorIntent = new Intent(getContext(), ColorPickerActivity.class);
				colorIntent.putExtra("initialColor", initialColor);
				getContext().startActivity(colorIntent);
				break;
			}
			
			// ----- Drawable (image resource picker) -----
			case "Drawable": {
				ArrayList<String> imagePaths = new ArrayList<>();
				FileUtil.listDir(
				FileUtil.getExternalStorageDir()
				+ "/.blacklogics/resources/images/"
				+ ProjectDataHelper.getScId(getContext()) + "/",
				imagePaths);
				
				ArrayList<String> imageNames = new ArrayList<>();
				for (String path : imagePaths) {
					if (path.endsWith(".png")) {
						String name = Uri.parse(path).getLastPathSegment();
						imageNames.add(name.substring(0, name.lastIndexOf(".")));
					}
				}
				
				String selected = currentValue.isEmpty() ? "" : AttributeUtils.getName(currentValue);
				final RadioGroup rgDrawable = buildScrollableRadioGroup(imageNames, selected);
				inputDialog.setPositiveButton("Save", new DialogInterface.OnClickListener() {
					@Override
					public void onClick(DialogInterface dialog, int which) {
						String text = getCheckedRadioText(rgDrawable);
						if (text != null)
						saveAndApplyAttribute(view, attrName, "@drawable/" + text, attribute);
					}
				});
				inputDialog.setView(wrapInScrollView(rgDrawable));
				break;
			}
			
			// ----- View (sibling view ID picker) -----
			case "View": {
				ArrayList<String> siblingIds = new ArrayList<>();
				if (view.getParent() instanceof ViewGroup) {
					ViewGroup parent = (ViewGroup) view.getParent();
					for (int i = 0; i < parent.getChildCount(); i++) {
						siblingIds.add(idManager.getId(parent.getChildAt(i)));
					}
				}
				String selected = currentValue.isEmpty() ? "" : AttributeUtils.getName(currentValue);
				final RadioGroup rgView = buildScrollableRadioGroup(siblingIds, selected);
				inputDialog.setPositiveButton("Save", new DialogInterface.OnClickListener() {
					@Override
					public void onClick(DialogInterface dialog, int which) {
						String text = getCheckedRadioText(rgView);
						if (text != null)
						saveAndApplyAttribute(view, attrName, "@+id/" + text, attribute);
					}
				});
				inputDialog.setView(wrapInScrollView(rgView));
				break;
			}
			
			// ----- enum (single choice from xml_arguments) -----
			case "enum": {
				ArrayList<String> enumOptions =
				(ArrayList<String>) attribute.get("xml_arguments");
				String selected = currentValue.isEmpty() ? "" : AttributeUtils.getName(currentValue);
				final RadioGroup rgEnum = buildScrollableRadioGroup(enumOptions, selected);
				inputDialog.setPositiveButton("Save", new DialogInterface.OnClickListener() {
					@Override
					public void onClick(DialogInterface dialog, int which) {
						String text = getCheckedRadioText(rgEnum);
						if (text != null)
						saveAndApplyAttribute(view, attrName, text, attribute);
					}
				});
				inputDialog.setView(wrapInScrollView(rgEnum));
				break;
			}
			
			// ----- flag (multi-choice checkboxes) -----
			case "flag": {
				ArrayList<String> flagOptions =
				(ArrayList<String>) attribute.get("xml_arguments");
				String selectedFlags = currentValue.isEmpty() ? "" : AttributeUtils.getName(currentValue);
				List<String> selectedList = Arrays.asList(selectedFlags.split("\\|"));
				
				final LinearLayout flagContainer = new LinearLayout(getContext());
				flagContainer.setOrientation(LinearLayout.VERTICAL);
				
				for (String option : flagOptions) {
					CheckBox cb = new CheckBox(getContext());
					cb.setText(option);
					cb.setChecked(selectedList.contains(option));
					flagContainer.addView(cb);
				}
				
				inputDialog.setPositiveButton("Save", new DialogInterface.OnClickListener() {
					@Override
					public void onClick(DialogInterface dialog, int which) {
						StringBuilder flagValue = new StringBuilder();
						for (int i = 0; i < flagContainer.getChildCount(); i++) {
							CheckBox cb = (CheckBox) flagContainer.getChildAt(i);
							if (cb.isChecked()) {
								if (flagValue.length() > 0) flagValue.append("|");
								flagValue.append(cb.getText().toString());
							}
						}
						saveAndApplyAttribute(view, attrName, flagValue.toString(), attribute);
					}
				});
				inputDialog.setView(wrapInScrollView(flagContainer));
				break;
			}
			
			// ----- customView — Sketchware style project custom view picker -----
			case "customView":
				showCustomViewPickerDialog(view, attrName, attribute);
				shouldShowDialog = false;
			break;

			// ----- custom (padding/margin delegates) -----
			case "custom":
			if ("android:padding_all".equals(attrName)) {
				showPaddingDialog(view);
				shouldShowDialog = false;
			} else if ("android:layout_margin_all".equals(attrName)) {
				showMarginDialog(view);
				shouldShowDialog = false;
			}
			break;
			
			default:
			break;
		}
		
		if (shouldShowDialog) {
			inputDialog.show();
		}
	}
	
	// ============================================================
	// Radio Group Utilities  (unified pattern)
	// ============================================================
	
	/**
* Builds a vertical {@link RadioGroup} populated with one {@link RadioButton} per option.
* The item matching {@code selectedValue} is pre-checked.
*
* <p>This is the single, unified factory used wherever a dialog needs a radio-button
* choice list (Drawable, View, enum picker). Wrap the result in
* {@link #wrapInScrollView(View)} if the list may overflow the screen.
*
* @param options       the option strings to show
* @param selectedValue the option that should be pre-selected (empty string = none)
* @return a configured {@link RadioGroup}
*/	
	private RadioGroup buildScrollableRadioGroup(List<String> options, String selectedValue) {
		RadioGroup radioGroup = new RadioGroup(getContext());
		radioGroup.setOrientation(RadioGroup.VERTICAL);
		
		for (String option : options) {
			RadioButton rb = new RadioButton(getContext());
			rb.setId(View.generateViewId());
			rb.setText(option);
			if (option.equals(selectedValue)) rb.setChecked(true);
			radioGroup.addView(rb);
		}
		
		return radioGroup;
	}
	
	/**
* Returns the text of the currently checked {@link RadioButton} inside a
* {@link RadioGroup}, or {@code null} if nothing is selected.
*
* @param radioGroup the group to inspect
* @return checked button text, or {@code null}
*/	
	@Nullable
	private String getCheckedRadioText(RadioGroup radioGroup) {
		int checkedId = radioGroup.getCheckedRadioButtonId();
		if (checkedId == -1) return null;
		RadioButton rb = radioGroup.findViewById(checkedId);
		return rb != null ? rb.getText().toString() : null;
	}
	
	/**
* Builds a two-option {@link RadioGroup} for boolean attributes ("True" / "False").
*
* @param currentValue the current attribute value, used to pre-select the right button
* @return a configured {@link RadioGroup}
*/	
	private RadioGroup buildBooleanRadioGroup(String currentValue) {
		ViewGroup.LayoutParams lp = new ViewGroup.LayoutParams(
		ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
		
		RadioButton rbTrue = new RadioButton(getContext());
		rbTrue.setText("True");
		rbTrue.setLayoutParams(lp);
		rbTrue.setId(View.generateViewId());
		
		RadioButton rbFalse = new RadioButton(getContext());
		rbFalse.setText("False");
		rbFalse.setLayoutParams(lp);
		rbFalse.setId(View.generateViewId());
		
		RadioGroup rg = new RadioGroup(getContext());
		rg.addView(rbTrue);
		rg.addView(rbFalse);
		
		if ("true".equals(currentValue))       rbTrue.setChecked(true);
		else if ("false".equals(currentValue)) rbFalse.setChecked(true);
		
		return rg;
	}
	
	/**
* Builds the compound view used for "Size" attributes
* (match_parent / wrap_content / custom dp).
* <p>
* Tags on the returned view:
* <ul>
*   <li>{@code R.id.rg_width}      → the {@link RadioGroup}</li>
*   <li>{@code R.id.edittext_width} → the custom-dp {@link EditText}</li>
* </ul>
*
* @param currentValue the current attribute value string
* @return the fully configured size-picker root view
*/	
	private View buildSizePickerView(String currentValue) {
		final RadioButton rbMatch   = new RadioButton(getContext());
		final RadioButton rbWrap    = new RadioButton(getContext());
		final RadioButton rbCustom  = new RadioButton(getContext());
		final EditText    etCustom  = new EditText(getContext());
		final TextView    tvDp      = new TextView(getContext());
		
		rbMatch.setText("match_parent");
		rbWrap.setText("wrap_content");
		rbCustom.setText("Value in dp");
		tvDp.setText("dp");
		tvDp.setTextSize(16);
		
		rbMatch.setId(1);
		rbWrap.setId(2);
		rbCustom.setId(3);
		
		etCustom.setInputType(InputType.TYPE_CLASS_NUMBER | InputType.TYPE_NUMBER_FLAG_SIGNED);
		
		final LinearLayout customRow = new LinearLayout(getContext());
		customRow.setOrientation(LinearLayout.HORIZONTAL);
		customRow.setVisibility(View.GONE);
		LinearLayout.LayoutParams etParams = new LinearLayout.LayoutParams(
		0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f);
		customRow.addView(etCustom, etParams);
		customRow.addView(tvDp);
		
		final RadioGroup rgSize = new RadioGroup(getContext());
		rgSize.addView(rbMatch);
		rgSize.addView(rbWrap);
		rgSize.addView(rbCustom);
		rgSize.addView(customRow);
		
		rbCustom.setOnCheckedChangeListener(new CompoundButton.OnCheckedChangeListener() {
			@Override
			public void onCheckedChanged(CompoundButton buttonView, boolean isChecked) {
				customRow.setVisibility(isChecked ? View.VISIBLE : View.GONE);
			}
		});
		
		// Restore current value
		if (!currentValue.isEmpty()) {
			if ("match_parent".equals(currentValue))   rbMatch.setChecked(true);
			else if ("wrap_content".equals(currentValue)) rbWrap.setChecked(true);
			else {
				rbCustom.setChecked(true);
				etCustom.setText(currentValue.replace("dp", ""));
			}
		}
		
		com.shapun.layouteditor.utils.AnimationUtils.animate(rgSize);
		
		// Attach references via tag so caller can retrieve them
		rgSize.setTag(R.id.rg_width, rgSize);
		rgSize.setTag(R.id.edittext_width, etCustom);
		return rgSize;
	}
	
	/** Wraps any {@link View} in a {@link ScrollView} for overflow-safe dialogs. */
	private ScrollView wrapInScrollView(View content) {
		ScrollView sv = new ScrollView(getContext());
		sv.addView(content);
		return sv;
	}
	
	// ============================================================
	// Float Attribute Dialog (textSize / generic float)
	// ============================================================
	
	private void handleFloatAttributeDialog(final View view,
	final HashMap<String, Object> attribute,
	final String attrName,
	final String currentValue) {
		if (attrName.equals("android:textSize")) {
			String currentTextSize = currentValue;
			if ((currentValue == null || currentValue.isEmpty()) && view instanceof TextView) {
				float px = ((TextView) view).getTextSize();
				float sp = px / getContext().getResources().getDisplayMetrics().scaledDensity;
				currentTextSize = String.format(Locale.getDefault(), "%.1fsp", sp);
			}
			
			new TextSizePickerDialog(getContext(), currentTextSize, new OnTextSizeSelected() {
				@Override
				public void onSelected(String selectedValue) {
					try {
						attr = new Attribute(attrName, selectedValue);
						float px = DimensionUtils.getValueInPx(getContext(), selectedValue);
						if (view instanceof TextView) {
							((TextView) view).setTextSize(TypedValue.COMPLEX_UNIT_PX, px);
						}
						AttributeSet set = attributesValueMap.get(view);
						if (set == null) { set = new AttributeSet(); attributesValueMap.put(view, set); }
						// ✅ FIX v3.1: Old value capture karo pehle — undo ke liye
						Attribute existingTs = set.getAttribute(attrName);
						final String oldTsVal = (existingTs != null) ? existingTs.getValue() : null;
						final String newTsVal = selectedValue;
						final AttributeSet finalTsSet = set;
						final HashMap<String, Object> finalTsAttr = attribute;
						if (!isUndoRedoInProgress) {
							stableUndoManager.push(getCurrentActivityName(),
							new StableUndoManager.AttributeChangeCommand(
							view, attrName, oldTsVal, newTsVal,
							new StableUndoManager.AttributeChangeCommand.AttributeApplier() {
								@Override
								public void apply(View v, String name, String value) {
									Attribute a = new Attribute(name, value);
									finalTsSet.add(a);
									applyAttributeInternal(v, a, finalTsAttr);
								}
							}));
						}
						set.add(attr);
						applyAttribute(view, attr, attribute);
					} catch (Exception e) {
						SketchwareUtil.showMessage(getContext(),
						"Error applying textSize: " + e.getMessage());
					}
				}
			}).show();
			
		} else {
			float currentFloat = 0f;
			try {
				if (currentValue != null && !currentValue.isEmpty()) {
					currentFloat = Float.parseFloat(currentValue);
				}
			} catch (NumberFormatException ignored) {}
			
			FloatAttributeMaterialDialog.show(
			getContext(),
			attribute.get("name").toString(),
			currentFloat,
			new OnFloatSelected() {
				@Override
				public void onSelected(float value) {
					try {
						String formatted = String.format(Locale.getDefault(), "%.1f", value);
						attr = new Attribute(attrName, formatted);
						if (attrSet == null) {
							attrSet = new AttributeSet();
							attributesValueMap.put(view, attrSet);
						}
						attrSet.add(attr);
						applyAttribute(view, attr, attribute);
					} catch (Exception e) {
						SketchwareUtil.showMessage(getContext(), "Error: " + e.getMessage());
					}
				}
			});
		}
	}
	
