	private void showMaterialWidgetDialog(final Context context,
	final ArrayList<HashMap<String, Object>> widgetList) {
		new WidgetClassPickerDialog(context, new OnWidgetClassSelectedListener() {
			@Override
			public void onWidgetClassSelected(String widgetName, String classPath) {
				HashMap<String, Object> map = new HashMap<>();
				map.put("name",       widgetName);
				map.put("class_path", classPath);
				widgetList.add(map);
			}
		}).show();
	}
	
	// ============================================================
	// Collection
	// ============================================================
	
	private void setupCollectionList() {
		final WidgetRepository repository = WidgetRepository.getInstance(getContext());
		final CollectionWidgetsAdapter adapter =
		new CollectionWidgetsAdapter(getContext(), repository.getAllWidgets());
		
		collection_list.setLayoutManager(new LinearLayoutManager(getContext()));
		collection_list.setAdapter(adapter);
		
		adapter.setOnItemClickListener(new CollectionWidgetsAdapter.OnItemClickListener() {
			@Override
			public void onItemClick(WidgetBlueprint blueprint, int position) {
				showCollectionWidgetPreview(blueprint);
			}
		});
		
		adapter.setOnFavoriteClickListener(new CollectionWidgetsAdapter.OnFavoriteClickListener() {
			@Override
			public void onFavoriteClick(WidgetBlueprint blueprint, int position, boolean isFav) {
				String msg = isFav
				? "Added to favorites: "   + blueprint.getDisplayName()
				: "Removed from favorites: " + blueprint.getDisplayName();
				SketchwareUtil.showMessage(getContext(), msg);
			}
		});
		
		repository.setChangeListener(new WidgetRepository.RepositoryChangeListener() {
			@Override
			public void onRepositoryChanged() {
				if (getContext() instanceof Activity) {
					((Activity) getContext()).runOnUiThread(new Runnable() {
						@Override
						public void run() { adapter.setBlueprints(repository.getAllWidgets()); }
					});
				}
			}
			
			@Override
			public void onBlueprintAdded(WidgetBlueprint blueprint) {}
			
			@Override
			public void onBlueprintRemoved(String blueprintId) {}
			
			@Override
			public void onBlueprintUpdated(WidgetBlueprint blueprint) {}
		});
	}
	
	private void showCollectionWidgetPreview(final WidgetBlueprint blueprint) {
		final View previewView = WidgetRepository.getInstance(getContext())
		.loadWidgetFromRepository(blueprint.getBlueprintId(), getContext());
		if (previewView == null) return;
		
		// Use FrameLayout as a neutral, zero-overhead container
		FrameLayout container = new FrameLayout(getContext());
		int pad = (int) SketchwareUtil.getDip(getContext(), 24);
		container.setPadding(pad, pad, pad, pad);
		container.addView(previewView);
		
		new AlertDialog.Builder(getContext())
		.setTitle(blueprint.getDisplayName())
		.setView(container)
		.setPositiveButton("Add to Editor", new DialogInterface.OnClickListener() {
			@Override
			public void onClick(DialogInterface dialog, int which) {
				// Addition handled via drag-and-drop; reserved for future direct-add
			}
		})
		.setNegativeButton("Cancel", null)
		.show();
	}
	
	// ============================================================
	// Delete Image (drag target)
	// ============================================================
	
	private void showDeleteImage() {
		if (deleteImg == null) return;
		deleteImg.post(new Runnable() {
			@Override
			public void run() {
				deleteImg.setVisibility(View.VISIBLE);
				deleteImg.setAlpha(0f);
				deleteImg.animate().alpha(1f).setDuration(200).start();
			}
		});
	}
	
	private void hideDeleteImage() {
		if (deleteImg == null) return;
		deleteImg.post(new Runnable() {
			@Override
			public void run() {
				deleteImg.animate().alpha(0f).setDuration(200)
				.withEndAction(new Runnable() {
					@Override
					public void run() { deleteImg.setVisibility(View.GONE); }
				}).start();
			}
		});
	}
	
	/** @deprecated Logic moved to {@link EditorDragController}. Kept for any legacy references. */
	@Deprecated
	private boolean isOverDeleteImage(DragEvent event) {
		// Delegated to EditorDragController internally
		return false;
	}
	
