	public void copy(String text) {
		((ClipboardManager) getContext().getSystemService(Context.CLIPBOARD_SERVICE))
		.setPrimaryClip(ClipData.newPlainText("clipboard", text));
	}
	
	public void log(String message) {
		String logPath = FileUtil.getPackageDataDir(((Activity) getContext())) + "/log.txt";
		FileUtil.writeFile(logPath, FileUtil.readFile(logPath) + "\n" + message);
	}
	
	private String getCurrentActivityName() {
		return (designActivity.activityBean != null)
		? designActivity.activityBean.getActivityName()
		: "MainActivity";
	}
	
