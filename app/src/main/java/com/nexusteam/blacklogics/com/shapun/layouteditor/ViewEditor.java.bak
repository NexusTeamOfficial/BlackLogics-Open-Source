/**
* ViewEditor is a custom {@link android.widget.LinearLayout}-based visual layout editor component.
*
* <p>This component provides a drag-and-drop interface for adding, positioning, and configuring
* Android views at runtime. Key features include:
* <ul>
*   <li>Widget palette with drag-and-drop placement</li>
*   <li>Attribute editing via bottom sheets and Material dialogs</li>
*   <li>Undo/Redo history via {@link UndoManager}</li>
*   <li>XML import/export with AES encryption support</li>
*   <li>Widget collection blueprints</li>
*   <li>Event listener binding for Logic Editor integration</li>
* </ul>
*
* <p>Typical usage:
* <pre>
*   ViewEditor editor = new ViewEditor(context);
*   editor.setPath(savePath);
*   editor.setDesignActivity(designActivity);
*   editor.loadLayout(activityName);
* </pre>
*
* @author NexusTeam &amp; SmartIndiaGaming
* @version 3.1.0
* @since 2025
*/
public class ViewEditor extends EditorLayout implements WidgetOnClick, WidgetOnAttribute {
	
	// ============================================================
	// Public Interface
	// ============================================================
	
	public interface OnWidgetAdd {
		void onWidgetAdded(View widget, ViewGroup parent);
	}
	
	// ============================================================
	// XML Sync via LocalBroadcast (from ViewCodeEditorActivity)
	// ============================================================
	
	public static final String ACTION_XML_SYNC = "com.shapun.layouteditor.ACTION_XML_SYNC";
	public static final String EXTRA_XML        = "xml_content";
	
	private BroadcastReceiver xmlSyncReceiver;
	
	/**
* Register karo jab ViewEditor screen pe aa jaye (onResume of host activity).
* ViewCodeEditorActivity se broadcast receive karke canvas real-time update hoga.
*/	
	public void registerXmlSyncReceiver() {
		if (xmlSyncReceiver != null) return;
		xmlSyncReceiver = new BroadcastReceiver() {
			@Override
			public void onReceive(Context context, Intent intent) {
				String xml = intent.getStringExtra(EXTRA_XML);
				if (xml == null || xml.trim().isEmpty()) return;
				loadFromXmlString(xml);
			}
		};
		LocalBroadcastManager.getInstance(getContext())
		.registerReceiver(xmlSyncReceiver,
		new android.content.IntentFilter(ACTION_XML_SYNC));
	}
	
	/**
* Unregister karo jab ViewEditor screen se jao (onPause of host activity).
*/	
	public void unregisterXmlSyncReceiver() {
		if (xmlSyncReceiver != null) {
			LocalBroadcastManager.getInstance(getContext())
			.unregisterReceiver(xmlSyncReceiver);
			xmlSyncReceiver = null;
		}
	}
	
	/**
* Public API: XML string se canvas rebuild karta hai.
* LocalBroadcast receiver aur direct call dono ke liye use hota hai.
*/	
	public void loadFromXmlString(String xml) {
		if (xml == null || xml.trim().isEmpty()) return;
		editorLayout.removeAllViews();
		idManager = new IdManager();
		attributesValueMap.clear();
		try {
			loadFromXml(xml);
		} catch (Exception e) {
			Log.e("ViewEditor", "loadFromXmlString failed: " + e.getMessage(), e);
		}
	}
	
	@Override
	protected void onAttachedToWindow() {
		super.onAttachedToWindow();
		// Auto-register: jab ViewEditor window mein attach ho, broadcast sunna shuru karo
		if (xmlSyncReceiver == null) {
			xmlSyncReceiver = new BroadcastReceiver() {
				@Override
				public void onReceive(Context context, Intent intent) {
					String xml = intent.getStringExtra(EXTRA_XML);
					if (xml == null || xml.trim().isEmpty()) return;
					loadFromXmlString(xml);
				}
			};
		}
		LocalBroadcastManager.getInstance(getContext())
		.registerReceiver(xmlSyncReceiver,
		new android.content.IntentFilter(ACTION_XML_SYNC));
	}
	
	@Override
	protected void onDetachedFromWindow() {
		super.onDetachedFromWindow();
		// Auto-unregister: memory leak se bachao
		if (xmlSyncReceiver != null) {
			LocalBroadcastManager.getInstance(getContext())
			.unregisterReceiver(xmlSyncReceiver);
			xmlSyncReceiver = null;
		}
	}
	
