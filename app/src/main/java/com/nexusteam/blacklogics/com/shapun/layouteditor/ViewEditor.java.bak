	// ============================================================
	// Drag & Drop
	// ============================================================
	
	/**
* Legacy DragListener stub — actual logic is in {@link EditorDragController}.
* Kept so existing code referencing {@code dragListener} still compiles.
* Any ViewGroup that calls {@code setOnDragListener(dragListener)} should instead
* call {@code setOnDragListener(dragController.getDragListener())}.
*/	
	private class DragListener implements View.OnDragListener {
		@Override
		public boolean onDrag(View destinationView, DragEvent event) {
			// Delegate to stable controller
			return dragController.getDragListener().onDrag(destinationView, event);
		}
	}
	
	/**
* Handles drop of a new widget (from palette). Called by EditorDragController callback.
*/	
	private void handleDropNewWidget(ViewGroup destinationView, Object localState, DragEvent event) {
		if (!(localState instanceof java.util.HashMap)) return;
		java.util.HashMap<String, Object> dragData = (java.util.HashMap<String, Object>) localState;
		String dragType = (String) dragData.get("type");
		
		if ("collection_widget".equals(dragType)) {
			dropCollectionWidget(dragData, destinationView, event);
		} else {
			dropRegularWidget(dragData, destinationView, event);
		}
	}
	
	private void dropCollectionWidget(java.util.HashMap<String, Object> dragData,
	ViewGroup destinationView, DragEvent event) {
		try {
			com.shapun.layouteditor.models.WidgetBlueprint blueprint =
			(com.shapun.layouteditor.models.WidgetBlueprint) dragData.get("blueprint");
			if (blueprint == null) {
				SketchwareUtil.showMessage(getContext(), "Invalid blueprint data");
				return;
			}
			
			View newView = com.shapun.layouteditor.managers.WidgetRepository
			.getInstance(getContext())
			.loadWidgetFromRepository(blueprint.getBlueprintId(), getContext());
			if (newView == null) {
				SketchwareUtil.showMessage(getContext(), "Failed to load collection widget");
				return;
			}
			
			if (!dragController.canAcceptChild(destinationView, newView)) return;
			
			applyDefaultViewSetup(newView);
			int insertIdx = dragController.getInsertIndex(destinationView, event);
			EditorDragController.addViewSafe(newView, destinationView, insertIdx);
			addViewWithUndo(newView, destinationView, insertIdx);
			
			if (newView instanceof ViewGroup) {
				newView.setOnDragListener(dragController.getDragListener());
				newView.setBackground(UiUtils.createStrokedBackground(0, 0xFF000000, 1));
			}
			
			String newId = idManager.generateNewId(newView);
			idManager.addNewId(newView, newId);
			
			AttributeSet attributeSet = attributesValueMap.get(newView);
			if (attributeSet == null) {
				attributeSet = new AttributeSet();
				attributesValueMap.put(newView, attributeSet);
			}
			attributeSet.add(new Attribute("android:id", "@+id/" + newId));
			ensureDefaultLayoutParams(newView);
			
			if (blueprint.getAttributes() != null) {
				for (Map.Entry<String, String> entry : blueprint.getAttributes().entrySet()) {
					if (attributeSet.getAttribute(entry.getKey()) == null) {
						Attribute a = new Attribute(entry.getKey(), entry.getValue());
						attributeSet.add(a);
						applyAttribute(newView, a);
					}
				}
			}
			
			blueprint.incrementUsageCount();
			// ✅ FIX: saveStateForUndo removed — addViewWithUndo already StableUndoManager mein push karta hai
			if (onWidgetAddListener != null)
			onWidgetAddListener.onWidgetAdded(newView, destinationView);
			
			SketchwareUtil.showMessage(getContext(),
			"Collection widget added: " + blueprint.getDisplayName());
			
		} catch (Exception e) {
			SketchwareUtil.showMessage(getContext(), "Collection widget error: " + e.getMessage());
			Log.e("ViewEditor", "Collection drop failed", e);
		}
	}
	
	private void dropRegularWidget(java.util.HashMap<String, Object> widgetData,
	ViewGroup destinationView, DragEvent event) {
		try {
			View newView = ReflectionUtils.createView(
			getContext(), widgetData.get("class_path").toString());
			
			if (!dragController.canAcceptChild(destinationView, newView)) return;
			
			applyDefaultViewSetup(newView);
			int insertIdx = dragController.getInsertIndex(destinationView, event);
			EditorDragController.addViewSafe(newView, destinationView, insertIdx);
			addViewWithUndo(newView, destinationView, insertIdx);
			
			if (newView instanceof ViewGroup) {
				newView.setOnDragListener(dragController.getDragListener());
				newView.setBackground(UiUtils.createStrokedBackground(0, 0xFF000000, 1));
			}
			
			String newId = idManager.generateNewId(newView);
			idManager.addNewId(newView, newId);
			
			AttributeSet attributeSet = new AttributeSet();
			attributesValueMap.put(newView, attributeSet);
			attributeSet.add(new Attribute("android:id", "@+id/" + newId));
			
			ensureDefaultLayoutParams(newView);
			
			if (newView instanceof ViewGroup) {
				attributeSet.add(new Attribute("android:layout_width", "match_parent"));
				attributeSet.add(new Attribute("android:layout_height", "wrap_content"));
			} else {
				attributeSet.add(new Attribute("android:layout_width", "wrap_content"));
				attributeSet.add(new Attribute("android:layout_height", "wrap_content"));
			}
			
			addInitialAttributes(newView, widgetData);
			setDefaultTextSize(newView);
			
			// ✅ FIX: saveStateForUndo removed — addViewWithUndo already StableUndoManager mein push karta hai
			if (onWidgetAddListener != null)
			onWidgetAddListener.onWidgetAdded(newView, destinationView);
			
		} catch (Throwable t) {
			SketchwareUtil.showMessage(getContext(), "Create failed: " + t.getMessage());
		}
	}
	
	// ============================================================
	// New View Setup Helpers
	// ============================================================
	
	/**
* Applies the default visual and interactive setup to a newly created canvas widget:
* default padding, minimum dimensions, click-to-edit, and drag-to-rearrange.
*
* @param view the freshly created widget
*/	
	private void applyDefaultViewSetup(View view) {
		int defaultPadding = (int) SketchwareUtil.getDip(getContext(), 8);
		view.setPadding(defaultPadding, defaultPadding, defaultPadding, defaultPadding);
		view.setMinimumHeight((int) SketchwareUtil.getDip(getContext(), 30));
		view.setMinimumWidth((int) SketchwareUtil.getDip(getContext(), 30));
		
		attachDragAndClickListener(view);
		attachEditorClickListener(view);
	}
	
	private void ensureDefaultLayoutParams(View view) {
		if (view.getLayoutParams() != null) return;
		boolean isGroup = view instanceof ViewGroup;
		view.setLayoutParams(new ViewGroup.LayoutParams(
		isGroup ? ViewGroup.LayoutParams.MATCH_PARENT : ViewGroup.LayoutParams.WRAP_CONTENT,
		ViewGroup.LayoutParams.WRAP_CONTENT));
	}
	
	private void addInitialAttributes(View view, HashMap<String, Object> widgetData) {
		if (!widgetData.containsKey("initial_attributes")) return;
		
		Map<String, String> initialAttrs =
		(Map<String, String>) widgetData.get("initial_attributes");
		
		AttributeSet set = attributesValueMap.get(view);
		if (set == null) {
			set = new AttributeSet();
			attributesValueMap.put(view, set);
		}
		
		for (String key : initialAttrs.keySet()) {
			Attribute a = new Attribute(key, initialAttrs.get(key));
			set.add(a);
			applyAttribute(view, a);
		}
	}
}
